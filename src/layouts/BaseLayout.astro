---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WaveCurtain from '../components/WaveCurtain.astro';
import Reveal from '../components/Reveal.astro';
import Lightbox from '../components/Lightbox.astro';
import { company } from '../data/site';
import { getCategories } from '../data/catalogue';
import { dir, htmlLang, localePath, ogLocale, pick, stripLocale, t, type Lang } from '../i18n';
import '../styles/global.css';
import '../styles/transitions.css';

type PageType = 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage' | 'ItemPage';

interface Crumb {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  /** Use `title` verbatim instead of appending the company name (homepage). */
  fullTitle?: boolean;
  /** Share-preview image path (default: the 1200×630 og-image.png). */
  image?: string;
  /** Pixel size of `image` — only needed when it isn't the default share image. */
  imageWidth?: number;
  imageHeight?: number;
  /** Keep the page out of search results (404). */
  noindex?: boolean;
  /** schema.org type of this page's WebPage node. */
  pageType?: PageType;
  /** Trail after "Home" for nested pages (e.g. Products › Fish › Yellowfin Tuna). Defaults to just this page. */
  breadcrumbs?: Crumb[];
  /** Extra JSON-LD objects merged into this page's @graph. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Load the Arabic web font + mark Arabic as an alternate locale (bilingual pages only). */
  arabicFont?: boolean;
  /** Page language — 'en' at the site root, 'ar' under /ar/. */
  lang?: Lang;
}

const {
  title,
  fullTitle = false,
  image = '/og-image.png',
  imageWidth = 1200,
  imageHeight = 630,
  noindex = false,
  pageType = 'WebPage',
  breadcrumbs,
  schema = [],
  arabicFont = false,
  lang = 'en',
} = Astro.props;

const { description = lang === 'ar' ? company.descriptionAr : company.description } = Astro.props;
const L = t(lang);
const useArabicFont = arabicFont || lang === 'ar';

// `site` comes from astro.config.mjs — every URL below is absolute.
const site = Astro.site ?? new URL('https://www.globalseastrust.com');
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '/ar/';
const canonical = new URL(pathname, site).href;

// hreflang pair — the same page in each language
const basePath = stripLocale(pathname);
const alternates = [
  { hreflang: 'en', href: new URL(basePath, site).href },
  { hreflang: 'ar', href: new URL(localePath(basePath, 'ar'), site).href },
  { hreflang: 'x-default', href: new URL(basePath, site).href },
];
const ogImage = new URL(image, site).href;
const ogImageType = /\.png(\?|$)/i.test(ogImage) ? 'image/png' : 'image/jpeg';
const pageTitle = fullTitle ? title : `${title} | ${lang === 'ar' ? company.nameAr : company.name}`;

// Drop into .env as PUBLIC_GOOGLE_SITE_VERIFICATION=<token> once Search Console issues one.
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION as string | undefined;

/* ---------- structured data (schema.org) ----------
   One linked @graph per page. Organization + WebSite are repeated on every
   page so the @id references below always resolve within the same document. */
const orgId = `${site.href}#organization`;
const siteId = `${site.href}#website`;
const pageId = `${canonical}#webpage`;
const crumbId = `${canonical}#breadcrumb`;
const productsUrl = new URL(localePath('/products/', lang), site).href;

const organization: Record<string, unknown> = {
  '@type': 'Organization',
  '@id': orgId,
  name: company.name,
  alternateName: company.nameAr,
  url: site.href,
  logo: { '@type': 'ImageObject', url: new URL('/gst-logo.png', site).href, width: 480, height: 385 },
  image: ogImage,
  description,
  slogan: lang === 'ar' ? company.taglineAr : company.tagline,
  foundingDate: String(company.founded),
  // Both published lines and both published addresses — these feed Google's
  // knowledge panel and contact surfaces, so a partial list costs enquiries.
  email: [company.email, company.emailSales],
  telephone: [company.phone, company.phoneAlt],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Quroon',
    addressLocality: company.locality,
    addressRegion: company.region,
    postalCode: company.postalCode,
    addressCountry: 'OM',
  },
  hasMap: company.mapsUrl,
  geo: { '@type': 'GeoCoordinates', latitude: company.geo.lat, longitude: company.geo.lng },
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'Commercial Registration (Oman)',
    value: company.crNumber,
  },
  areaServed: 'Worldwide',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: company.openingHours.days,
      opens: company.openingHours.opens,
      closes: company.openingHours.closes,
    },
  ],
  // Each point carries BOTH numbers: the addresses have known roles (one is
  // literally the sales desk) but the client has not said which line serves
  // which function, and guessing would put wrong information in front of buyers.
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      telephone: [company.phone, company.phoneAlt],
      email: company.emailSales,
      availableLanguage: ['en', 'ar'],
    },
    {
      '@type': 'ContactPoint',
      contactType: 'customer service',
      telephone: [company.phone, company.phoneAlt],
      email: company.email,
      availableLanguage: ['en', 'ar'],
    },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `${company.name} seafood catalogue`,
    url: productsUrl,
    itemListElement: getCategories(lang).map((c) => ({
      '@type': 'OfferCatalog',
      name: c.label,
      description: c.blurb,
      url: productsUrl,
    })),
  },
};
if (company.socials.length) organization.sameAs = company.socials;

const website = {
  '@type': 'WebSite',
  '@id': siteId,
  url: site.href,
  name: company.name,
  inLanguage: htmlLang(lang),
  publisher: { '@id': orgId },
};

const trail: Crumb[] = breadcrumbs ?? [{ name: title, href: pathname }];
const breadcrumb = isHome
  ? null
  : {
      '@type': 'BreadcrumbList',
      '@id': crumbId,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: L.crumbs.home, item: new URL(localePath('/', lang), site).href },
        ...trail.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 2,
          name: c.name,
          item: new URL(c.href, site).href,
        })),
      ],
    };

const webPage: Record<string, unknown> = {
  '@type': pageType,
  '@id': pageId,
  url: canonical,
  name: pageTitle,
  description,
  inLanguage: htmlLang(lang),
  isPartOf: { '@id': siteId },
  about: { '@id': orgId },
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: imageWidth, height: imageHeight },
};
if (breadcrumb) webPage.breadcrumb = { '@id': crumbId };
if (pageType === 'ContactPage') webPage.mainEntity = { '@id': orgId };

const extras = Array.isArray(schema) ? schema : [schema];
const graph = noindex ? [] : [organization, website, webPage, ...(breadcrumb ? [breadcrumb] : []), ...extras];

// `<` escaped so page content can never close the script tag early.
const jsonLd = graph.length
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c')
  : '';
---

<!doctype html>
<html lang={htmlLang(lang)} dir={dir(lang)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    {
      !noindex &&
        alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)
    }
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#0a2258" />

    {
      useArabicFont && (
        <Fragment>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap" />
        </Fragment>
      )
    }

    {/* Open Graph — WhatsApp / LinkedIn / Facebook link previews */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:locale" content={ogLocale(lang)} />
    <meta property="og:locale:alternate" content={ogLocale(lang === 'ar' ? 'en' : 'ar')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={`${company.name} — ${company.tagline}`} />

    {/* Twitter / X cards */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${company.name} — ${company.tagline}`} />

    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}

    {/* Astro's router — enables the wave sweep between pages. */}
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <a class="gst-skip" href="#main">{lang === 'ar' ? 'تخطَّ إلى المحتوى' : 'Skip to content'}</a>

    <Header lang={lang} />

    <main id="main" class="gst-main">
      <slot />
    </main>

    <Footer lang={lang} />

    {/*
      Empty mount that ships the o_rv reveal engine (its script + global CSS
      only load when the component is rendered). The pages themselves use the
      attribute form — data-rv / data-rv-stagger — on their own elements.
    */}
    <Reveal as="span" in="fade" />

    {/* Any [data-lightbox] image on the page opens full size — see components/Lightbox.astro */}
    <Lightbox lang={lang} />

    {/* Persisted across navigations — see components/WaveCurtain.astro */}
    <WaveCurtain />
  </body>
</html>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .gst-skip {
    position: absolute;
    inset-inline-start: -9999px;
    top: 0;
    z-index: 9500;
    background: var(--white);
    color: var(--navy-900);
    padding: 12px 20px;
    border-start-start-radius: 0;
    border-start-end-radius: 0;
    border-end-end-radius: 10px;
    border-end-start-radius: 0;
    font-weight: 700;
  }

  .gst-skip:focus {
    inset-inline-start: 0;
  }
</style>
