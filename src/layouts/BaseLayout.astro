---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WaveCurtain from '../components/WaveCurtain.astro';
import Reveal from '../components/Reveal.astro';
import { company } from '../data/site';
import { categories } from '../data/catalogue';
import '../styles/global.css';
import '../styles/transitions.css';

type PageType = 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage' | 'ItemPage';

interface Crumb {
  name: string;
  href: string;
}

interface Props {
  title: string;
  description?: string;
  /** Use `title` verbatim instead of appending the company name (homepage). */
  fullTitle?: boolean;
  /** Share-preview image path (default: the 1200×630 og-image.png). */
  image?: string;
  /** Pixel size of `image` — only needed when it isn't the default share image. */
  imageWidth?: number;
  imageHeight?: number;
  /** Keep the page out of search results (credits, 404). */
  noindex?: boolean;
  /** schema.org type of this page's WebPage node. */
  pageType?: PageType;
  /** Trail after "Home" for nested pages (e.g. Products › Fish › Yellowfin Tuna). Defaults to just this page. */
  breadcrumbs?: Crumb[];
  /** Extra JSON-LD objects merged into this page's @graph. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = company.description,
  fullTitle = false,
  image = '/og-image.png',
  imageWidth = 1200,
  imageHeight = 630,
  noindex = false,
  pageType = 'WebPage',
  breadcrumbs,
  schema = [],
} = Astro.props;

// `site` comes from astro.config.mjs — every URL below is absolute.
const site = Astro.site ?? new URL('https://www.globalseastrust.com');
const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const canonical = new URL(pathname, site).href;
const ogImage = new URL(image, site).href;
const ogImageType = /\.png(\?|$)/i.test(ogImage) ? 'image/png' : 'image/jpeg';
const pageTitle = fullTitle ? title : `${title} | ${company.name}`;

// Drop into .env as PUBLIC_GOOGLE_SITE_VERIFICATION=<token> once Search Console issues one.
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION as string | undefined;

/* ---------- structured data (schema.org) ----------
   One linked @graph per page. Organization + WebSite are repeated on every
   page so the @id references below always resolve within the same document. */
const orgId = `${site.href}#organization`;
const siteId = `${site.href}#website`;
const pageId = `${canonical}#webpage`;
const crumbId = `${canonical}#breadcrumb`;
const productsUrl = new URL('/products/', site).href;

const organization: Record<string, unknown> = {
  '@type': 'Organization',
  '@id': orgId,
  name: company.name,
  url: site.href,
  logo: { '@type': 'ImageObject', url: new URL('/gst-logo.png', site).href, width: 480, height: 385 },
  image: ogImage,
  description: company.description,
  slogan: company.tagline,
  foundingDate: String(company.founded),
  email: company.email,
  telephone: company.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Quroon',
    addressLocality: company.locality,
    addressRegion: company.region,
    postalCode: company.postalCode,
    addressCountry: 'OM',
  },
  hasMap: company.mapsUrl,
  geo: { '@type': 'GeoCoordinates', latitude: company.geo.lat, longitude: company.geo.lng },
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'Commercial Registration (Oman)',
    value: company.crNumber,
  },
  areaServed: 'Worldwide',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: company.openingHours.days,
      opens: company.openingHours.opens,
      closes: company.openingHours.closes,
    },
  ],
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      telephone: company.phone,
      email: company.email,
      availableLanguage: ['en', 'ar'],
    },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `${company.name} seafood catalogue`,
    url: productsUrl,
    itemListElement: categories.map((c) => ({
      '@type': 'OfferCatalog',
      name: c.label,
      description: c.blurb,
      url: productsUrl,
    })),
  },
};
if (company.socials.length) organization.sameAs = company.socials;

const website = {
  '@type': 'WebSite',
  '@id': siteId,
  url: site.href,
  name: company.name,
  inLanguage: 'en',
  publisher: { '@id': orgId },
};

const trail: Crumb[] = breadcrumbs ?? [{ name: title, href: pathname }];
const breadcrumb = isHome
  ? null
  : {
      '@type': 'BreadcrumbList',
      '@id': crumbId,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: site.href },
        ...trail.map((c, i) => ({
          '@type': 'ListItem',
          position: i + 2,
          name: c.name,
          item: new URL(c.href, site).href,
        })),
      ],
    };

const webPage: Record<string, unknown> = {
  '@type': pageType,
  '@id': pageId,
  url: canonical,
  name: pageTitle,
  description,
  inLanguage: 'en',
  isPartOf: { '@id': siteId },
  about: { '@id': orgId },
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: imageWidth, height: imageHeight },
};
if (breadcrumb) webPage.breadcrumb = { '@id': crumbId };
if (pageType === 'ContactPage') webPage.mainEntity = { '@id': orgId };

const extras = Array.isArray(schema) ? schema : [schema];
const graph = noindex ? [] : [organization, website, webPage, ...(breadcrumb ? [breadcrumb] : []), ...extras];

// `<` escaped so page content can never close the script tag early.
const jsonLd = graph.length
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c')
  : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#0a2258" />

    {/* Open Graph — WhatsApp / LinkedIn / Facebook link previews */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={`${company.name} — ${company.tagline}`} />

    {/* Twitter / X cards */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${company.name} — ${company.tagline}`} />

    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}

    {/* Astro's router — enables the wave sweep between pages. */}
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <a class="gst-skip" href="#main">Skip to content</a>

    <Header />

    <main id="main" class="gst-main">
      <slot />
    </main>

    <Footer />

    {/*
      Empty mount that ships the o_rv reveal engine (its script + global CSS
      only load when the component is rendered). The pages themselves use the
      attribute form — data-rv / data-rv-stagger — on their own elements.
    */}
    <Reveal as="span" in="fade" />

    {/* Persisted across navigations — see components/WaveCurtain.astro */}
    <WaveCurtain />
  </body>
</html>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .gst-skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 9500;
    background: var(--white);
    color: var(--navy-900);
    padding: 12px 20px;
    border-radius: 0 0 10px 0;
    font-weight: 700;
  }

  .gst-skip:focus {
    left: 0;
  }
</style>
