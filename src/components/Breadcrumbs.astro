---
/**
 * Visible breadcrumb trail for nested pages (category / product).
 * "Home" is added automatically; pass the rest in order. The last item is the
 * current page and is rendered as plain text. The matching schema.org
 * BreadcrumbList is emitted by BaseLayout from the same `breadcrumbs` prop.
 */
interface Crumb {
  name: string;
  href: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const trail: Crumb[] = [{ name: 'Home', href: '/' }, ...items];
---

<nav class="crumbs" aria-label="Breadcrumb">
  <div class="container">
    <ol>
      {
        trail.map((c, i) =>
          i < trail.length - 1 ? (
            <li>
              <a href={c.href}>{c.name}</a>
            </li>
          ) : (
            <li aria-current="page">{c.name}</li>
          )
        )
      }
    </ol>
  </div>
</nav>

<style>
  .crumbs {
    background: var(--sand-50);
    border-bottom: 1px solid var(--aqua-100);
    font-size: 0.82rem;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
    padding: 0.7rem 0;
    color: var(--text-400);
  }

  .crumbs li + li::before {
    content: '›';
    margin-right: 0.35rem;
    color: var(--aqua-300);
  }

  .crumbs a {
    color: var(--blue-600);
    font-weight: 600;
  }

  .crumbs a:hover {
    text-decoration: underline;
  }

  .crumbs [aria-current='page'] {
    color: var(--text-600);
  }
</style>
