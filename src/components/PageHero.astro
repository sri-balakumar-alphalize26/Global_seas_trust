---
// Inner-page banner with a brand-gradient ground and an optional full-bleed
// photo over it. Omit `image` where no company photograph genuinely fits the
// page — the gradient stands on its own rather than borrowing a stock picture.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  heading: string;
  image?: ImageMetadata;
  alt?: string;
}

const { heading, image, alt = '' } = Astro.props;
---

<section class="page-hero-img" class:list={{ 'page-hero-img--plain': !image }}>
  {image && <Image src={image} alt={alt} class="ph-bg" width={1600} loading="eager" fetchpriority="high" />}
  {image && <div class="ph-overlay" aria-hidden="true"></div>}
  <div class="container ph-inner">
    <h1>{heading}</h1>
    <slot />
  </div>
</section>

<style>
  .page-hero-img {
    position: relative;
    background: var(--navy-900);
    color: var(--white);
    padding: 5.5rem 0 4rem;
    text-align: center;
    overflow: hidden;
  }

  /* No photo: the brand gradient carries the band on its own.
     Must follow .page-hero-img — same specificity, so source order decides. */
  .page-hero-img--plain {
    background: linear-gradient(120deg, var(--blue-600), var(--navy-900));
  }

  .page-hero-img :global(.ph-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ph-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(10, 34, 88, 0.82) 0%, rgba(18, 58, 156, 0.6) 60%, rgba(26, 91, 215, 0.45) 100%);
  }

  .ph-inner {
    position: relative;
  }

  .page-hero-img h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    margin-bottom: 0.75rem;
    color: var(--white);
    text-shadow: 0 2px 18px rgba(6, 16, 45, 0.5);
  }

  .page-hero-img :global(p) {
    max-width: 560px;
    margin: 0 auto;
    color: var(--aqua-100);
    font-size: 1.05rem;
    text-shadow: 0 1px 12px rgba(6, 16, 45, 0.6);
  }
</style>
