---
/**
 * WaveDivider.astro — the flowing water edge under a hero.
 *
 * Three layered swells drift at different speeds and directions and bob
 * vertically out of phase, so the edge reads as moving water rather than a
 * shape sliding sideways. Pure CSS transforms (compositor-only); a small
 * observer pauses the animation while the divider is off screen.
 *
 * Site adaptation: the prefers-reduced-motion opt-out was removed — the
 * owner's decision is that animations always run (see transitions.css note).
 */

interface Props {
  /** Colour of the section BELOW the wave. */
  fill?: string;
  height?: number;
  flip?: boolean;
  /** Seconds for the front swell to travel one wavelength. Higher = calmer. */
  speed?: number;
  animate?: boolean;
  /** How many fish leap out of the wave. 0 = none (the default for inner pages). */
  fish?: number;
  class?: string;
}

const {
  fill = '#ffffff',
  height = 110,
  flip = false,
  speed = 13,
  animate = true,
  fish = 0,
  class: cls,
} = Astro.props;

const PERIOD = 480; // one wavelength in SVG user units
const VIEW_W = 1920; // 4 wavelengths across
const VIEW_H = 100;

/** A tileable swell, drawn one wavelength wider on each side so a shift of
 *  exactly one period loops seamlessly with no edge ever exposed. */
function swell(baseline: number, amplitude: number) {
  const h = amplitude * 2; // a quadratic peaks at half its control offset
  let d = `M ${-PERIOD},${baseline}`;
  for (let i = 0; i < 6; i++) {
    d += ` q ${PERIOD / 4},${-h} ${PERIOD / 2},0 q ${PERIOD / 4},${h} ${PERIOD / 2},0`;
  }
  // bottom sits well past the viewBox so the vertical bob can never open a gap
  return `${d} L ${PERIOD * 5},${VIEW_H + 80} L ${-PERIOD},${VIEW_H + 80} Z`;
}

const layers = [
  { name: 'back', d: swell(40, 15), opacity: 0.3, dur: speed * 2.1, bob: speed * 0.85, dir: 'normal' },
  { name: 'mid', d: swell(54, 19), opacity: 0.55, dur: speed * 1.45, bob: speed * 0.62, dir: 'reverse' },
  { name: 'front', d: swell(68, 23), opacity: 1, dur: speed, bob: speed * 0.48, dir: 'normal' },
];

/* ---- the school ---------------------------------------------------------
   Fixed table rather than Math.random(), so the arrangement is stable across
   builds and the same on the server and the client. Each fish gets its own
   position, height, travel, tempo and phase — nothing lines up. */
const SCHOOL = [
  { x: 11, height: 78, travel: 62, scale: 1.0, dur: 6.2, delay: -0.3, flip: false },
  { x: 26, height: 48, travel: -40, scale: 0.74, dur: 4.9, delay: -2.4, flip: true },
  { x: 43, height: 96, travel: 76, scale: 1.16, dur: 7.4, delay: -4.1, flip: false },
  { x: 57, height: 56, travel: -46, scale: 0.84, dur: 5.5, delay: -1.4, flip: true },
  { x: 72, height: 84, travel: 66, scale: 0.98, dur: 6.8, delay: -5.2, flip: false },
  { x: 87, height: 44, travel: 36, scale: 0.68, dur: 4.6, delay: -3.3, flip: false },
];

const school = SCHOOL.slice(0, Math.max(0, Math.min(fish, SCHOOL.length)));
---

<div
  class:list={['wv', cls]}
  style={`--h:${height}px; --period:${PERIOD}`}
  data-flip={flip ? '' : undefined}
  data-still={animate ? undefined : ''}
  aria-hidden="true"
>
  {
    school.length > 0 && (
      <div class="wv__school">
        {school.map((f) => (
          <span
            class="wv__fish"
            style={`--x:${f.x}%; --h:${f.height}px; --travel:${f.travel}px; --s:${f.scale};
                    --dur:${f.dur}s; --delay:${f.delay}s; --dir:${f.flip ? -1 : 1}`}
          >
            <span class="wv__splash" />
            <span class="wv__arc">
              <span class="wv__tilt">
                <svg viewBox="0 0 40 22" focusable="false">
                  <g fill={fill}>
                    <path d="M8 11 C 14 2, 30 2, 38 11 C 30 20, 14 20, 8 11 Z" />
                    <path d="M9 11 L 1 3 L 3.4 11 L 1 19 Z" />
                    <path d="M22 4.4 L 26.5 0 L 27.5 5.6 Z" opacity=".8" />
                  </g>
                  <circle cx="32.5" cy="9.2" r="1.5" fill="#0a2258" />
                </svg>
              </span>
            </span>
          </span>
        ))}
      </div>
    )
  }

  <svg viewBox={`0 0 ${VIEW_W} ${VIEW_H}`} preserveAspectRatio="none" focusable="false">
    {
      layers.map((l) => (
        <g class="wv__lane" style={`--bob:${l.bob}s; --bob-delay:-${l.bob / 3}s`}>
          <path
            class="wv__swell"
            style={`--dur:${l.dur}s; --dir:${l.dir}`}
            d={l.d}
            fill={fill}
            opacity={l.opacity}
          />
        </g>
      ))
    }
  </svg>
</div>

<style>
  .wv {
    position: relative;
    line-height: 0;
    pointer-events: none;
  }

  .wv svg {
    display: block;
    width: 100%;
    /* a global `svg { max-width: 100% }` would otherwise clip the crest */
    max-width: none;
    height: var(--h);
    overflow: hidden;
  }

  .wv[data-flip] svg {
    transform: scaleY(-1);
  }

  /* horizontal drift — exactly one wavelength, in user units, so it loops
     seamlessly. A percentage would resolve against the path's bounding box
     and tear the wave open at the right-hand edge. */
  .wv__swell {
    animation: wvDrift var(--dur) linear infinite;
    animation-direction: var(--dir);
    will-change: transform;
  }

  /* vertical swell, out of phase with the drift so the two never sync up */
  .wv__lane {
    animation: wvBob var(--bob) ease-in-out infinite alternate;
    animation-delay: var(--bob-delay);
    will-change: transform;
  }

  @keyframes wvDrift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(var(--period) * -1px));
    }
  }

  @keyframes wvBob {
    from {
      transform: translateY(-5px);
    }
    to {
      transform: translateY(5px);
    }
  }

  /* ---------------------------------------------------------- the school --
     Sits BEFORE the <svg> in the DOM, so the white wave paints over the fish
     at the bottom of the arc — that occlusion is what makes them look like
     they are coming out of the water rather than floating in front of it. */
  .wv__school {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    /* headroom above the wave for the arcs; the hero clips anything beyond */
    height: calc(var(--h) + 130px);
    overflow: visible;
    pointer-events: none;
  }

  .wv__fish {
    position: absolute;
    left: var(--x);
    /* resting point is under the crest, so a submerged fish is simply hidden */
    bottom: calc(var(--h) * 0.42);
    animation: wvSwimX var(--dur) linear infinite;
    animation-delay: var(--delay);
  }

  .wv__arc {
    display: block;
    animation: wvArc var(--dur) linear infinite;
    animation-delay: var(--delay);
  }

  .wv__tilt {
    display: block;
    transform-origin: 50% 50%;
    animation: wvTilt var(--dur) linear infinite;
    animation-delay: var(--delay);
  }

  .wv__tilt svg {
    display: block;
    width: calc(46px * var(--s));
    height: auto;
    transform: scaleX(var(--dir));
    filter: drop-shadow(0 3px 6px rgba(4, 24, 45, 0.28));
  }

  /* ring on the surface where the fish re-enters */
  .wv__splash {
    position: absolute;
    left: 50%;
    bottom: 2px;
    width: calc(30px * var(--s));
    height: calc(9px * var(--s));
    margin-left: calc(-15px * var(--s));
    border-radius: 50%;
    border: 2px solid var(--wv-splash, rgba(255, 255, 255, 0.75));
    opacity: 0;
    animation: wvSplash var(--dur) linear infinite;
    animation-delay: var(--delay);
  }

  /* One cycle = a short leap plus a long spell underwater. Keeping the whole
     school on one timeline (with different periods) means no JS scheduler. */
  @keyframes wvArc {
    0%,
    6% {
      transform: translate3d(0, 0, 0);
      opacity: 0;
      animation-timing-function: cubic-bezier(0.16, 0.75, 0.36, 1);
    }
    9% {
      opacity: 1;
    }
    26% {
      transform: translate3d(0, calc(var(--h) * -1), 0);
      opacity: 1;
      animation-timing-function: cubic-bezier(0.6, 0, 0.85, 0.45);
    }
    43% {
      opacity: 1;
    }
    46%,
    100% {
      transform: translate3d(0, 0, 0);
      opacity: 0;
    }
  }

  @keyframes wvSwimX {
    0%,
    6% {
      transform: translate3d(0, 0, 0);
    }
    46%,
    100% {
      transform: translate3d(var(--travel), 0, 0);
    }
  }

  @keyframes wvTilt {
    0%,
    6% {
      transform: rotate(-46deg);
    }
    26% {
      transform: rotate(0deg);
    }
    46%,
    100% {
      transform: rotate(46deg);
    }
  }

  @keyframes wvSplash {
    0%,
    42% {
      opacity: 0;
      transform: scale(0.35);
    }
    47% {
      opacity: 0.85;
      transform: scale(0.9);
    }
    58%,
    100% {
      opacity: 0;
      transform: scale(2);
    }
  }

  /* off screen, or explicitly opted out — stop burning frames */
  .wv.is-paused .wv__swell,
  .wv.is-paused .wv__lane,
  .wv.is-paused .wv__fish,
  .wv.is-paused .wv__arc,
  .wv.is-paused .wv__tilt,
  .wv.is-paused .wv__splash {
    animation-play-state: paused;
  }

  .wv[data-still] .wv__swell,
  .wv[data-still] .wv__lane,
  .wv[data-still] .wv__school {
    animation: none;
  }

  .wv[data-still] .wv__school {
    display: none;
  }
</style>

<script>
  // Default is running, so the water still flows if this never executes.
  let io: IntersectionObserver | null = null;

  function seed() {
    const dividers = document.querySelectorAll('.wv');
    if (!dividers.length) return;
    io?.disconnect();
    io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.target.classList.toggle('is-paused', !e.isIntersecting);
      },
      { rootMargin: '120px' },
    );
    for (const d of dividers) io.observe(d);
  }

  document.addEventListener('astro:page-load', seed);
</script>
