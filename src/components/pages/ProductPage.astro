---
/**
 * /products/<category>/<slug>/ — one page per catalogue product, generated
 * from src/data/catalogue.ts. Own title/description, a share image cropped
 * from the product photo, and a schema.org Product node.
 */
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getAllProducts, categoryUrl, type CatalogueEntry } from '../../data/catalogue';
import { company, certifications, packingOptions } from '../../data/site';
import { localePath, pick, t, type Lang } from '../../i18n';

interface Props {
  product: CatalogueEntry;
  lang?: Lang;
}

const { product, lang = 'en' } = Astro.props;
const L = t(lang);
const { category } = product;
const name = lang === 'ar' ? company.nameAr : company.name;
const related = getAllProducts(lang)
  .filter((p) => p.category.id === category.id && p.slug !== product.slug)
  .slice(0, 4);
const site = Astro.site ?? new URL('https://www.globalseastrust.com');
const canonical = new URL(product.url, site).href;

// Share / structured-data image: the product photo as JPEG at its natural
// proportions (capped at 1200px wide — the sources are never upscaled).
const share = product.image
  ? await getImage({ src: product.image, width: Math.min(1200, product.image.width), format: 'jpg' })
  : undefined;
const shareW = share ? Number(share.attributes.width) : undefined;
const shareH = share ? Number(share.attributes.height) : undefined;

// Full-size copy for the lightbox, capped at the photo's own width so the
// small supplied sources are never upscaled into a blurry larger file.
const fullShot = product.image
  ? await getImage({ src: product.image, width: Math.min(1600, product.image.width), format: 'webp' })
  : undefined;

const forms = product.forms.split(/\s*\/\s*/);
const title = L.product.seoTitle(product.name);

/**
 * Meta description only — the full text still renders on the page and in the
 * Product schema below. Google shows roughly 155 chars, and the catalogue
 * descriptions run to 215, so the sentence explaining what we actually supply
 * was being cut off. Keep whole sentences; never truncate mid-word.
 */
const metaDescription = (() => {
  const sentences = product.description.match(/[^.!?]+[.!?]+\s*/g) ?? [product.description];
  let out = '';
  for (const s of sentences) {
    if (out && (out + s).trim().length > 155) break;
    out += s;
  }
  return (out || sentences[0]).trim();
})();

const crumbs = [
  { name: L.products.seoTitle, href: localePath('/products/', lang) },
  { name: category.label, href: localePath(categoryUrl(category.id), lang) },
  { name: product.name, href: product.url },
];

const productSchema = {
  '@type': 'Product',
  '@id': `${canonical}#product`,
  name: product.name,
  ...(product.scientific ? { alternateName: product.scientific } : {}),
  description: product.description,
  ...(share ? { image: new URL(share.src, site).href } : {}),
  category: category.label,
  url: canonical,
  brand: { '@type': 'Brand', name: company.name },
  manufacturer: { '@id': `${site.href}#organization` },
  countryOfOrigin: { '@type': 'Country', name: 'Oman' },
  additionalProperty: [
    { '@type': 'PropertyValue', name: L.product.productForms, value: product.forms },
    {
      '@type': 'PropertyValue',
      name: L.product.packingOptions,
      value: packingOptions.map((k) => pick(k, 'title', lang)).join(', '),
    },
    { '@type': 'PropertyValue', name: L.product.certifications, value: certifications.map((c) => c.code).join(', ') },
  ],
};
---

<BaseLayout
  lang={lang}
  title={title}
  description={metaDescription}
  pageType="ItemPage"
  breadcrumbs={crumbs}
  image={share?.src}
  imageWidth={shareW}
  imageHeight={shareH}
  schema={productSchema}
>
  <Breadcrumbs items={crumbs} lang={lang} />

  <!-- ============ PRODUCT HERO ============ -->
  <section class="section prod-hero">
    <div class="container prod-hero__grid">
      <div class="prod-hero__media" data-rv data-rv-in="fade">
        {
          product.image && (
            <Image
              src={product.image}
              alt={`${product.name} — ${product.forms}`}
              {/* Never ask for more pixels than the photo has — several supplied
                  shots are small, and upscaling them here only bakes in softness
                  and a heavier file. The column renders ~583px. */}
              width={Math.min(960, product.image.width)}
              loading="eager"
              fetchpriority="high"
              class="prod-hero__img"
              data-lightbox={fullShot?.src}
            />
          )
        }
      </div>
      <div class="prod-hero__body" data-rv>
        <a class="prod-eyebrow" href={localePath(categoryUrl(category.id), lang)}>{category.label}</a>
        <h1>{product.name}</h1>
        {product.scientific && <p class="prod-latin" lang="la" dir="ltr">{product.scientific}</p>}
        <p class="prod-desc">{product.description}</p>
        <ul class="prod-forms" aria-label={L.product.formsAria}>
          {forms.map((f) => <li>{f}</li>)}
        </ul>
        <div class="prod-actions">
          <a href={localePath('/contact/', lang)} class="btn btn--primary">{L.common.requestQuote}</a>
          <a href={localePath('/products/', lang)} class="btn btn--outline">{L.common.fullCatalogue}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SPECIFICATIONS ============ -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-head" data-rv>
        <span class="eyebrow">{L.product.specsEyebrow}</span>
        <h2>{L.product.atAGlance(product.name)}</h2>
      </div>
      <dl class="spec" data-rv>
        {
          product.scientific && (
            <div class="spec__row">
              <dt>{L.product.scientificName}</dt>
              <dd><em lang="la" dir="ltr">{product.scientific}</em></dd>
            </div>
          )
        }
        <div class="spec__row">
          <dt>{L.product.category}</dt>
          <dd><a href={localePath(categoryUrl(category.id), lang)}>{category.label}</a></dd>
        </div>
        <div class="spec__row">
          <dt>{L.product.productForms}</dt>
          <dd>{product.forms}</dd>
        </div>
        <div class="spec__row">
          <dt>{L.product.packingOptions}</dt>
          <dd>{packingOptions.map((k) => pick(k, 'title', lang)).join(' · ')}</dd>
        </div>
        <div class="spec__row">
          <dt>{L.product.coldChain}</dt>
          <dd>{L.product.coldChainValue}</dd>
        </div>
        <div class="spec__row">
          <dt>{L.product.certifications}</dt>
          <dd>{certifications.map((c) => c.code).join(' · ')}</dd>
        </div>
        <div class="spec__row">
          <dt>{L.product.origin}</dt>
          <dd>{L.product.originValue(name)}</dd>
        </div>
      </dl>
      <div class="center-cta">
        <a href={localePath('/contact/', lang)} class="btn btn--primary">{L.common.requestSpecs}</a>
      </div>
    </div>
  </section>

  <!-- ============ RELATED ============ -->
  {
    related.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head" data-rv>
            <span class="eyebrow">{L.product.relatedEyebrow}</span>
            <h2>{L.product.moreIn(category.label)}</h2>
          </div>
          <div class="rel-grid" data-rv data-rv-stagger="80">
            {related.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
          <div class="center-cta">
            <a href={localePath(categoryUrl(category.id), lang)} class="btn btn--primary">
              {L.product.allIn(category.label)}
            </a>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .prod-hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .prod-hero__media {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: var(--white);
    aspect-ratio: 4 / 3;
  }

  /* `contain`, matching the home page cards. Most of the catalogue is 4:3 and
     fills this exactly, but the wider shots were losing their edges — and with
     them the watermark — to a cover crop. The photos are all on white, so the
     padding contain leaves is invisible. */
  .prod-hero__media :global(.prod-hero__img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: var(--white);
  }

  .prod-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue-500);
    margin-bottom: 0.6rem;
  }

  .prod-eyebrow:hover {
    text-decoration: underline;
  }

  .prod-hero__body h1 {
    font-size: clamp(1.9rem, 3.6vw, 2.6rem);
    line-height: 1.2;
    color: var(--navy-900);
  }

  .prod-latin {
    font-style: italic;
    color: var(--text-400);
    margin: 0.3rem 0 1.1rem;
  }

  .prod-desc {
    color: var(--text-600);
    margin-bottom: 1.3rem;
  }

  .prod-forms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin-bottom: 1.6rem;
  }

  .prod-forms li {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--blue-600);
    background: var(--aqua-100);
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
  }

  .prod-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .btn--outline {
    background: transparent;
    color: var(--blue-600);
    border: 2px solid var(--blue-400);
  }

  .btn--outline:hover {
    background: var(--aqua-100);
  }

  .spec {
    max-width: 820px;
    margin: 0 auto;
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .spec__row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1rem;
    padding: 0.9rem 1.4rem;
    border-bottom: 1px solid var(--aqua-100);
  }

  .spec__row:last-child {
    border-bottom: 0;
  }

  .spec dt {
    font-weight: 700;
    color: var(--navy-900);
  }

  .spec dd {
    color: var(--text-600);
  }

  .spec dd a {
    color: var(--blue-600);
    font-weight: 600;
  }

  .rel-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .center-cta {
    text-align: center;
    margin-top: 2.5rem;
  }

  @media (max-width: 980px) {
    .prod-hero__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .rel-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .spec__row {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .rel-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
