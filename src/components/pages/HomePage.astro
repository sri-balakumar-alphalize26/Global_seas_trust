---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import StatsGlance from '../../components/StatsGlance.astro';
import CertBadge from '../../components/CertBadge.astro';
import WaveDivider from '../../components/WaveDivider.astro';
import Bi from '../../components/Bi.astro';
import {
  company,
  stats,
  products,
  certifications,
  divisions,
  processSteps,
  siteImages,
} from '../../data/site';
import { home } from '../../data/home';
import { localePath, type Lang } from '../../i18n';

/**
 * `lang="en"` renders the bilingual home page the client asked for
 * (English with the Arabic line beneath). `lang="ar"` — reached from the
 * header toggle at /ar/ — renders the same page in Arabic only.
 */
interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const ar = lang === 'ar';
/** undefined → stacked bilingual; 'ar' → Arabic only */
const only = ar ? ('ar' as const) : undefined;

// Full-size copies for the lightbox, capped at each photo's own width so the
// smaller supplied sources are never upscaled.
const fullShots = Object.fromEntries(
  await Promise.all(
    products.map(async (p) => [
      p.name,
      (await getImage({ src: p.image, width: Math.min(1600, p.image.width), format: 'webp' })).src,
    ])
  )
);
---

<BaseLayout
  lang={lang}
  title={
    ar
      ? `${company.nameAr} | مصدّر مأكولات بحرية طازجة ومجمّدة في عُمان`
      : `${company.name} | Fresh & Frozen Seafood Exporter in Oman`
  }
  fullTitle
  description={ar
    ? 'مصدّر عُماني لأسماك كاملة وروبيان فانامي — تونة وهامور وشعري وماكريل، مجمّدة تجميداً سريعاً وفق معايير HACCP و ISO 22000 والحلال.'
    : 'Oman exporter of whole fish and vannamei shrimp — tuna, grouper, emperor and mackerel, blast frozen to HACCP, ISO 22000 and HALAL standards.'}
  arabicFont
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <Image src={siteImages.hero} alt="" class="hero-bg" loading="eager" fetchpriority="high" width={1600} />
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="hero-eyebrow">
        {
          ar ? (
            company.taglineAr
          ) : (
            <Fragment>
              <span lang="en">{company.tagline}</span>
              <span lang="ar" dir="rtl">{company.taglineAr}</span>
            </Fragment>
          )
        }
      </p>
      <Bi only={only} as="h1" en={home.hero.h1.en} ar={home.hero.h1.ar} />
      <Bi only={only} class="hero-sub" en={home.hero.sub.en} ar={home.hero.sub.ar} />
      <div class="hero-actions">
        <a href={localePath('/products/', lang)} class:list={['btn', 'btn--primary', { 'btn--bi': !ar }]}>
          {
            ar ? (
              home.hero.explore.ar
            ) : (
              <Fragment>
                <span lang="en">{home.hero.explore.en}</span>
                <span lang="ar" dir="rtl">{home.hero.explore.ar}</span>
              </Fragment>
            )
          }
        </a>
        <a href={localePath('/contact/', lang)} class:list={['btn', 'btn--ghost', { 'btn--bi': !ar }]}>
          {
            ar ? (
              home.hero.contact.ar
            ) : (
              <Fragment>
                <span lang="en">{home.hero.contact.en}</span>
                <span lang="ar" dir="rtl">{home.hero.contact.ar}</span>
              </Fragment>
            )
          }
        </a>
      </div>
    </div>
    <div class="hero-wave" aria-hidden="true">
      <WaveDivider fill="#ffffff" height={90} speed={11} fish={5} />
    </div>
  </section>

  <!-- ============ SOURCING FEATURE ============ -->
  <section class="section">
    <div class="container feature-grid">
      <div class="feature-art" data-rv="left">
        <Image
          src={siteImages.feature}
          alt="Chilled holding room at the Global Seas Trust plant, where the catch is received and graded"
          class="feature-photo"
          width={900}
        />
        <div class="feature-art-badge">
          <Icon name="shield" size={26} />
          <span>
            {
              ar ? (
                home.feature.badge.ar
              ) : (
                <Fragment>
                  <span lang="en">{home.feature.badge.en}</span>
                  <span class="badge-sep" aria-hidden="true">·</span>
                  <span lang="ar" dir="rtl">{home.feature.badge.ar}</span>
                </Fragment>
              )
            }
          </span>
        </div>
      </div>
      <div class="feature-text" data-rv="right">
        <Bi only={only} as="span" class="eyebrow" en={home.feature.eyebrow.en} ar={home.feature.eyebrow.ar} />
        <Bi only={only} as="h2" en={home.feature.h2.en} ar={home.feature.h2.ar} />
        <Bi only={only} en={home.feature.p1.en} ar={home.feature.p1.ar} />
        <Bi only={only} en={home.feature.p2.en} ar={home.feature.p2.ar} />
        <a href={localePath('/about/', lang)} class:list={['btn', 'btn--primary', { 'btn--bi': !ar }]}>
          {
            ar ? (
              home.feature.btn.ar
            ) : (
              <Fragment>
                <span lang="en">{home.feature.btn.en}</span>
                <span lang="ar" dir="rtl">{home.feature.btn.ar}</span>
              </Fragment>
            )
          }
        </a>
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <StatsGlance
    eyebrow={ar ? `${company.nameAr} ${home.stats.eyebrow.ar}` : `${company.name} ${home.stats.eyebrow.en}`}
    eyebrowAr={ar ? undefined : `${company.nameAr} ${home.stats.eyebrow.ar}`}
    title={ar ? 'سلسلة التبريد بالأرقام' : undefined}
    titleAr={ar ? undefined : 'سلسلة التبريد بالأرقام'}
    stats={stats.map((s) => ({
      value: s.value,
      label: ar ? s.labelAr : s.label,
      labelAr: ar ? undefined : s.labelAr,
      icon: s.icon,
    }))}
  />

  <!-- ============ PRODUCTS ============ -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-head" data-rv>
        <Bi only={only} as="span" class="eyebrow" en={home.products.eyebrow.en} ar={home.products.eyebrow.ar} />
        <Bi only={only} as="h2" en={home.products.h2.en} ar={home.products.h2.ar} />
        <Bi only={only} en={home.products.p.en} ar={home.products.p.ar} />
      </div>
      <div class="product-grid" data-rv data-rv-stagger="90">
        {
          products.map((p) => (
            <article class="card product-card">
              <div class="product-visual">
                <Image src={p.image} alt={p.name} class="product-img" width={640} loading="lazy" data-lightbox={fullShots[p.name]} />
              </div>
              <div class="product-body">
                <Bi only={only} as="h3" en={p.name} ar={p.nameAr} />
                <p class="scientific">{p.scientific}</p>
                <Bi only={only} class="forms" en={p.forms} ar={p.formsAr} />
              </div>
            </article>
          ))
        }
      </div>
      <div class="center-cta">
        <a href={localePath('/products/', lang)} class:list={['btn', 'btn--primary', { 'btn--bi': !ar }]}>
          {
            ar ? (
              home.products.btn.ar
            ) : (
              <Fragment>
                <span lang="en">{home.products.btn.en}</span>
                <span lang="ar" dir="rtl">{home.products.btn.ar}</span>
              </Fragment>
            )
          }
        </a>
      </div>
    </div>
  </section>

  <!-- ============ CERTIFICATIONS ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-rv>
        <Bi only={only} as="span" class="eyebrow" en={home.certs.eyebrow.en} ar={home.certs.eyebrow.ar} />
        <Bi only={only} as="h2" en={home.certs.h2.en} ar={home.certs.h2.ar} />
      </div>
      <div class="cert-grid" data-rv data-rv-stagger="90">
        {
          certifications.map((c) => (
            <CertBadge code={c.code} label={ar ? c.labelAr : c.label} labelAr={ar ? undefined : c.labelAr} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ DIVISIONS ============ -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-head" data-rv>
        <Bi only={only} as="span" class="eyebrow" en={home.divisions.eyebrow.en} ar={home.divisions.eyebrow.ar} />
        <Bi only={only} as="h2" en={home.divisions.h2.en} ar={home.divisions.h2.ar} />
      </div>
      <div class="division-grid" data-rv data-rv-stagger="90">
        {
          divisions.map((d) => (
            <article class="card division-card">
              <div class="card-visual">
                <Image src={d.image} alt={d.title} class="card-img" width={720} loading="lazy" />
              </div>
              <div class="card-body">
                <Bi only={only} as="h3" en={d.title} ar={d.titleAr} />
                <Bi only={only} en={d.text} ar={d.textAr} />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-rv>
        <Bi only={only} as="span" class="eyebrow" en={home.process.eyebrow.en} ar={home.process.eyebrow.ar} />
        <Bi only={only} as="h2" en={home.process.h2.en} ar={home.process.h2.ar} />
      </div>
      <ol class="process-grid" data-rv data-rv-stagger="90">
        {
          processSteps.map((s) => (
            <li class="card process-step">
              <div class="card-visual">
                <Image src={s.image} alt={s.title} class="card-img" width={720} loading="lazy" />
                <span class="process-num">{s.step}</span>
              </div>
              <div class="card-body">
                <Bi only={only} as="h3" en={s.title} ar={s.titleAr} />
                <Bi only={only} en={s.text} ar={s.textAr} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ CTA BAND ============ -->
  <section class="cta-band">
    <div class="container cta-inner" data-rv>
      <Bi only={only} as="h2" en={home.cta.h2.en} ar={home.cta.h2.ar} />
      <Bi only={only} en={home.cta.p.en} ar={home.cta.p.ar} />
      <a href={localePath('/contact/', lang)} class:list={['btn', 'btn--primary', { 'btn--bi': !ar }]}>
        {
          ar ? (
            home.cta.btn.ar
          ) : (
            <Fragment>
              <span lang="en">{home.cta.btn.en}</span>
              <span lang="ar" dir="rtl">{home.cta.btn.ar}</span>
            </Fragment>
          )
        }
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    background: var(--navy-900);
    color: var(--white);
    padding: 7rem 0 8rem;
    overflow: hidden;
  }

  .hero :global(.hero-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 120%, rgba(26, 91, 215, 0.4), transparent 55%),
      linear-gradient(160deg, rgba(10, 34, 88, 0.8) 0%, rgba(15, 47, 122, 0.62) 55%, rgba(18, 58, 156, 0.45) 100%);
  }

  .hero-inner {
    position: relative;
    max-width: 780px;
    text-align: center;
  }

  .hero-eyebrow {
    display: inline-grid;
    gap: 0.15rem;
    text-align: center;
    padding: 0.35rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--aqua-300);
    margin-bottom: 1.4rem;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    line-height: 1.15;
    margin-bottom: 1.2rem;
  }

  .hero-sub {
    font-size: 1.08rem;
    color: var(--aqua-100);
    max-width: 620px;
    margin: 0 auto 2.2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 90px;
  }

  /* ---- Sourcing feature ---- */
  .feature-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3.5rem;
    align-items: center;
  }

  .feature-art {
    position: relative;
  }

  .feature-art :global(.feature-photo) {
    width: 100%;
    height: 380px;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }

  .feature-art-badge {
    position: absolute;
    bottom: 18px;
    inset-inline-end: 8%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--white);
    color: var(--navy-800);
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.65rem 1.1rem;
    border-radius: 999px;
    box-shadow: var(--shadow-md);
  }

  .feature-art-badge :global(svg) {
    color: var(--gold-500);
  }

  .feature-art-badge .badge-sep {
    margin: 0 0.35em;
    opacity: 0.5;
  }

  .feature-text .eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--blue-500);
    margin-bottom: 0.6rem;
  }

  .feature-text h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--navy-900);
    margin-bottom: 1rem;
  }

  .feature-text p {
    color: var(--text-600);
    margin-bottom: 1rem;
  }

  .feature-text .btn {
    margin-top: 0.6rem;
  }

  /* ---- Products ---- */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .product-card {
    overflow: hidden;
  }

  .product-visual {
    height: 150px;
    background: linear-gradient(150deg, var(--aqua-100), #d9e6fb);
  }

  /* `contain`, not `cover`: the fish fills its frame edge to edge, so cropping
     to the card's wider ratio sliced ~26% off the top and bottom of every one.
     The photos are already on white, so padding is invisible. */
  .product-visual :global(.product-img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* the img paints its own white ground, so the tint behind never shows
       through the padding contain leaves */
    background: var(--white);
  }

  .product-body {
    padding: 1.1rem 1.2rem 1.3rem;
  }

  .product-body h3 {
    font-size: 1.05rem;
    color: var(--navy-900);
  }

  .scientific {
    font-style: italic;
    font-size: 0.82rem;
    color: var(--text-400);
    margin-bottom: 0.5rem;
  }

  .forms {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--blue-600);
  }

  .center-cta {
    text-align: center;
    margin-top: 2.5rem;
  }

  /* ---- Certifications ---- */
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    max-width: 760px;
    margin: 0 auto;
  }

  /* ---- Shared photo-card layout (divisions + process, per reference) ---- */
  .card-visual {
    position: relative;
    height: 175px;
    overflow: hidden;
  }

  .card-visual :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-body {
    padding: 1.15rem 1.35rem 1.4rem;
  }

  .card-body h3 {
    font-size: 1.02rem;
    color: var(--navy-900);
    margin-bottom: 0.45rem;
  }

  .card-body p {
    font-size: 0.9rem;
    color: var(--text-600);
  }

  /* ---- Divisions ---- */
  .division-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .division-card {
    overflow: hidden;
    background: var(--white);
  }

  /* ---- Process ---- */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    list-style: none;
  }

  .process-step {
    overflow: hidden;
    background: var(--white);
  }

  .process-num {
    position: absolute;
    bottom: 12px;
    inset-inline-start: 12px;
    display: inline-grid;
    place-items: center;
    min-width: 42px;
    height: 30px;
    padding: 0 0.5rem;
    border-radius: 999px;
    background: var(--blue-500);
    color: var(--white);
    font-weight: 700;
    font-size: 0.85rem;
    box-shadow: 0 2px 10px rgba(10, 34, 88, 0.35);
  }

  /* ---- CTA band ---- */
  .cta-band {
    background: linear-gradient(120deg, var(--blue-600), var(--navy-800));
    color: var(--white);
    padding: 3.5rem 0;
  }

  .cta-inner {
    text-align: center;
    max-width: 640px;
  }

  .cta-inner h2 {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    margin-bottom: 0.8rem;
  }

  .cta-inner p {
    color: var(--aqua-100);
    margin-bottom: 1.6rem;
  }

  /* ---- Responsive ---- */
  @media (max-width: 980px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cert-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .division-grid,
    .process-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 680px) {
    .feature-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .division-grid,
    .process-grid {
      grid-template-columns: 1fr;
    }

    /* three badges — one column beats a 2 + 1 orphan row */
    .cert-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
