---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import StatsGlance from '../../components/StatsGlance.astro';
import CertBadge from '../../components/CertBadge.astro';
import WaveDivider from '../../components/WaveDivider.astro';
import Bi from '../../components/Bi.astro';
import {
  company,
  stats,
  products,
  certifications,
  homeDivisions,
  processSteps,
  siteImages,
} from '../../data/site';
import { home } from '../../data/home';
import { localePath, type Lang } from '../../i18n';

/**
 * `lang="en"` renders the bilingual home page the client asked for
 * (English with the Arabic line beneath). `lang="ar"` — reached from the
 * header toggle at /ar/ — renders the same page in Arabic only.
 */
interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const ar = lang === 'ar';
/** undefined → stacked bilingual; 'ar' → Arabic only */
const only = ar ? ('ar' as const) : undefined;

// Full-size copies for the lightbox, capped at each photo's own width so the
// smaller supplied sources are never upscaled.
const fullShots = Object.fromEntries(
  await Promise.all(
    products.map(async (p) => [
      p.name,
      (await getImage({ src: p.image, width: Math.min(1600, p.image.width), format: 'webp' })).src,
    ])
  )
);
---

<BaseLayout
  lang={lang}
  title={
    ar
      ? `${company.nameAr} | مصدّر مأكولات بحرية طازجة ومجمّدة في عُمان`
      : `${company.name} | Fresh & Frozen Seafood Exporter in Oman`
  }
  fullTitle
  description={ar
    ? 'مصدّر عُماني لأسماك كاملة وروبيان فانامي — تونة وهامور وشعري وماكريل، مجمّدة تجميداً سريعاً وفق معايير HACCP و ISO 22000 والحلال.'
    : 'Oman exporter of whole fish and vannamei shrimp — tuna, grouper, emperor and mackerel, blast frozen to HACCP, ISO 22000 and HALAL standards.'}
  arabicFont
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero-photo">
      <Image src={siteImages.hero} alt="" class="hero-bg" loading="eager" fetchpriority="high" width={1536} />
    </div>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="hero-eyebrow">
        {
          ar ? (
            company.taglineAr
          ) : (
            <Fragment>
              <span lang="en">{company.tagline}</span>
              <span lang="ar" dir="rtl">{company.taglineAr}</span>
            </Fragment>
          )
        }
      </p>
      <Bi only={only} as="h1" en={home.hero.h1.en} ar={home.hero.h1.ar} />
      <Bi only={only} class="hero-sub" en={home.hero.sub.en} ar={home.hero.sub.ar} />
      <div class="hero-actions">
        <a href={localePath('/products/', lang)} class:list={['btn', 'btn--primary', { 'btn--bi': !ar }]}>
          {
            ar ? (
              home.hero.explore.ar
            ) : (
              <Fragment>
                <span lang="en">{home.hero.explore.en}</span>
                <span lang="ar" dir="rtl">{home.hero.explore.ar}</span>
              </Fragment>
            )
          }
        </a>
        <a href={localePath('/contact/', lang)} class:list={['btn', 'btn--ghost', { 'btn--bi': !ar }]}>
          {
            ar ? (
              home.hero.contact.ar
            ) : (
              <Fragment>
                <span lang="en">{home.hero.contact.en}</span>
                <span lang="ar" dir="rtl">{home.hero.contact.ar}</span>
              </Fragment>
            )
          }
        </a>
      </div>
    </div>
    <div class="hero-wave" aria-hidden="true">
      <WaveDivider fill="#ffffff" height={56} speed={11} fish={5} />
    </div>
  </section>

  <!-- ============ SOURCING FEATURE ============ -->
  <section class="section">
    <div class="container feature-grid">
      <div class="feature-art" data-rv="left">
        <Image
          src={siteImages.feature}
          alt="Fishing dhows moored off the Omani coast, with seabirds on the shallows where the catch is landed"
          class="feature-photo"
          width={900}
        />
        <div class="feature-art-badge">
          <Icon name="shield" size={26} />
          <span>
            {
              ar ? (
                home.feature.badge.ar
              ) : (
                <Fragment>
                  <span lang="en">{home.feature.badge.en}</span>
                  <span class="badge-sep" aria-hidden="true">·</span>
                  <span lang="ar" dir="rtl">{home.feature.badge.ar}</span>
                </Fragment>
              )
            }
          </span>
        </div>
      </div>
      <div class="feature-text" data-rv="right">
        <Bi only={only} as="span" class="eyebrow" en={home.feature.eyebrow.en} ar={home.feature.eyebrow.ar} />
        <Bi only={only} as="h2" en={home.feature.h2.en} ar={home.feature.h2.ar} />
        <Bi only={only} en={home.feature.p1.en} ar={home.feature.p1.ar} />
        <Bi only={only} en={home.feature.p2.en} ar={home.feature.p2.ar} />
        <a href={localePath('/about/', lang)} class:list={['btn', 'btn--primary', { 'btn--bi': !ar }]}>
          {
            ar ? (
              home.feature.btn.ar
            ) : (
              <Fragment>
                <span lang="en">{home.feature.btn.en}</span>
                <span lang="ar" dir="rtl">{home.feature.btn.ar}</span>
              </Fragment>
            )
          }
        </a>
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <StatsGlance
    eyebrow={ar ? `${company.nameAr} ${home.stats.eyebrow.ar}` : `${company.name} ${home.stats.eyebrow.en}`}
    eyebrowAr={ar ? undefined : `${company.nameAr} ${home.stats.eyebrow.ar}`}
    title={ar ? 'سلسلة التبريد بالأرقام' : undefined}
    titleAr={ar ? undefined : 'سلسلة التبريد بالأرقام'}
    stats={stats.map((s) => ({
      value: s.value,
      label: ar ? s.labelAr : s.label,
      labelAr: ar ? undefined : s.labelAr,
      icon: s.icon,
    }))}
  />

  <!-- ============ PRODUCTS ============ -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-head" data-rv>
        <Bi only={only} as="span" class="eyebrow" en={home.products.eyebrow.en} ar={home.products.eyebrow.ar} />
        <Bi only={only} as="h2" en={home.products.h2.en} ar={home.products.h2.ar} />
        <Bi only={only} en={home.products.p.en} ar={home.products.p.ar} />
      </div>
      <div class="product-grid" data-rv data-rv-stagger="90">
        {
          products.map((p) => (
            <article class="card product-card">
              <div class="product-visual">
                <Image src={p.image} alt={p.name} class="product-img" width={640} loading="lazy" data-lightbox={fullShots[p.name]} />
              </div>
              <div class="product-body">
                <Bi only={only} as="h3" en={p.name} ar={p.nameAr} />
                <p class="scientific">{p.scientific}</p>
                <Bi only={only} class="forms" en={p.forms} ar={p.formsAr} />
              </div>
            </article>
          ))
        }
      </div>
      <div class="center-cta">
        <a href={localePath('/products/', lang)} class:list={['btn', 'btn--primary', { 'btn--bi': !ar }]}>
          {
            ar ? (
              home.products.btn.ar
            ) : (
              <Fragment>
                <span lang="en">{home.products.btn.en}</span>
                <span lang="ar" dir="rtl">{home.products.btn.ar}</span>
              </Fragment>
            )
          }
        </a>
      </div>
    </div>
  </section>

  <!-- ============ CERTIFICATIONS ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-rv>
        <Bi only={only} as="span" class="eyebrow" en={home.certs.eyebrow.en} ar={home.certs.eyebrow.ar} />
        <Bi only={only} as="h2" en={home.certs.h2.en} ar={home.certs.h2.ar} />
      </div>
      <div class="cert-grid" data-rv data-rv-stagger="90">
        {
          certifications.map((c) => (
            <CertBadge code={c.code} label={ar ? c.labelAr : c.label} labelAr={ar ? undefined : c.labelAr} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ DIVISIONS ============ -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-head" data-rv>
        <Bi only={only} as="span" class="eyebrow" en={home.divisions.eyebrow.en} ar={home.divisions.eyebrow.ar} />
        <Bi only={only} as="h2" en={home.divisions.h2.en} ar={home.divisions.h2.ar} />
      </div>
      <div class="division-grid" data-rv data-rv-stagger="90">
        {
          homeDivisions.map((d) => (
            <article class="card division-card">
              <div class="card-visual">
                <Image src={d.image} alt={d.title} class="card-img" width={720} loading="lazy" />
              </div>
              <div class="card-body">
                <Bi only={only} as="h3" en={d.title} ar={d.titleAr} />
                <Bi only={only} en={d.text} ar={d.textAr} />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-rv>
        <Bi only={only} as="span" class="eyebrow" en={home.process.eyebrow.en} ar={home.process.eyebrow.ar} />
        <Bi only={only} as="h2" en={home.process.h2.en} ar={home.process.h2.ar} />
      </div>
      <ol class="process-grid" data-rv data-rv-stagger="90">
        {
          processSteps.map((s) => (
            <li class="card process-step">
              <div class="card-visual">
                <Image src={s.image} alt={s.title} class="card-img" width={720} loading="lazy" />
                <span class="process-num">{s.step}</span>
              </div>
              <div class="card-body">
                <Bi only={only} as="h3" en={s.title} ar={s.titleAr} />
                <Bi only={only} en={s.text} ar={s.textAr} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ CTA BAND ============ -->
  <section class="cta-band">
    <div class="container cta-inner" data-rv>
      <Bi only={only} as="h2" en={home.cta.h2.en} ar={home.cta.h2.ar} />
      <Bi only={only} en={home.cta.p.en} ar={home.cta.p.ar} />
      <a href={localePath('/contact/', lang)} class:list={['btn', 'btn--primary', { 'btn--bi': !ar }]}>
        {
          ar ? (
            home.cta.btn.ar
          ) : (
            <Fragment>
              <span lang="en">{home.cta.btn.en}</span>
              <span lang="ar" dir="rtl">{home.cta.btn.ar}</span>
            </Fragment>
          )
        }
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Hero ----
     The client supplied this 3:1 crop of the fishing photograph and asked for it
     whole. The band takes the crop’s own shape at full bleed, so the picture
     fills it exactly — nothing cropped, nothing letterboxed — and at 1920 that is
     640px, near enough the height the band had before. */
  .hero {
    position: relative;
    display: grid;
    grid-template-areas: 'hero';
    padding: 0;
    /* The ground under the type where it runs past the photo’s bottom edge. It is
       the navy the scrim converges to, so the two composite to the same colour
       and the join does not read as a seam. */
    background: rgb(8, 26, 72);
    color: var(--white);
    overflow: hidden;
  }

  /* Height comes from the asset’s real 1536x512, so the box is exactly the height
     the photo wants at this width. Each element is placed by name rather than
     through a `.hero > *` rule: that scopes to a higher specificity than these
     class selectors and would beat the stacked overrides below. The overlay and
     the wave are absolutely positioned and need no area at all. */
  .hero-photo {
    grid-area: hero;
    align-self: start;
    position: relative;
    width: 100%;
    aspect-ratio: 1536 / 512;
  }

  /* cover, not contain: the box already carries the photo’s ratio, so there is
     nothing to crop; cover only stops sub-pixel rounding leaving a hairline.
     The scale(1.5) zoom, the object-position and the brightness filter all go —
     they existed to rescue a boat from a crop that no longer happens. */
  .hero-photo :global(.hero-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Anchored to the BOTTOM in pixels, not percentages: the type block is a fixed
     ~294px while the band swings from 490px to 643px, so pixel stops keep the
     weight exactly where the type is at every width and leave the boat, the
     golden water and the upper net untouched. The bottom of the ramp also has to
     stay heavy enough to hide the photo/ground join described above. */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        rgba(8, 26, 72, 0.94) 0,
        rgba(8, 26, 72, 0.86) 220px,
        rgba(7, 22, 60, 0.46) 340px,
        rgba(6, 16, 45, 0.16) 450px,
        rgba(6, 16, 45, 0) 570px
      ),
      /* a whisper of brand colour over the whole frame */
      linear-gradient(180deg, rgba(10, 34, 88, 0.1), rgba(26, 91, 215, 0.06));
  }

  /* padding-top is a PERCENTAGE on purpose. Percentage padding resolves against
     the containing block’s width, and this photo’s height is exactly a third of
     its width — so 13.5% of width is ~40.5% of the photo’s height at every
     viewport size, holding the type just below the boat and over the net without
     a single breakpoint. The bottom padding clears the 56px wave. */
  .hero-inner {
    grid-area: hero;
    align-self: end;
    position: relative;
    max-width: 780px;
    text-align: center;
    padding-top: 13.5%;
    padding-bottom: 5.5rem;
  }

  .hero-eyebrow {
    display: inline-grid;
    gap: 0.15rem;
    text-align: center;
    padding: 0.35rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--aqua-300);
    margin-bottom: 1.4rem;
  }

  /* The wash is lighter now so the photo shows through, so the type carries its
     own contrast rather than relying on the ground behind it. */
  .hero h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    line-height: 1.15;
    margin-bottom: 1.2rem;
    text-shadow: 0 2px 20px rgba(6, 16, 45, 0.75);
  }

  .hero-sub {
    font-size: 1.08rem;
    color: var(--aqua-100);
    max-width: 620px;
    margin: 0 auto 2.2rem;
    text-shadow: 0 1px 14px rgba(6, 16, 45, 0.8);
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    /* was 90px — a shorter wave leaves the net’s bottom arc clear */
    height: 56px;
  }

  /* Stacked. Below 780px the type block grows past 400px while the photo drops
     under 260px, so the type would start over the boat and the photo/ground join
     would fall outside the scrim’s reach. The picture takes the top on its own
     and the type sits beneath it, where its contrast stops depending on what is
     behind it. 780px is also .hero-inner’s max-width — the width at which the
     text stops being capped and starts wrapping into more lines. */
  @media (max-width: 780px) {
    .hero {
      grid-template-areas: 'photo' 'text';
    }

    .hero-photo {
      grid-area: photo;
    }

    .hero-inner {
      grid-area: text;
      align-self: stretch;
      /* a fixed value, not the 13.5% above: the type has to clear the photo */
      padding-top: 2.5rem;
      padding-bottom: 5rem;
    }

    /* nothing to darken — the type is on the gradient, and the photograph keeps
       every bit of its colour */
    .hero-overlay {
      display: none;
    }
  }

  /* ---- Sourcing feature ---- */
  .feature-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3.5rem;
    align-items: center;
  }

  .feature-art {
    position: relative;
  }

  .feature-art :global(.feature-photo) {
    width: 100%;
    height: 380px;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }

  .feature-art-badge {
    position: absolute;
    bottom: 18px;
    inset-inline-end: 8%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--white);
    color: var(--navy-800);
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.65rem 1.1rem;
    border-radius: 999px;
    box-shadow: var(--shadow-md);
  }

  .feature-art-badge :global(svg) {
    color: var(--gold-500);
  }

  .feature-art-badge .badge-sep {
    margin: 0 0.35em;
    opacity: 0.5;
  }

  .feature-text .eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--blue-500);
    margin-bottom: 0.6rem;
  }

  .feature-text h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--navy-900);
    margin-bottom: 1rem;
  }

  .feature-text p {
    color: var(--text-600);
    margin-bottom: 1rem;
  }

  .feature-text .btn {
    margin-top: 0.6rem;
  }

  /* ---- Products ---- */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .product-card {
    overflow: hidden;
  }

  .product-visual {
    height: 150px;
    background: linear-gradient(150deg, var(--aqua-100), #d9e6fb);
  }

  /* `contain`, not `cover`: the fish fills its frame edge to edge, so cropping
     to the card's wider ratio sliced ~26% off the top and bottom of every one.
     The photos are already on white, so padding is invisible. */
  .product-visual :global(.product-img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* the img paints its own white ground, so the tint behind never shows
       through the padding contain leaves */
    background: var(--white);
  }

  .product-body {
    padding: 1.1rem 1.2rem 1.3rem;
  }

  .product-body h3 {
    font-size: 1.05rem;
    color: var(--navy-900);
  }

  .scientific {
    font-style: italic;
    font-size: 0.82rem;
    color: var(--text-400);
    margin-bottom: 0.5rem;
  }

  .forms {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--blue-600);
  }

  .center-cta {
    text-align: center;
    margin-top: 2.5rem;
  }

  /* ---- Certifications ---- */
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    max-width: 760px;
    margin: 0 auto;
  }

  /* ---- Shared photo-card layout (divisions + process, per reference) ---- */
  /* A fixed 175px band cropped roughly half of every photo away. The band now
     takes the 3:2 shape most of these photos are, and `contain` rather than
     `cover` guarantees the whole frame is shown — the landscape ones fill it
     edge to edge, and the portrait ones letterbox onto the tint rather than
     losing their top and bottom. */
  .card-visual {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--aqua-100);
  }

  .card-visual :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .card-body {
    padding: 1.15rem 1.35rem 1.4rem;
  }

  .card-body h3 {
    font-size: 1.02rem;
    color: var(--navy-900);
    margin-bottom: 0.45rem;
  }

  .card-body p {
    font-size: 0.9rem;
    color: var(--text-600);
  }

  /* ---- Divisions ---- */
  .division-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .division-card {
    overflow: hidden;
    background: var(--white);
  }

  /* ---- Process ---- */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    list-style: none;
  }

  .process-step {
    overflow: hidden;
    background: var(--white);
  }

  .process-num {
    position: absolute;
    bottom: 12px;
    inset-inline-start: 12px;
    display: inline-grid;
    place-items: center;
    min-width: 42px;
    height: 30px;
    padding: 0 0.5rem;
    border-radius: 999px;
    background: var(--blue-500);
    color: var(--white);
    font-weight: 700;
    font-size: 0.85rem;
    box-shadow: 0 2px 10px rgba(10, 34, 88, 0.35);
  }

  /* ---- CTA band ---- */
  .cta-band {
    background: linear-gradient(120deg, var(--blue-600), var(--navy-800));
    color: var(--white);
    padding: 3.5rem 0;
  }

  .cta-inner {
    text-align: center;
    max-width: 640px;
  }

  .cta-inner h2 {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    margin-bottom: 0.8rem;
  }

  .cta-inner p {
    color: var(--aqua-100);
    margin-bottom: 1.6rem;
  }

  /* ---- Responsive ---- */
  @media (max-width: 980px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cert-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .division-grid,
    .process-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 680px) {
    .feature-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .division-grid,
    .process-grid {
      grid-template-columns: 1fr;
    }

    /* three badges — one column beats a 2 + 1 orphan row */
    .cert-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
