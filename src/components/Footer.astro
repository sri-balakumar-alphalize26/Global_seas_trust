---
import { company, navLinks } from '../data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col footer-about">
      <div class="footer-logo">
        <span class="footer-logo-mark"><Icon name="wave" size={22} /></span>
        <strong>{company.name}</strong>
      </div>
      <p>{company.description}</p>
    </div>

    <div class="footer-col">
      <h4>Quick Links</h4>
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer-col">
      <h4>Contact</h4>
      <ul class="contact-list">
        <li><Icon name="pin" size={18} /><span>{company.address}</span></li>
        <li><Icon name="phone" size={18} /><span>{company.phone}</span></li>
        <li><Icon name="mail" size={18} /><span>{company.email}</span></li>
        <li><Icon name="clock" size={18} /><span>{company.hours}</span></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>
        © {year} {company.name}. All rights reserved. ·
        <a href="/credits/">Image credits</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-900);
    color: var(--aqua-100);
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 1.2fr;
    gap: 2.5rem;
    padding-top: 3.5rem;
    padding-bottom: 2.5rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
    color: var(--white);
    font-size: 1.1rem;
  }

  .footer-logo-mark {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--blue-500);
    color: var(--white);
  }

  .footer-about p {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--aqua-300);
  }

  .footer-col h4 {
    color: var(--white);
    margin-bottom: 1rem;
    font-size: 1rem;
    letter-spacing: 0.04em;
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-col a {
    color: var(--aqua-300);
    font-size: 0.92rem;
    transition: color 0.15s ease;
  }

  .footer-col a:hover {
    color: var(--white);
  }

  .contact-list li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.9rem;
    color: var(--aqua-300);
  }

  .contact-list :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--blue-400);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: 1.1rem 0;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-400);
  }

  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
