---
import { company, navLinks, poweredBy } from '../data/site';
import Icon from './Icon.astro';
import { localePath, t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const L = t(lang);
const year = new Date().getFullYear();
const name = lang === 'ar' ? company.nameAr : company.name;
const description = lang === 'ar' ? company.descriptionAr : company.description;
const address = lang === 'ar' ? company.addressAr : company.address;
const hours = lang === 'ar' ? L.cards.hoursSummary : company.hours;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col footer-about">
      <div class="footer-logo">
        <img src="/gst-logo.webp" alt={`${name} ${L.header.logoAlt}`} class="footer-logo-img" width="48" height="48" />
        <strong>{name}</strong>
      </div>
      <p>{description}</p>
    </div>

    <div class="footer-col">
      <h4>{L.footer.quickLinks}</h4>
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={localePath(link.href, lang)}>{L.nav[link.key]}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="footer-col">
      <h4>{L.footer.contact}</h4>
      <ul class="contact-list">
        <li><Icon name="pin" size={18} /><span>{address}</span></li>
        <li>
          <Icon name="phone" size={18} />
          <a href={`tel:${company.phone.replace(/[^\d+]/g, '')}`} dir="ltr">{company.phone}</a>
        </li>
        <li>
          <Icon name="phone" size={18} />
          <a href={`tel:${company.phoneAlt.replace(/[^\d+]/g, '')}`} dir="ltr">{company.phoneAlt}</a>
        </li>
        <li><Icon name="mail" size={18} /><a href={`mailto:${company.email}`} dir="ltr">{company.email}</a></li>
        <li><Icon name="mail" size={18} /><a href={`mailto:${company.emailSales}`} dir="ltr">{company.emailSales}</a></li>
        <li><Icon name="clock" size={18} /><span>{hours}</span></li>
        <li><Icon name="shield" size={18} /><span>{L.footer.crLine(company.crNumber, company.postalCode)}</span></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-line">
      <span>© {year} {name}. {L.footer.rights}</span>
      <a
        class="powered-by"
        href={poweredBy.url}
        target="_blank"
        rel="noopener"
        aria-label={L.footer.poweredByAria(poweredBy.name)}
      >
        <span>{L.footer.poweredBy}</span>
        <img src={poweredBy.logo} alt={poweredBy.name} width="117" height="22" loading="lazy" />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-900);
    color: var(--aqua-100);
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr 1.2fr;
    gap: 2.5rem;
    padding-top: 3.5rem;
    padding-bottom: 2.5rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
    color: var(--white);
    font-size: 1.1rem;
  }

  .footer-logo-img {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    object-fit: contain;
    background: var(--white);
    padding: 2px;
  }

  .footer-about p {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--aqua-300);
  }

  .footer-col h4 {
    color: var(--white);
    margin-bottom: 1rem;
    font-size: 1rem;
    letter-spacing: 0.04em;
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-col a {
    color: var(--aqua-300);
    font-size: 0.92rem;
    transition: color 0.15s ease;
  }

  .footer-col a:hover {
    color: var(--white);
  }

  .contact-list li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: 0.9rem;
    color: var(--aqua-300);
  }

  .contact-list :global(svg) {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--blue-400);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: 1.1rem 0;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-400);
  }

  .footer-bottom-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem 1.4rem;
  }

  /* "Powered by" + reseller logo; the whole unit is the link */
  .powered-by {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
  }

  .powered-by img {
    display: block;
    height: 22px;
    width: auto;
    transition: opacity 0.15s ease;
  }

  .powered-by:hover img {
    opacity: 0.8;
  }

  @media (max-width: 820px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .footer-bottom-line {
      flex-direction: column;
      gap: 0.6rem;
    }
  }
</style>
