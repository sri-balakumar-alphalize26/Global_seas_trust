---
/**
 * StatsGlance.astro — "At a Glance" band.
 * Cards stagger in on scroll, numbers count up from zero.
 * Re-seeds on astro:page-load, so it replays after a ClientRouter navigation.
 *
 * Site adaptations to the provided component:
 *  - colors retinted to the royal-blue brand palette (logo retheme)
 *  - reduced-motion gates removed (site-wide owner decision — animations
 *    always run; see transitions.css note)
 */

interface Stat {
  value: string; // "14+", "350+", "60T", "12,000", "99.4%"
  label: string;
  /** Arabic label, shown under the English one (bilingual pages) */
  labelAr?: string;
  icon: 'anchor' | 'team' | 'globe' | 'truck';
}

interface Props {
  eyebrow?: string;
  eyebrowAr?: string;
  title?: string;
  titleAr?: string;
  stats?: Stat[];
}

const {
  eyebrow = 'Global Seas Trust at a Glance',
  eyebrowAr,
  title = 'A Decade of Steady Growth',
  titleAr,
  stats = [
    { value: '14+', label: 'Years of Experience', icon: 'anchor' },
    { value: '350+', label: 'Team Members', icon: 'team' },
    { value: '25+', label: 'Export Markets', icon: 'globe' },
    { value: '60T', label: 'Daily Cold-Chain Capacity', icon: 'truck' },
  ],
} = Astro.props;

/** Split "1,250.5 kg" into prefix / number / suffix so the counter animates
 *  only the digits and keeps whatever decorates them. */
function parse(value: string) {
  const m = value.match(/^([^\d-]*)(-?[\d,]*\.?\d+)(.*)$/);
  if (!m) return { prefix: '', target: 0, suffix: value, decimals: 0 };
  const raw = m[2].replace(/,/g, '');
  return {
    prefix: m[1],
    target: parseFloat(raw),
    suffix: m[3],
    decimals: raw.includes('.') ? raw.split('.')[1].length : 0,
  };
}
---

<section class="glance">
  <div class="glance__inner">
    <p class="glance__eyebrow">
      {eyebrow}
      {eyebrowAr && <span class="glance__ar" lang="ar" dir="rtl">{eyebrowAr}</span>}
    </p>
    <h2 class="glance__title">
      {title}
      {titleAr && <span class="glance__ar" lang="ar" dir="rtl">{titleAr}</span>}
    </h2>

    <div class="glance__grid">
      {
        stats.map((s) => {
          const p = parse(s.value);
          return (
            <article class="glance__card">
              <span class="glance__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {s.icon === 'anchor' && (
                    <>
                      <circle cx="12" cy="5" r="2.4" />
                      <line x1="12" y1="7.4" x2="12" y2="21" />
                      <line x1="7" y1="11" x2="17" y2="11" />
                      <path d="M4 15a8 8 0 0 0 16 0" />
                    </>
                  )}
                  {s.icon === 'team' && (
                    <>
                      <circle cx="9" cy="8" r="3.1" />
                      <path d="M2.5 20a6.5 6.5 0 0 1 13 0" />
                      <path d="M16.5 5.6a3.1 3.1 0 0 1 0 4.9" />
                      <path d="M17.5 14.2A6.5 6.5 0 0 1 21.5 20" />
                    </>
                  )}
                  {s.icon === 'globe' && (
                    <>
                      <circle cx="12" cy="12" r="9" />
                      <line x1="3" y1="12" x2="21" y2="12" />
                      <path d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18Z" />
                    </>
                  )}
                  {s.icon === 'truck' && (
                    <>
                      <path d="M2 7h11v9H2z" />
                      <path d="M13 10h4l3 3.2V16h-7z" />
                      <circle cx="7" cy="18" r="1.9" />
                      <circle cx="17" cy="18" r="1.9" />
                    </>
                  )}
                </svg>
              </span>

              <b
                class="glance__value"
                data-count={p.target}
                data-prefix={p.prefix}
                data-suffix={p.suffix}
                data-decimals={p.decimals}
              >
                {s.value}
              </b>

              <span class="glance__label">
                {s.label}
                {s.labelAr && <span class="glance__ar" lang="ar" dir="rtl">{s.labelAr}</span>}
              </span>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  /* Arabic line under an English eyebrow / title / label */
  .glance__ar {
    display: block;
    margin-top: 0.15em;
    font-size: 0.92em;
    opacity: 0.92;
  }

  .glance {
    --sky: var(--aqua-300, #8fb4f2);
    position: relative;
    isolation: isolate;
    padding-block: 88px;
    background: linear-gradient(165deg, #0a2258 0%, #0e2c72 46%, #113592 100%);
    color: #fff;
    overflow: hidden;
  }

  /* the soft lift under the middle of the band */
  .glance::before {
    content: '';
    position: absolute;
    inset: 20% -10% -40%;
    background: radial-gradient(52% 60% at 50% 100%, rgba(61, 123, 232, 0.28) 0%, rgba(10, 34, 88, 0) 72%);
    z-index: -1;
  }

  .glance__inner {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 28px;
    text-align: center;
  }

  .glance__eyebrow {
    margin: 0 0 16px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sky);
  }

  .glance__title {
    margin: 0 0 54px;
    font-size: clamp(2rem, 3.6vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.12;
    color: #fff;
  }

  .glance__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 26px;
  }

  .glance__card {
    padding: 36px 24px 32px;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.055);
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.45s ease,
      background-color 0.45s ease;
  }

  .glance__card:hover {
    transform: translateY(-6px);
    border-color: rgba(143, 180, 242, 0.4);
    background: rgba(255, 255, 255, 0.085);
  }

  .glance__icon {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    margin: 0 auto 26px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: var(--sky);
  }

  .glance__icon svg {
    width: 32px;
    height: 32px;
  }

  .glance__value {
    display: block;
    font-size: clamp(2rem, 3.2vw, 2.6rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }

  .glance__label {
    display: block;
    margin-top: 12px;
    font-size: 0.9375rem;
    color: var(--sky);
  }

  /* ---- entrance: hidden only once the observer is live (no-JS keeps it) ---- */
  :global(html.glance-ready) .glance__card {
    opacity: 0;
    transform: translate3d(0, 26px, 0);
  }

  :global(html.glance-ready) .glance__card.is-in {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(html.glance-ready) .glance__card .glance__icon {
    transform: scale(0.72);
    opacity: 0;
  }

  :global(html.glance-ready) .glance__card.is-in .glance__icon {
    transform: none;
    opacity: 1;
    transition:
      transform 0.75s cubic-bezier(0.34, 1.56, 0.64, 1) 0.12s,
      opacity 0.5s ease 0.12s;
  }

  @media (max-width: 1024px) {
    .glance__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .glance {
      padding-block: 64px;
    }
    .glance__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  const STAGGER = 110; // ms between cards
  const DURATION = 1500; // ms for the count-up

  let io: IntersectionObserver | null = null;

  const easeOutCubic = (t: number) => 1 - Math.pow(1 - t, 3);

  function format(el: HTMLElement, v: number) {
    const dec = Number(el.dataset.decimals ?? 0);
    return (
      (el.dataset.prefix ?? '') +
      v.toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec }) +
      (el.dataset.suffix ?? '')
    );
  }

  function count(el: HTMLElement, delay: number) {
    const target = Number(el.dataset.count ?? 0);
    const start = performance.now() + delay;
    const step = (now: number) => {
      const p = Math.min(1, Math.max(0, (now - start) / DURATION));
      const v = target * easeOutCubic(p);
      const dec = Number(el.dataset.decimals ?? 0);
      el.textContent = format(el, dec ? v : Math.round(v));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  function run(section: Element) {
    section.querySelectorAll<HTMLElement>('.glance__card').forEach((card, i) => {
      card.style.transitionDelay = `${i * STAGGER}ms`;
      card.classList.add('is-in');
      const value = card.querySelector<HTMLElement>('.glance__value');
      if (value) count(value, i * STAGGER + 160);
    });
  }

  function seed() {
    const sections = document.querySelectorAll('.glance');
    if (!sections.length) return;

    document.documentElement.classList.add('glance-ready');
    io?.disconnect();

    // back to zero, so a fresh page view always animates from the start
    for (const el of document.querySelectorAll<HTMLElement>('.glance__value')) {
      el.textContent = format(el, 0);
    }

    io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          run(entry.target);
          io?.unobserve(entry.target);
        }
      },
      { threshold: 0.25 },
    );

    for (const section of sections) io.observe(section);
  }

  document.addEventListener('astro:page-load', seed);
</script>
