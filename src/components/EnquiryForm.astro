---
/**
 * EnquiryForm.astro — "Send an Enquiry" + the Find Us panel.
 *
 * Entrance: heading, then the fields deal in one after another from the left;
 * the map panel scales up on the right and its pin drops with a bounce and a
 * single ripple. The whole panel is a link into Google Maps.
 *
 * Site adaptation: reduced-motion opt-out removed per the site-wide
 * always-animate decision (see transitions.css note).
 */

import 'intl-tel-input/styles';
import { company } from '../data/site';

import { t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
  addressLines?: string[];
  mapQuery?: string;
  /** direct Google Maps link (share URL) — wins over `mapQuery` when set */
  mapsUrl?: string;
  /** Commercial Registration number, shown under the address */
  crNumber?: string;
  /** optional Google Maps embed src; falls back to the illustrated panel */
  embedSrc?: string;
  action?: string;
}

const { lang = 'en' } = Astro.props;
const L = t(lang);

const {
  addressLines = lang === 'ar' ? company.addressLinesAr : company.addressLines,
  mapQuery,
  mapsUrl: mapsUrlProp = company.mapsUrl,
  crNumber = company.crNumber,
  embedSrc,
  action,
} = Astro.props;

const query = mapQuery ?? addressLines.join(' ').replace(/,\s*$/, '');
const mapsUrl = mapsUrlProp ?? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;

const fields = [
  { name: 'name', label: L.form.name, type: 'text', placeholder: L.form.namePh, required: true, half: true },
  { name: 'company', label: L.form.company, type: 'text', placeholder: L.form.companyPh, required: false, half: true },
  { name: 'email', label: L.form.email, type: 'email', placeholder: L.form.emailPh, required: true, half: true },
  { name: 'phone', label: L.form.phone, type: 'tel', placeholder: L.form.phonePh, required: false, half: true },
  {
    name: 'subject',
    label: L.form.subject,
    type: 'text',
    placeholder: L.form.subjectPh,
    required: true,
    half: false,
  },
];
---

<section class="eq">
  <div class="eq__inner">
    <!-- ------------------------------------------------------------ form -->
    <div class="eq__form-col">
      <h2 class="eq__title" style="--i:0">{L.form.h2}</h2>
      <p class="eq__sub" style="--i:1">{L.form.lede}</p>

      <form class="eq__form" action={action} method="post" novalidate>
        <div class="eq__rows">
          {
            fields.map((f, i) =>
              f.name === 'phone' ? (
                <div class="eq__field eq__field--half eq__field--phone" style={`--i:${i + 2}`}>
                  <span id="eq-phone-label">{f.label}</span>
                  {/* intl-tel-input attaches here: country dropdown + per-country
                      digit rules. Kept outside a <label> — the dropdown misbehaves
                      inside one (label clicks re-focus the input and close it). */}
                  {/* display-only: no name, so its national digits never post.
                      The hidden field below carries the full +E.164 number. */}
                  <input type="tel" data-iti aria-labelledby="eq-phone-label" autocomplete="tel" dir="ltr" />
                  <input type="hidden" name="phone" data-phone-e164 />
                  <em class="eq__err" data-phone-err hidden>{L.form.phoneError}</em>
                </div>
              ) : (
                <label class:list={['eq__field', { 'eq__field--half': f.half }]} style={`--i:${i + 2}`}>
                  <span>
                    {f.label} {f.required && <i aria-hidden="true">*</i>}
                  </span>
                  <input type={f.type} name={f.name} placeholder={f.placeholder} required={f.required} />
                </label>
              )
            )
          }

          <label class="eq__field" style={`--i:${fields.length + 2}`}>
            <span>{L.form.message} <i aria-hidden="true">*</i></span>
            <textarea name="message" rows="6" placeholder={L.form.messagePh} required></textarea>
          </label>
        </div>

        <button class="eq__submit" type="submit" style={`--i:${fields.length + 3}`}>
          <span>{L.form.submit}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 12h15M13 6l6 6-6 6" />
          </svg>
        </button>

        <p class="eq__done" data-done hidden>{L.form.success}</p>
      </form>

      <!-- shown when Send is tapped with an invalid phone number -->
      <dialog class="eq__alert" aria-labelledby="eq-alert-title">
        <div class="eq__alert-box">
          <span class="eq__alert-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10.3 3.8 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.8a2 2 0 0 0-3.4 0Z"></path>
              <path d="M12 9v4.5"></path>
              <circle cx="12" cy="16.8" r="0.6" fill="currentColor"></circle>
            </svg>
          </span>
          <h3 id="eq-alert-title">{L.form.invalidTitle}</h3>
          <p>{L.form.invalidText}</p>
          <button type="button" class="eq__alert-ok" data-alert-ok>{L.form.ok}</button>
        </div>
      </dialog>
    </div>

    <!-- ------------------------------------------------------------- map -->
    {
      embedSrc ? (
        <div class="eq__map eq__map--embed" style="--i:2">
          <iframe
            src={embedSrc}
            title={L.form.mapTitle(lang === 'ar' ? company.nameAr : company.name)}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          />
          <a
            class="eq__map-foot"
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={L.common.openInMapsAria(query)}
          >
            {addressLines.map((l) => (
              <span class="eq__addr">{l}</span>
            ))}
            {crNumber && <span class="eq__addr">{L.common.crNo(crNumber)}</span>}
            <span class="eq__map-hint">{L.common.openInMaps}</span>
          </a>
        </div>
      ) : (
        <a
          class="eq__map"
          style="--i:2"
          href={mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={L.common.openInMapsAria(query)}
        >
          <span class="eq__pin">
            <span class="eq__ripple" aria-hidden="true" />
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 22s7.5-6.6 7.5-11.8A7.5 7.5 0 1 0 4.5 10.2C4.5 15.4 12 22 12 22Z" fill="currentColor" />
              <circle cx="12" cy="10" r="2.7" fill="#fff" />
            </svg>
          </span>
          <strong>{L.form.findUs}</strong>
          {addressLines.map((l) => (
            <span class="eq__addr">{l}</span>
          ))}
          {crNumber && <span class="eq__addr">{L.common.crNo(crNumber)}</span>}
          <span class="eq__map-hint">{L.common.openInMaps}</span>
        </a>
      )
    }
  </div>
</section>

<style>
  .eq {
    --eq-ink: #0a2258;
    --eq-body: #46596b;
    --eq-brand: #1a5bd7;
    --eq-soft: #e8f0fd;
    --eq-field: #f6f8fd;
    --eq-line: #e2e9f8;
    --eq-step: 70ms;
    --eq-ease: cubic-bezier(0.22, 1, 0.36, 1);

    padding-block: 40px 84px;
    background: #fff;
  }

  .eq__inner {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 28px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: start;
  }

  .eq__title {
    margin: 0 0 8px;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--eq-ink);
  }

  .eq__sub {
    margin: 0 0 26px;
    font-size: 0.875rem;
    color: var(--eq-brand);
  }

  .eq__rows {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .eq__field {
    display: grid;
    gap: 7px;
    grid-column: 1 / -1;
  }

  .eq__field--half {
    grid-column: span 1;
  }

  .eq__field span {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--eq-ink);
  }

  .eq__field i {
    font-style: normal;
    color: var(--eq-brand);
  }

  .eq__field input,
  .eq__field textarea {
    font: inherit;
    font-size: 0.9063rem;
    color: var(--eq-ink);
    background: var(--eq-field);
    border: 1px solid var(--eq-line);
    border-radius: 8px;
    padding: 12px 14px;
    transition:
      border-color 240ms ease,
      background-color 240ms ease,
      box-shadow 240ms ease;
  }

  .eq__field textarea {
    resize: vertical;
    line-height: 1.6;
  }

  .eq__field input::placeholder,
  .eq__field textarea::placeholder {
    color: #9aa7bd;
  }

  .eq__field input:focus,
  .eq__field textarea:focus {
    outline: none;
    background: #fff;
    border-color: var(--eq-brand);
    box-shadow: 0 0 0 4px rgba(26, 91, 215, 0.13);
  }

  /* ---- country-code phone input ---- */
  .eq__field--phone :global(.iti) {
    width: 100%;
  }

  .eq__field--phone :global(.iti__dropdown-content) {
    border-radius: 10px;
    border: 1px solid var(--eq-line);
    box-shadow: 0 18px 40px rgba(10, 34, 88, 0.16);
    z-index: 20;
  }

  .eq__field--phone :global(.iti__country.iti__highlight) {
    background: var(--eq-soft);
  }

  /* keep the library's own padding — it clears the built-in search icon */
  .eq__field--phone :global(.iti__search-input) {
    font: inherit;
  }

  .eq__err {
    font-style: normal;
    font-size: 0.78rem;
    font-weight: 600;
    color: #b23b32;
  }

  .eq__field.is-invalid input {
    border-color: #b23b32;
    box-shadow: 0 0 0 4px rgba(178, 59, 50, 0.12);
  }

  /* ---- invalid-phone popup ---- */
  .eq__alert {
    /* the global `* { margin: 0 }` reset kills UA dialog centering */
    position: fixed;
    inset: 0;
    margin: auto;
    height: fit-content;
    width: min(360px, calc(100vw - 40px));
    border: 0;
    padding: 0;
    background: transparent;
  }

  .eq__alert::backdrop {
    background: rgba(6, 20, 52, 0.45);
    backdrop-filter: blur(2px);
  }

  .eq__alert-box {
    background: #fff;
    border-radius: 14px;
    padding: 26px 24px 22px;
    text-align: center;
    box-shadow: 0 30px 70px rgba(6, 20, 52, 0.3);
    animation: eqAlertIn 320ms var(--eq-ease) both;
  }

  @keyframes eqAlertIn {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .eq__alert-icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin: 0 auto 12px;
    border-radius: 50%;
    background: #fdeceb;
    color: #b23b32;
  }

  .eq__alert-icon svg {
    width: 22px;
    height: 22px;
  }

  .eq__alert-box h3 {
    margin: 0 0 6px;
    font-size: 1rem;
    font-weight: 700;
    color: var(--eq-ink);
  }

  .eq__alert-box p {
    margin: 0 0 16px;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--eq-body);
  }

  .eq__alert-ok {
    appearance: none;
    font: inherit;
    font-weight: 700;
    font-size: 0.875rem;
    padding: 9px 30px;
    border: 0;
    border-radius: 999px;
    background: var(--eq-brand);
    color: #fff;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      transform 200ms var(--eq-ease);
  }

  .eq__alert-ok:hover {
    background: #1650c4;
    transform: translateY(-1px);
  }

  .eq__submit {
    appearance: none;
    font: inherit;
    font-weight: 700;
    font-size: 0.9375rem;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 22px;
    padding: 13px 26px;
    border: 0;
    border-radius: 999px;
    background: var(--eq-brand);
    color: #fff;
    cursor: pointer;
    box-shadow: 0 10px 24px rgba(26, 91, 215, 0.3);
    transition:
      transform 260ms var(--eq-ease),
      box-shadow 260ms var(--eq-ease),
      background-color 260ms ease;
  }

  .eq__submit svg {
    width: 17px;
    height: 17px;
    transition: transform 320ms var(--eq-ease);
  }

  .eq__submit:hover {
    background: #1650c4;
    transform: translateY(-2px);
    box-shadow: 0 16px 32px rgba(26, 91, 215, 0.36);
  }

  .eq__submit:hover svg {
    transform: translateX(4px);
  }

  /* the arrow points the way the text runs */
  :global([dir='rtl']) .eq__submit svg {
    transform: scaleX(-1);
  }

  :global([dir='rtl']) .eq__submit:hover svg {
    transform: scaleX(-1) translateX(4px);
  }

  .eq__submit:active {
    transform: translateY(0) scale(0.98);
  }

  .eq__done {
    margin: 16px 0 0;
    font-size: 0.9063rem;
    font-weight: 600;
    color: #0f7a48;
    animation: eqDone 480ms var(--eq-ease) both;
  }

  @keyframes eqDone {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* -------------------------------------------------------------- map -- */

  .eq__map {
    display: grid;
    justify-items: center;
    align-content: center;
    text-align: center;
    min-height: 420px;
    padding: 40px 28px;
    border-radius: 12px;
    background: var(--eq-soft);
    border: 1.5px dashed #a9c3f2;
    color: var(--eq-body);
    transition:
      border-color 320ms ease,
      box-shadow 320ms ease,
      transform 420ms var(--eq-ease);
  }

  .eq__map:hover {
    border-color: var(--eq-brand);
    box-shadow: 0 18px 44px rgba(26, 91, 215, 0.14);
    transform: translateY(-3px);
  }

  .eq__map--embed {
    grid-template-rows: 1fr auto;
    justify-items: stretch;
    align-content: stretch;
    padding: 0;
    overflow: hidden;
    border-style: solid;
  }

  .eq__map--embed iframe {
    width: 100%;
    height: 100%;
    min-height: 340px;
    border: 0;
    display: block;
  }

  /* address + C.R. + link under the live map */
  .eq__map-foot {
    display: grid;
    gap: 2px;
    justify-items: center;
    padding: 14px 18px 16px;
    background: var(--eq-soft);
    color: inherit;
  }

  .eq__pin {
    position: relative;
    display: grid;
    place-items: center;
    color: var(--eq-brand);
    margin-bottom: 18px;
  }

  .eq__pin svg {
    width: 34px;
    height: 34px;
  }

  .eq__ripple {
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 34px;
    height: 12px;
    margin-left: -17px;
    border-radius: 50%;
    border: 2px solid var(--eq-brand);
    opacity: 0;
  }

  .eq__map strong {
    font-size: 1rem;
    font-weight: 700;
    color: #0f2f7a;
    margin-bottom: 10px;
  }

  .eq__addr {
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .eq__map-hint {
    margin-top: 16px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--eq-brand);
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 300ms var(--eq-ease),
      transform 300ms var(--eq-ease);
  }

  .eq__map:hover .eq__map-hint,
  .eq__map:focus-visible .eq__map-hint {
    opacity: 1;
    transform: none;
  }

  /* ------------------------------------------------------ entrance state */

  :global(html.eq-ready) .eq__title,
  :global(html.eq-ready) .eq__sub,
  :global(html.eq-ready) .eq__field,
  :global(html.eq-ready) .eq__submit {
    opacity: 0;
    transform: translate3d(-18px, 0, 0);
  }

  :global(html.eq-ready) .eq__map {
    opacity: 0;
    transform: translate3d(0, 20px, 0) scale(0.97);
  }

  :global(html.eq-ready) .eq__pin {
    opacity: 0;
    transform: translateY(-26px);
  }

  .eq.is-in .eq__title,
  .eq.is-in .eq__sub,
  .eq.is-in .eq__field,
  .eq.is-in .eq__submit {
    opacity: 1;
    transform: none;
    transition:
      opacity 560ms var(--eq-ease) calc(var(--i) * var(--eq-step)),
      transform 560ms var(--eq-ease) calc(var(--i) * var(--eq-step));
  }

  .eq.is-in .eq__map {
    opacity: 1;
    transform: none;
    transition:
      opacity 700ms var(--eq-ease) calc(var(--i) * var(--eq-step)),
      transform 700ms var(--eq-ease) calc(var(--i) * var(--eq-step)),
      border-color 320ms ease,
      box-shadow 320ms ease;
  }

  /* the pin falls in after the panel has landed */
  .eq.is-in .eq__pin {
    opacity: 1;
    transform: none;
    transition:
      opacity 260ms ease 420ms,
      transform 720ms cubic-bezier(0.3, 1.5, 0.5, 1) 420ms;
  }

  .eq.is-in .eq__ripple {
    animation: eqRipple 900ms var(--eq-ease) 900ms;
  }

  @keyframes eqRipple {
    0% {
      opacity: 0.6;
      transform: scale(0.4);
    }
    100% {
      opacity: 0;
      transform: scale(2.4);
    }
  }

  /* ---------------------------------------------------------- responsive */

  @media (max-width: 940px) {
    .eq__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 34px;
    }
    .eq__map {
      min-height: 300px;
    }
  }

  @media (max-width: 560px) {
    .eq__rows {
      grid-template-columns: minmax(0, 1fr);
    }
    .eq__field--half {
      grid-column: 1 / -1;
    }
    .eq__map-hint {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // The WithUtils bundle ships libphonenumber's rules inside the main module —
  // no separate dynamic chunk that can fail to load (which silently disabled
  // both the strictMode digit cap and validation in dev).
  //
  // Loaded DYNAMICALLY on purpose: a static import makes the whole form script
  // fail as one unit, so a single bad response for this 300 kB chunk (the dev
  // server returns 504 "Outdated Optimize Dep" after Vite re-optimizes) used to
  // take the submit handler and the entrance animation down with it. Now the
  // form always works and only the country dropdown waits for the module.
  type ItiModule = typeof import('intl-tel-input/intlTelInputWithUtils');
  type Iti = ReturnType<ItiModule['default']>;

  let itiModule: ItiModule['default'] | null = null;
  let itiPending: Promise<ItiModule['default'] | null> | null = null;

  /** Resolve the library once per page load; retry once, then give up quietly. */
  function loadIti(): Promise<ItiModule['default'] | null> {
    if (itiModule) return Promise.resolve(itiModule);
    if (itiPending) return itiPending;
    const attempt = (): Promise<ItiModule['default'] | null> =>
      import('intl-tel-input/intlTelInputWithUtils').then((m) => m.default);
    itiPending = attempt()
      .catch(() => new Promise((r) => setTimeout(r, 400)).then(attempt))
      .then((mod) => {
        itiModule = mod;
        return mod;
      })
      .catch(() => {
        // Country dropdown unavailable — the phone box stays a plain input and
        // whatever the visitor types is still submitted.
        console.warn('[EnquiryForm] intl-tel-input failed to load; phone field left unvalidated');
        itiPending = null;
        return null;
      });
    return itiPending;
  }

  let io: IntersectionObserver | null = null;

  function seed() {
    const sections = document.querySelectorAll<HTMLElement>('.eq');
    if (!sections.length) return;

    document.documentElement.classList.add('eq-ready');
    io?.disconnect();

    for (const s of sections) {
      s.classList.remove('is-in');

      // ---- country-code phone input (intl-tel-input + libphonenumber rules).
      // strictMode caps typing at the selected country's max length (e.g. 10
      // digits for India +91) and utils validate prefixes (6/7/8/9 for IN).
      const phoneInput = s.querySelector<HTMLInputElement>('input[data-iti]');
      // Held in an object so the async loader below can fill it in without the
      // validators capturing a stale `null`.
      const phone: { iti: Iti | null } = { iti: null };

      const err = s.querySelector<HTMLElement>('[data-phone-err]');
      const fieldWrap = phoneInput?.closest<HTMLElement>('.eq__field');

      const PADS = ['9', '2', '8', '5', '0'];

      /** Can ANY valid number for this country still start with these digits?
       *  Probed by padding the typed digits out to full length with a small
       *  set of fillers and asking libphonenumber about each candidate — so
       *  "1" under +91 flags instantly (nothing Indian completes from it),
       *  while "98" stays clean because 98xxx xxxxx can. */
      const prefixPossible = (nat: string, iso2: string): boolean => {
        const utils = (itiModule as unknown as { utils?: { isValidNumber(n: string, c: string): boolean } } | null)
          ?.utils;
        if (!utils || !nat) return true; // utils still loading — don't flag
        for (const pad of PADS) {
          let cand = nat;
          for (let len = nat.length; len < 16; len++) {
            cand += pad;
            if (utils.isValidNumber(cand, iso2)) return true;
          }
        }
        return false;
      };

      const showError = (bad: boolean) => {
        if (err) err.hidden = !bad;
        fieldWrap?.classList.toggle('is-invalid', bad);
      };

      /** Strict check for blur/submit: complete and valid, or empty. */
      const validatePhone = () => {
        if (!phone.iti || !phoneInput) return true;
        const ok = phoneInput.value.trim() === '' || phone.iti.isValidNumber() === true;
        showError(!ok);
        return ok;
      };

      /** Live check while typing: flag as soon as the prefix is impossible. */
      const validateLive = () => {
        if (!phone.iti || !phoneInput) return;
        const nat = phoneInput.value.replace(/\D/g, '');
        if (!nat) return showError(false);
        if (phone.iti.isValidNumber() === true) return showError(false);
        const iso2 = String(phone.iti.getSelectedCountryData().iso2 ?? '');
        showError(!prefixPossible(nat, iso2));
      };

      // Attach the country dropdown as soon as the library resolves. Listeners
      // are wired first so typing before it lands is re-checked afterwards.
      if (phoneInput) {
        void loadIti().then((factory) => {
          if (!factory) return;
          phone.iti = phoneInput.closest('.iti')
            ? factory.getInstance(phoneInput)
            : factory(phoneInput, {
                initialCountry: 'om',
                separateDialCode: true,
                strictMode: true,
                countryOrder: ['om', 'in', 'ae', 'sa', 'qa', 'us', 'gb'],
              });
          if (phoneInput.value.trim() !== '') validateLive();
        });
      }

      phoneInput?.addEventListener('blur', validatePhone);
      phoneInput?.addEventListener('input', validateLive);
      phoneInput?.addEventListener('countrychange', validateLive);

      const form = s.querySelector<HTMLFormElement>('.eq__form');
      const e164 = s.querySelector<HTMLInputElement>('[data-phone-e164]');
      const alertBox = s.querySelector<HTMLDialogElement>('.eq__alert');
      alertBox?.querySelector('[data-alert-ok]')?.addEventListener('click', () => alertBox.close());
      alertBox?.addEventListener('click', (ev) => {
        if (ev.target === alertBox) alertBox.close();
      });
      alertBox?.addEventListener('close', () => phoneInput?.focus());

      form?.addEventListener('submit', (e) => {
        // phone rules apply whether or not a backend is wired up
        if (!validatePhone()) {
          e.preventDefault();
          alertBox?.showModal();
          return;
        }
        // a backend reads the HIDDEN field in full international format —
        // the visible box keeps only the national digits the visitor typed
        // If the library never loaded, post whatever was typed rather than
        // silently dropping the visitor's number.
        if (e164) {
          const typed = phoneInput?.value.trim() ?? '';
          e164.value = typed === '' ? '' : (phone.iti?.getNumber() ?? typed);
        }

        // demo-only completion — drop once `action` points at your endpoint
        if (!form.getAttribute('action')) {
          e.preventDefault();
          if (!form.reportValidity()) return;
          const done = form.querySelector<HTMLElement>('[data-done]');
          if (done) done.hidden = false;
          form.reset();
          phone.iti?.setNumber('');
        }
      });
    }

    io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-in');
          io?.unobserve(e.target);
        }
      },
      { threshold: 0.12 },
    );

    for (const s of sections) io.observe(s);
  }

  document.addEventListener('astro:page-load', seed);
</script>
