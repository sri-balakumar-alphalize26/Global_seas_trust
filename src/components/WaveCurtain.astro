---
/**
 * WaveCurtain.astro — the ocean sweep that plays between pages.
 *
 * Rendered once in BaseLayout and kept alive across navigations with
 * `transition:persist`, so the very same DOM node keeps animating while
 * Astro swaps the document underneath it.
 *
 * Motion is choreographed from Astro's router lifecycle:
 *   astro:before-preparation → the wave rises while the next page is fetched
 *   astro:after-swap         → the wave sweeps up and off, content surfaces
 *
 * Site adaptations to the provided component: swells retinted to the
 * royal-blue brand palette (front swell must match the panel's top color),
 * and the reduced-motion gates removed per the site-wide always-animate
 * decision (see transitions.css note).
 */

const PERIOD = 500;
const VIEW_W = 2000;
const VIEW_H = 120;

/** A tileable swell. Drawn one period wider on each side so the drift
 *  animation (translateX -25% = exactly one period) never exposes an edge. */
function swell(baseline: number, amplitude: number) {
  const h = amplitude * 2; // quadratic peaks at half the control offset
  let d = `M ${-PERIOD},${baseline}`;
  for (let i = 0; i < 6; i++) {
    d += ` q ${PERIOD / 4},${-h} ${PERIOD / 2},0 q ${PERIOD / 4},${h} ${PERIOD / 2},0`;
  }
  return `${d} L ${PERIOD * 5},${VIEW_H} L ${-PERIOD},${VIEW_H} Z`;
}

const swells = [
  { cls: 'back', d: swell(40, 22), fill: '#1a5bd7', opacity: 0.38 },
  { cls: 'mid', d: swell(56, 28), fill: '#123a9c', opacity: 0.7 },
  { cls: 'front', d: swell(72, 34), fill: '#0a2258', opacity: 1 },
];
---

<div id="gst-wave" class="gst-wave" aria-hidden="true" transition:persist="gst-wave">
  <svg
    class="gst-wave__crest gst-wave__crest--lead"
    viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
    preserveAspectRatio="none"
    focusable="false"
  >
    {
      swells.map((s) => (
        <path class={`gst-wave__swell gst-wave__swell--${s.cls}`} d={s.d} fill={s.fill} opacity={s.opacity} />
      ))
    }
  </svg>

  {/* The mark sails left → right across the whole covered phase. */}
  <div class="gst-wave__sea">
    <div class="gst-wave__boat">
      <div class="gst-wave__bob">
        <svg viewBox="0 0 136 114" focusable="false">
          <g fill="#ffffff">
            <path d="M60 3 C 41 25, 28 50, 24 70 C 34 68, 48 68, 60 69 Z"></path>
            <path d="M68 19 C 82 38, 93 56, 98 70 C 88 68, 78 68, 68 68 Z" opacity=".8"></path>
            <path
              d="M3 66 C 7 85, 24 96, 46 97 C 70 98, 93 90, 109 78 C 113 75, 117 74, 121 75
                 C 119 82, 113 87, 106 91 C 88 100, 62 105, 42 102 C 20 99, 5 85, 3 66 Z"></path>
            <path
              d="M12 88 C 26 102, 50 108, 72 104 C 85 101, 96 96, 105 90
                 C 101 99, 88 106, 72 109 C 46 113, 21 103, 12 88 Z"
              opacity=".5"></path>
            <circle cx="108" cy="81" r="3" fill="#0a2258"></circle>
            <circle cx="127" cy="63" r="4"></circle>
            <circle cx="129" cy="75" r="3"></circle>
            <circle cx="125" cy="85" r="2.2"></circle>
          </g>
        </svg>
      </div>
    </div>
  </div>

  <svg
    class="gst-wave__crest gst-wave__crest--trail"
    viewBox={`0 0 ${VIEW_W} ${VIEW_H}`}
    preserveAspectRatio="none"
    focusable="false"
  >
    {
      swells.map((s) => (
        <path class={`gst-wave__swell gst-wave__swell--${s.cls}`} d={s.d} fill={s.fill} opacity={s.opacity} />
      ))
    }
  </svg>
</div>

<script>
  // ---------------------------------------------------------------------
  // Choreography. Registered once — this module is shared by every page,
  // so the ClientRouter does not re-execute it after a swap.
  // ---------------------------------------------------------------------

  /** Read a duration token from CSS so transitions.css stays authoritative. */
  function token(name: string, fallback: number): number {
    const raw = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    if (raw.endsWith('ms')) return parseFloat(raw);
    if (raw.endsWith('s')) return parseFloat(raw) * 1000;
    return fallback;
  }

  const EASE = 'cubic-bezier(0.76, 0, 0.24, 1)';

  const curtain = () => document.getElementById('gst-wave');
  const boat = () => document.querySelector<HTMLElement>('.gst-wave__boat');

  /** 'idle' → 'rising' → 'covering' → 'leaving' → 'idle' */
  let phase: 'idle' | 'rising' | 'covering' | 'leaving' = 'idle';
  let running: Animation | null = null;
  let rising: Promise<void> | null = null;
  let voyage: Animation | null = null;
  let legs: { rise: number; hold: number; exit: number; x0: number; x1: number; x2: number; x3: number } | null = null;
  let safety = 0;

  /** Split one left → right crossing across the three curtain phases, with
   *  each leg's distance proportional to its duration — so the boat holds a
   *  constant speed instead of changing gear at the phase boundaries. */
  function planVoyage() {
    const rise = token('--gst-wave-rise', 560);
    const hold = token('--gst-wave-hold', 1200);
    const exit = token('--gst-wave-exit', 640);
    const total = rise + hold + exit;
    const span = window.innerWidth * 1.4; // clears the viewport on both sides
    const x0 = -span / 2;
    return {
      rise,
      hold,
      exit,
      x0,
      x1: x0 + span * (rise / total),
      x2: x0 + span * ((rise + hold) / total),
      x3: x0 + span,
    };
  }

  function sail(from: number, to: number, duration: number) {
    const el = boat();
    if (!el) return;
    voyage?.cancel();
    voyage = el.animate(
      [{ transform: `translate3d(${from}px, 0, 0)` }, { transform: `translate3d(${to}px, 0, 0)` }],
      { duration, easing: 'linear', fill: 'forwards' },
    );
  }

  /** Where the boat actually is, so an early exit never snaps it sideways. */
  function boatX() {
    const el = boat();
    if (!el) return 0;
    return new DOMMatrixReadOnly(getComputedStyle(el).transform).m41;
  }

  /** Distance the panel must travel to hide its crests completely. */
  function clearance(el: HTMLElement) {
    return el.getBoundingClientRect().height + 180;
  }

  function play(el: HTMLElement, from: number, to: number, duration: number) {
    running?.cancel();
    running = el.animate(
      [{ transform: `translate3d(0, ${from}px, 0)` }, { transform: `translate3d(0, ${to}px, 0)` }],
      { duration, easing: EASE, fill: 'forwards' },
    );
    return running.finished.catch(() => {});
  }

  /** Bottom of the screen → fully covered. Re-entrant: a second click while
   *  the wave is already up rides the same rise instead of restarting it. */
  function rise(): Promise<void> {
    const el = curtain();
    if (!el) return Promise.resolve();
    if (phase === 'rising') return rising ?? Promise.resolve();
    if (phase === 'covering') return Promise.resolve();

    phase = 'rising';
    const d = clearance(el);
    el.classList.add('is-running');
    requestAnimationFrame(() => el.classList.add('is-covering'));

    // leg 1: the boat enters from the left while the water climbs
    legs = planVoyage();
    sail(legs.x0, legs.x1, legs.rise);

    rising = play(el, d, 0, token('--gst-wave-rise', 560)).then(() => {
      if (phase !== 'rising') return;
      phase = 'covering';
      // Leg 2: the long drift through the centre, on solid blue. Aimed past
      // its waypoint at the same speed — the swap can land a little late, and
      // a boat that keeps gliding beats one that parks mid-screen. Leg 3
      // picks up from wherever it actually got to.
      if (legs) sail(legs.x1, legs.x1 + (legs.x2 - legs.x1) * 1.35, legs.hold * 1.35);
    });
    return rising;
  }

  /** Fully covered → swept off the top. */
  async function fall() {
    const el = curtain();
    if (!el || phase === 'leaving' || phase === 'idle') return;

    phase = 'leaving';
    el.classList.remove('is-covering');

    // leg 3: the boat carries on off the right as the water sweeps up
    if (legs) sail(boatX(), legs.x3, legs.exit);

    await play(el, 0, -clearance(el), token('--gst-wave-exit', 640));
    running?.cancel();
    running = null;
    voyage?.cancel();
    voyage = null;
    legs = null;
    el.classList.remove('is-running');
    el.style.transform = '';
    phase = 'idle';
  }

  /** Replay the surface-in animation on the freshly swapped content. */
  function surface() {
    for (const sel of ['.gst-main', '.gst-header']) {
      const node = document.querySelector(sel);
      if (!node) continue;
      node.classList.remove('is-entering');
      void (node as HTMLElement).offsetWidth; // restart the CSS animation
      node.classList.add('is-entering');
      node.addEventListener('animationend', () => node.classList.remove('is-entering'), { once: true });
    }
  }

  // 1. Raise the curtain while the next document is being fetched. Running
  //    both concurrently means network latency hides inside the animation.
  document.addEventListener('astro:before-preparation', (event) => {
    const e = event as typeof event & { loader: () => Promise<void> };
    const load = e.loader;
    e.loader = async () => {
      await Promise.all([rise(), load()]);
    };
  });

  // 2. The DOM has been swapped behind the wave — hold a beat, then sweep off.
  document.addEventListener('astro:after-swap', () => {
    surface();
    if (phase === 'idle') return;
    window.clearTimeout(safety);
    window.setTimeout(fall, token('--gst-wave-hold', 1200));
  });

  // 3. Safety net: if a navigation is aborted or a load fails, never leave
  //    the visitor staring at a blue rectangle.
  document.addEventListener('astro:page-load', () => {
    window.clearTimeout(safety);
    safety = window.setTimeout(() => {
      if (phase !== 'idle') fall();
    }, 3000);
  });
</script>
