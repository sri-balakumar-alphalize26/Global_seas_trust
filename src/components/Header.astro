---
import { company, navLinks } from '../data/site';
import { localePath, otherLangPath, t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const L = t(lang);

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => (href.replace(/\/+$/, '') || '/') === currentPath;

// Same page in the other language — the toggle keeps the visitor in place.
const switchHref = otherLangPath(Astro.url.pathname, lang);
const name = lang === 'ar' ? company.nameAr : company.name;
const tagline = lang === 'ar' ? company.taglineAr : company.tagline;
---

<header class="site-header gst-header">
  <div class="container header-inner gst-header__inner">
    <a href={localePath('/', lang)} class="logo" aria-label={`${name} — ${L.header.homeAria}`}>
      <img src="/gst-logo.webp" alt={`${name} ${L.header.logoAlt}`} class="logo-img" width="80" height="64" />
      <span class="logo-text">
        <strong>{name}</strong>
        <small>{tagline}</small>
      </span>
    </a>

    <nav class="main-nav" aria-label={L.header.mainNav}>
      <input type="checkbox" id="nav-toggle" class="nav-toggle-input" />
      <label for="nav-toggle" class="nav-toggle" aria-label={L.header.toggleMenu}>
        <span></span><span></span><span></span>
      </label>
      <ul class="nav-list">
        {
          navLinks.map((link) => {
            const href = localePath(link.href, lang);
            return (
              <li>
                <a href={href} class:list={{ active: isActive(href) }}>
                  {L.nav[link.key]}
                </a>
              </li>
            );
          })
        }
        <li class="nav-lang">
          <a href={switchHref} class="lang-btn" aria-label={L.header.switchLangAria} lang={lang === 'ar' ? 'en' : 'ar'}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18Z"></path>
            </svg>
            {L.header.switchLang}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(8px);
    box-shadow: 0 1px 0 rgba(10, 34, 88, 0.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.7rem;
    padding-bottom: 0.7rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .logo-img {
    /* transparent PNG — sits straight on the header, no chip behind it */
    height: 64px;
    width: auto;
    object-fit: contain;
    flex-shrink: 0;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .logo-text strong {
    font-size: 1.15rem;
    color: var(--navy-900);
    letter-spacing: 0.01em;
  }

  .logo-text small {
    font-size: 0.68rem;
    color: var(--text-400);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .nav-list {
    display: flex;
    gap: 0.4rem;
    list-style: none;
  }

  .nav-list a {
    display: block;
    padding: 0.5rem 0.9rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--text-600);
    transition: color 0.15s ease, background 0.15s ease;
  }

  .nav-list a:hover {
    color: var(--blue-600);
    background: var(--aqua-100);
  }

  .nav-list a.active {
    color: var(--blue-600);
  }

  /* language toggle */
  .nav-lang {
    margin-inline-start: 0.35rem;
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1.5px solid var(--aqua-100);
    border-radius: 999px;
    padding: 0.4rem 0.9rem !important;
    font-weight: 700;
    color: var(--navy-900) !important;
  }

  .lang-btn svg {
    width: 16px;
    height: 16px;
    color: var(--blue-500);
    flex-shrink: 0;
  }

  .lang-btn:hover {
    border-color: var(--blue-400);
    background: var(--aqua-100) !important;
  }

  .nav-toggle-input,
  .nav-toggle {
    display: none;
  }

  @media (max-width: 820px) {
    .nav-toggle {
      display: flex;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 0.5rem;
    }

    .nav-toggle span {
      width: 24px;
      height: 2.5px;
      background: var(--navy-800);
      border-radius: 2px;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .nav-list {
      display: none;
      position: absolute;
      top: 100%;
      inset-inline: 0;
      flex-direction: column;
      background: var(--white);
      padding: 0.75rem 1.25rem 1.25rem;
      box-shadow: var(--shadow-md);
    }

    .nav-toggle-input:checked ~ .nav-list {
      display: flex;
    }

    .nav-lang {
      margin-inline-start: 0;
      margin-top: 0.4rem;
    }

    .lang-btn {
      justify-content: center;
    }

    .nav-toggle-input:checked ~ .nav-toggle span:nth-child(1) {
      transform: translateY(7.5px) rotate(45deg);
    }

    .nav-toggle-input:checked ~ .nav-toggle span:nth-child(2) {
      opacity: 0;
    }

    .nav-toggle-input:checked ~ .nav-toggle span:nth-child(3) {
      transform: translateY(-7.5px) rotate(-45deg);
    }
  }
</style>
