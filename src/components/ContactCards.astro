---
/**
 * ContactCards.astro — the four contact tiles.
 *
 * Each tile does something when tapped:
 *   Visit Us      → Google Maps (deep-links into the app on mobile)
 *   Call Us       → tel: dialer
 *   Email Us      → Gmail compose on desktop, the device mail app on mobile
 *   Working Hours → a modal with the full week, today highlighted, plus a
 *                   live open/closed status computed in the BUSINESS timezone
 *
 * Entrance: tiles stagger in and their icon chips pop. Re-seeds on
 * astro:page-load so it replays after a ClientRouter navigation.
 *
 * Site adaptation: reduced-motion opt-out removed per the site-wide
 * always-animate decision (see transitions.css note).
 */

interface Hour {
  /** 0 = Sunday … 6 = Saturday */
  dow: number;
  label: string;
  /** 24h "HH:MM"; omit both for a closed day */
  open?: string;
  close?: string;
}

import { company } from '../data/site';
import { t, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
  /** visually-hidden section heading — keeps the page outline h1 → h2 → h3 for search engines */
  heading?: string;
  addressLines?: string[];
  /** what Google Maps should search for; defaults to the address lines joined */
  mapQuery?: string;
  /** direct Google Maps link (share URL) — wins over `mapQuery` when set */
  mapsUrl?: string;
  /** Commercial Registration number, shown under the address */
  crNumber?: string;
  phone?: string;
  email?: string;
  emailSubject?: string;
  hoursSummary?: string;
  /** IANA zone the business actually operates in — not the visitor's */
  timeZone?: string;
  timeZoneLabel?: string;
  hours?: Hour[];
}

const { lang = 'en' } = Astro.props;
const L = t(lang);

const {
  heading = L.cards.heading,
  addressLines = lang === 'ar' ? company.addressLinesAr : company.addressLines,
  mapQuery,
  mapsUrl: mapsUrlProp = company.mapsUrl,
  crNumber = company.crNumber,
  phone = company.phone,
  /** Second line, shown beneath the first — the card itself dials `phone`. */
  phoneAlt = company.phoneAlt,
  email = company.email,
  /** Sales desk, shown beneath the general address — the card itself composes to `email`. */
  emailSales = company.emailSales,
  emailSubject = L.contact.emailSubject(lang === 'ar' ? company.nameAr : company.name),
  hoursSummary = lang === 'ar' ? L.cards.hoursSummary : company.hours,
  timeZone = 'Asia/Muscat',
  timeZoneLabel = L.cards.tzLabel,
  hours = [
    { dow: 0, label: L.cards.days[0], open: '08:00', close: '17:00' },
    { dow: 1, label: L.cards.days[1], open: '08:00', close: '17:00' },
    { dow: 2, label: L.cards.days[2], open: '08:00', close: '17:00' },
    { dow: 3, label: L.cards.days[3], open: '08:00', close: '17:00' },
    { dow: 4, label: L.cards.days[4], open: '08:00', close: '17:00' },
    { dow: 5, label: L.cards.days[5] },
    { dow: 6, label: L.cards.days[6] },
  ],
} = Astro.props;

/** Strings the client script needs (status line, AM/PM, today/tomorrow). */
const i18nPayload = JSON.stringify({
  am: L.cards.am,
  pm: L.cards.pm,
  today: L.cards.today,
  tomorrow: L.cards.tomorrow,
  closed: L.cards.closed,
  openNow: L.cards.openNowTpl,
  closedUntil: L.cards.closedUntilTpl,
});

const query = mapQuery ?? addressLines.join(' ').replace(/,\s*$/, '');
const mapsUrl = mapsUrlProp ?? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
const telHref = `tel:${phone.replace(/[^\d+]/g, '')}`;
const mailtoHref = `mailto:${email}?subject=${encodeURIComponent(emailSubject)}`;

/** "08:00" → "8:00 AM" */
const pretty = (t?: string) => {
  if (!t) return '';
  const [h, m] = t.split(':').map(Number);
  const suffix = h >= 12 ? 'PM' : 'AM';
  return `${((h + 11) % 12) + 1}:${String(m).padStart(2, '0')} ${suffix === 'PM' ? L.cards.pm : L.cards.am}`;
};

const payload = JSON.stringify({ timeZone, hours });

/**
 * A business that never closes needs no week table and no live open/closed
 * badge — every row would read the same and the status would never change.
 * Detected from the company data (all seven days spanning the full clock) so
 * the interactive version comes back on its own if hours ever get specific.
 */
const alwaysOpen =
  company.openingHours.days.length === 7 &&
  company.openingHours.opens === '00:00' &&
  company.openingHours.closes === '23:59';
---

<section
  class="cc"
  data-hours={payload}
  data-tz-label={timeZoneLabel}
  data-i18n={i18nPayload}
  style={`--cc-today: ' · ${L.cards.today}'`}
>
  <div class="cc__inner">
    <h2 class="cc__title">{heading}</h2>
    <div class="cc__grid">
      <!-- Visit Us -------------------------------------------------------- -->
      <a
        class="cc__card"
        style="--i:0"
        href={mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={L.common.openInMapsAria(query)}
      >
        <span class="cc__chip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 21.5s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z" fill="currentColor" stroke="none" />
            <circle cx="12" cy="10.2" r="2.5" fill="#fff" />
          </svg>
        </span>
        <h3>{L.cards.visitUs}</h3>
        {addressLines.map((l) => <p>{l}</p>)}
        {crNumber && <p>{L.common.crNo(crNumber)}</p>}
        <span class="cc__hint">{L.common.openInMaps}</span>
      </a>

      <!-- Call Us --------------------------------------------------------- -->
      <a class="cc__card" style="--i:1" href={telHref} aria-label={L.cards.callAria(phone)}>
        <span class="cc__chip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path
              d="M6.5 3h3l1.5 4-2 1.4a12.5 12.5 0 0 0 6.6 6.6L17 13l4 1.5v3a2 2 0 0 1-2.2 2A17.5 17.5 0 0 1 3.5 5.2 2 2 0 0 1 5.5 3Z"
              fill="currentColor"
              stroke="none"></path>
          </svg>
        </span>
        <h3>{L.cards.callUs}</h3>
        <p dir="ltr">{phone}</p>
        {phoneAlt && <p class="cc__alt" dir="ltr">{phoneAlt}</p>}
        <span class="cc__hint">{L.cards.tapToCall}</span>
      </a>

      <!-- Email Us -------------------------------------------------------- -->
      <a
        class="cc__card cc__card--mail"
        style="--i:2"
        href={mailtoHref}
        data-email={email}
        data-subject={emailSubject}
        aria-label={L.cards.emailAria(email)}
        aria-haspopup="dialog"
      >
        <span class="cc__chip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2.5" y="5" width="19" height="14" rx="2.4" fill="currentColor" stroke="none" />
            <path d="m4.6 7.6 7.4 5.3 7.4-5.3" stroke="#fff" stroke-width="1.9" fill="none" />
          </svg>
        </span>
        <h3>{L.cards.emailUs}</h3>
        <p class="cc__mail" dir="ltr">{email}</p>
        {emailSales && <p class="cc__mail cc__alt" dir="ltr">{emailSales}</p>}
        <span class="cc__hint">{L.cards.composeGmail}</span>
      </a>

      <!-- Working Hours --------------------------------------------------- -->
      {
        alwaysOpen ? (
          <div class="cc__card cc__card--static" style="--i:3">
            <span class="cc__chip">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7.2V12l3.2 2" />
              </svg>
            </span>
            <h3>{L.cards.workingHours}</h3>
            <p>{hoursSummary}</p>
            <span class="cc__tz">{timeZoneLabel}</span>
          </div>
        ) : (
          <button class="cc__card" style="--i:3" type="button" data-hours-open aria-haspopup="dialog">
            <span class="cc__chip">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7.2V12l3.2 2" />
              </svg>
            </span>
            <h3>{L.cards.workingHours}</h3>
            <p>{hoursSummary}</p>
            <span class="cc__hint">{L.cards.seeWeek}</span>
          </button>
        )
      }
    </div>
  </div>

  {/* Week table — only for a business with specific hours. Kept intact so it
      returns automatically if company.openingHours stops being 24/7. */}
  {!alwaysOpen && (
  <dialog class="cc__dialog" aria-labelledby="cc-hours-title">
    <div class="cc__sheet">
      <header class="cc__sheet-head">
        <span class="cc__chip cc__chip--solid">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7.2V12l3.2 2" />
          </svg>
        </span>
        <div>
          <h3 id="cc-hours-title">{L.cards.workingHours}</h3>
          <p>{timeZoneLabel}</p>
        </div>
        <button class="cc__x" type="button" data-hours-close aria-label={L.cards.close}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18" />
          </svg>
        </button>
      </header>

      <p class="cc__status" data-hours-status hidden></p>

      <ul class="cc__rows">
        {
          hours.map((d, i) => (
            <li class="cc__row" style={`--r:${i}`} data-dow={d.dow}>
              <span>{d.label}</span>
              <b class:list={{ 'is-closed': !d.open }}>
                {d.open ? `${pretty(d.open)} – ${pretty(d.close)}` : L.cards.closed}
              </b>
            </li>
          ))
        }
      </ul>
    </div>
  </dialog>
  )}

  <!-- --------------------------------------------------- address chooser -->
  {/* Two addresses are published, so the card asks which one rather than
      silently composing to the general desk. */}
  <dialog class="cc__dialog cc__dialog--mail" aria-labelledby="cc-mail-title">
    <div class="cc__sheet">
      <header class="cc__sheet-head">
        <span class="cc__chip cc__chip--solid">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2.5" y="5" width="19" height="14" rx="2.4" />
            <path d="m4.6 7.6 7.4 5.3 7.4-5.3" />
          </svg>
        </span>
        <div>
          <h3 id="cc-mail-title">{L.cards.mailChooseTitle}</h3>
          <p>{L.cards.emailUs}</p>
        </div>
        <button class="cc__x" type="button" data-mail-close aria-label={L.cards.close}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18" />
          </svg>
        </button>
      </header>

      <ul class="cc__picks">
        <li>
          <button type="button" data-mail-to={email}>
            <strong>{L.cards.mailGeneral}</strong>
            <span dir="ltr">{email}</span>
          </button>
        </li>
        {emailSales && (
          <li>
            <button type="button" data-mail-to={emailSales}>
              <strong>{L.cards.mailSales}</strong>
              <span dir="ltr">{emailSales}</span>
            </button>
          </li>
        )}
        {emailSales && (
          <li>
            <button type="button" data-mail-to={`${email},${emailSales}`}>
              <strong>{L.cards.mailBoth}</strong>
              <span>{L.cards.mailBothHint}</span>
            </button>
          </li>
        )}
      </ul>

      <footer class="cc__sheet-foot">
        <button class="cc__cancel" type="button" data-mail-close>{L.cards.mailCancel}</button>
      </footer>
    </div>
  </dialog>
</section>

<style>
  .cc {
    --cc-ink: #0a2258;
    --cc-body: #46596b;
    --cc-brand: #1447c0;
    --cc-brand-bright: #1a5bd7;
    --cc-soft: #e8f0fd;
    --cc-line: #e8f0fd;
    --cc-step: 90ms;
    --cc-ease: cubic-bezier(0.22, 1, 0.36, 1);

    padding-block: 56px 8px;
    background: #fff;
  }

  .cc__inner {
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 28px;
  }

  /* present for crawlers and screen readers, invisible on screen */
  .cc__title {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .cc__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .cc__card {
    /* it is a button in one case and an anchor in three — normalise both */
    appearance: none;
    font: inherit;
    text-align: center;
    display: block;
    width: 100%;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;

    background: #fff;
    border: 1px solid var(--cc-line);
    border-radius: 10px;
    padding: 26px 22px 22px;
    box-shadow: 0 1px 2px rgba(10, 34, 88, 0.03);
    transition:
      transform 380ms var(--cc-ease),
      box-shadow 380ms var(--cc-ease),
      border-color 380ms var(--cc-ease);
  }

  .cc__card:hover {
    transform: translateY(-5px);
    border-color: #cfe0fb;
    box-shadow: 0 18px 40px rgba(10, 34, 88, 0.1);
  }

  /* the tap itself gets a press, so a thumb sees the hit register */
  .cc__card:active {
    transform: translateY(-1px) scale(0.985);
    transition-duration: 90ms;
  }

  .cc__card:focus-visible {
    outline: 3px solid rgba(26, 91, 215, 0.4);
    outline-offset: 3px;
  }

  .cc__chip {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: 0 auto 16px;
    border-radius: 50%;
    background: var(--cc-soft);
    color: var(--cc-brand);
    transition:
      background-color 340ms var(--cc-ease),
      color 340ms var(--cc-ease),
      transform 600ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .cc__chip svg {
    width: 21px;
    height: 21px;
  }

  .cc__card:hover .cc__chip {
    background: var(--cc-brand-bright);
    color: #fff;
    transform: scale(1.08);
  }

  .cc__chip--solid {
    background: var(--cc-brand-bright);
    color: #fff;
    margin: 0;
    flex: none;
  }

  .cc__card h3 {
    margin: 0 0 8px;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--cc-ink);
  }

  .cc__card p {
    margin: 0;
    font-size: 0.8438rem;
    line-height: 1.6;
    color: var(--cc-body);
  }

  .cc__mail {
    color: var(--cc-brand-bright);
    word-break: break-word;
  }

  /* Second contact line — the alternate phone and the sales address. Present
     but secondary to the one the card itself dials or composes to. */
  .cc__alt {
    margin-top: 2px;
    opacity: 0.78;
    font-size: 0.92em;
  }

  /* the affordance only shows once you are actually pointing at the card */
  .cc__hint {
    display: block;
    margin-top: 12px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--cc-brand-bright);
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 300ms var(--cc-ease),
      transform 300ms var(--cc-ease);
  }

  .cc__card:hover .cc__hint,
  .cc__card:focus-visible .cc__hint {
    opacity: 1;
    transform: none;
  }

  /* ------------------------------------------------------------- dialog -- */

  .cc__dialog {
    /* the global `* { margin: 0 }` reset kills the UA's dialog centering —
       restore it explicitly so the sheet opens dead-centre */
    position: fixed;
    inset: 0;
    margin: auto;
    height: fit-content;

    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(440px, calc(100vw - 32px));
    width: 100%;
    color: inherit;
    overflow: visible;
  }

  .cc__dialog::backdrop {
    background: rgba(6, 20, 52, 0.45);
    backdrop-filter: blur(2px);
    opacity: 0;
  }

  .cc__dialog[open]::backdrop {
    animation: ccFade 260ms var(--cc-ease) forwards;
  }

  .cc__dialog.is-closing::backdrop {
    animation: ccFade 200ms ease forwards reverse;
  }

  .cc__sheet {
    background: #fff;
    border-radius: 16px;
    padding: 24px 24px 20px;
    box-shadow: 0 30px 70px rgba(6, 20, 52, 0.3);
  }

  /* 24/7: the card states the hours rather than opening a week table, so it
     gets no hover affordance and no pointer cursor. */
  .cc__card--static {
    cursor: default;
  }

  .cc__tz {
    display: block;
    margin-top: 10px;
    font-size: 0.82rem;
    color: var(--cc-ink);
    opacity: 0.6;
  }

  /* ---- address chooser ---- */
  .cc__picks {
    list-style: none;
    display: grid;
    gap: 8px;
    margin: 4px 0 14px;
    padding: 0;
  }

  .cc__picks button {
    display: grid;
    gap: 2px;
    width: 100%;
    padding: 12px 14px;
    text-align: start;
    border: 1.5px solid var(--cc-line);
    border-radius: 12px;
    background: #fff;
    color: inherit;
    cursor: pointer;
    transition:
      border-color 0.18s ease,
      background 0.18s ease,
      transform 0.18s ease;
  }

  .cc__picks button:hover,
  .cc__picks button:focus-visible {
    border-color: var(--cc-brand-bright);
    background: var(--cc-soft);
    transform: translateY(-1px);
  }

  .cc__picks strong {
    font-size: 0.95rem;
    color: var(--cc-ink);
  }

  .cc__picks span {
    font-size: 0.82rem;
    color: var(--cc-brand-bright);
    word-break: break-word;
  }

  .cc__cancel {
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    color: var(--cc-ink);
    opacity: 0.7;
    cursor: pointer;
    text-decoration: underline;
  }

  .cc__cancel:hover {
    opacity: 1;
  }

  .cc__dialog[open] .cc__sheet {
    animation: ccSheetIn 380ms var(--cc-ease) both;
  }

  .cc__dialog.is-closing .cc__sheet {
    animation: ccSheetOut 200ms ease both;
  }

  @keyframes ccFade {
    to {
      opacity: 1;
    }
  }

  @keyframes ccSheetIn {
    from {
      opacity: 0;
      transform: translateY(22px) scale(0.94);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes ccSheetOut {
    to {
      opacity: 0;
      transform: translateY(10px) scale(0.97);
    }
  }

  .cc__sheet-head {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--cc-line);
  }

  .cc__sheet-head h3 {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--cc-ink);
  }

  .cc__sheet-head p {
    margin: 2px 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--cc-body);
  }

  .cc__sheet-head div {
    flex: 1;
  }

  .cc__x {
    appearance: none;
    border: 0;
    background: var(--cc-soft);
    color: var(--cc-ink);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    cursor: pointer;
    flex: none;
    transition: background-color 220ms ease;
  }

  .cc__x:hover {
    background: #d9e6fb;
  }

  .cc__x svg {
    width: 15px;
    height: 15px;
  }

  .cc__status {
    margin: 16px 0 4px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .cc__status::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 0 currentColor;
    animation: ccPing 2.2s ease-out infinite;
  }

  .cc__status[data-open='yes'] {
    background: #e6f7ee;
    color: #0f7a48;
  }

  .cc__status[data-open='no'] {
    background: #fdeceb;
    color: #b23b32;
  }

  @keyframes ccPing {
    0% {
      box-shadow: 0 0 0 0 currentColor;
      opacity: 1;
    }
    70% {
      box-shadow: 0 0 0 7px transparent;
      opacity: 0.85;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
      opacity: 1;
    }
  }

  .cc__rows {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
  }

  .cc__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 12px;
    border-radius: 8px;
    font-size: 0.9063rem;
    color: var(--cc-body);
  }

  .cc__row b {
    font-weight: 600;
    color: var(--cc-ink);
    font-variant-numeric: tabular-nums;
  }

  .cc__row b.is-closed {
    color: #9aa7b8;
    font-weight: 500;
  }

  .cc__row.is-today {
    background: var(--cc-soft);
  }

  .cc__row.is-today span {
    color: var(--cc-brand);
    font-weight: 700;
  }

  .cc__row.is-today span::after {
    content: var(--cc-today, ' · today');
    font-weight: 600;
    opacity: 0.65;
  }

  .cc__dialog[open] .cc__row {
    animation: ccRow 420ms var(--cc-ease) both;
    animation-delay: calc(140ms + var(--r) * 45ms);
  }

  @keyframes ccRow {
    from {
      opacity: 0;
      transform: translateX(-10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .cc__sheet-foot {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--cc-line);
    font-size: 0.75rem;
    line-height: 1.6;
    color: #8494a8;
  }

  /* ------------------------------------------------------ entrance state */

  :global(html.cc-ready) .cc__card {
    opacity: 0;
    transform: translate3d(0, 22px, 0);
  }

  :global(html.cc-ready) .cc__card .cc__chip {
    transform: scale(0.6);
    opacity: 0;
  }

  .cc.is-in .cc__card {
    opacity: 1;
    transform: none;
    transition:
      opacity 640ms var(--cc-ease) calc(var(--i) * var(--cc-step)),
      transform 640ms var(--cc-ease) calc(var(--i) * var(--cc-step)),
      box-shadow 380ms var(--cc-ease),
      border-color 380ms var(--cc-ease);
  }

  .cc.is-in .cc__card .cc__chip {
    opacity: 1;
    transform: none;
    transition:
      opacity 380ms var(--cc-ease) calc(120ms + var(--i) * var(--cc-step)),
      transform 640ms cubic-bezier(0.34, 1.56, 0.64, 1) calc(120ms + var(--i) * var(--cc-step)),
      background-color 340ms var(--cc-ease),
      color 340ms var(--cc-ease);
  }

  /* ---------------------------------------------------------- responsive */

  @media (max-width: 1024px) {
    .cc__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .cc__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    /* on a touch device the hint is the only affordance, so keep it visible */
    .cc__hint {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  type Hour = { dow: number; label: string; open?: string; close?: string };
  /** Locale strings rendered into data-i18n by the component. */
  type I18n = {
    am: string;
    pm: string;
    today: string;
    tomorrow: string;
    closed: string;
    openNow: string; // "… {time}"
    closedUntil: string; // "… {when} … {time}"
  };

  const EN: I18n = {
    am: 'AM',
    pm: 'PM',
    today: 'today',
    tomorrow: 'tomorrow',
    closed: 'Closed',
    openNow: 'Open now · closes at {time}',
    closedUntil: 'Closed · opens {when} at {time}',
  };

  const fill = (tpl: string, vars: Record<string, string>) =>
    tpl.replace(/\{(\w+)\}/g, (_, k: string) => vars[k] ?? '');

  let io: IntersectionObserver | null = null;

  const toMin = (t: string) => {
    const [h, m] = t.split(':').map(Number);
    return h * 60 + m;
  };

  const pretty = (t: string, i18n: I18n) => {
    const [h, m] = t.split(':').map(Number);
    return `${((h + 11) % 12) + 1}:${String(m).padStart(2, '0')} ${h >= 12 ? i18n.pm : i18n.am}`;
  };

  /** Today, in the BUSINESS timezone — not the visitor's. */
  function localNow(timeZone: string) {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone,
      weekday: 'short',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    }).formatToParts(new Date());
    const get = (t: string) => parts.find((p) => p.type === t)?.value ?? '';
    const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    return {
      dow: Math.max(0, days.indexOf(get('weekday'))),
      minutes: (Number(get('hour')) % 24) * 60 + Number(get('minute')),
    };
  }

  function describe(hours: Hour[], timeZone: string, i18n: I18n) {
    const now = localNow(timeZone);
    const byDow = new Map(hours.map((h) => [h.dow, h]));
    const today = byDow.get(now.dow);

    if (today?.open && today.close) {
      const from = toMin(today.open);
      const to = toMin(today.close);
      if (now.minutes >= from && now.minutes < to) {
        return { dow: now.dow, open: true, text: fill(i18n.openNow, { time: pretty(today.close, i18n) }) };
      }
    }

    // walk forward to the next day that has hours
    for (let step = 0; step < 8; step++) {
      const dow = (now.dow + step) % 7;
      const day = byDow.get(dow);
      if (!day?.open) continue;
      if (step === 0 && now.minutes >= toMin(day.open)) continue; // already past today's opening
      const when = step === 0 ? i18n.today : step === 1 ? i18n.tomorrow : day.label;
      return { dow: now.dow, open: false, text: fill(i18n.closedUntil, { when, time: pretty(day.open, i18n) }) };
    }
    return { dow: now.dow, open: false, text: i18n.closed };
  }

  function wire(section: HTMLElement) {
    wireHours(section);
    wireMail(section);
  }

  /** Week table + live status. Absent when the business never closes. */
  function wireHours(section: HTMLElement) {
    // `:not(--mail)` matters — the address chooser shares the .cc__dialog class
    const dialog = section.querySelector<HTMLDialogElement>('.cc__dialog:not(.cc__dialog--mail)');
    const openBtn = section.querySelector<HTMLButtonElement>('[data-hours-open]');
    if (!dialog || !openBtn) return;

    const config = JSON.parse(section.dataset.hours ?? '{}') as { timeZone: string; hours: Hour[] };
    const i18n: I18n = { ...EN, ...(JSON.parse(section.dataset.i18n ?? '{}') as Partial<I18n>) };

    const refresh = () => {
      const state = describe(config.hours, config.timeZone, i18n);
      const status = dialog.querySelector<HTMLElement>('[data-hours-status]');
      if (status) {
        status.textContent = state.text;
        status.dataset.open = state.open ? 'yes' : 'no';
        status.hidden = false;
      }
      dialog.querySelectorAll<HTMLElement>('.cc__row').forEach((row) => {
        row.classList.toggle('is-today', Number(row.dataset.dow) === state.dow);
      });
    };

    const open = () => {
      refresh();
      dialog.showModal();
    };

    // animate out before the element is actually removed from the top layer
    const close = () => {
      if (dialog.classList.contains('is-closing')) return;
      dialog.classList.add('is-closing');
      const done = (e: AnimationEvent) => {
        if (e.target !== dialog.querySelector('.cc__sheet')) return;
        dialog.removeEventListener('animationend', done);
        dialog.classList.remove('is-closing');
        dialog.close();
      };
      dialog.addEventListener('animationend', done);
    };

    openBtn.addEventListener('click', open);
    dialog.querySelector('[data-hours-close]')?.addEventListener('click', close);

    // Esc: let the browser start it, but play the exit first
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });

    // click on the backdrop (the dialog box itself, outside the sheet)
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });

  }

  /**
   * Two addresses are published, so always ask which one rather than composing
   * straight to the general desk. The <a href="mailto:"> stays as the no-JS
   * fallback. Wired separately from the hours dialog so it keeps working when
   * that one isn't rendered at all.
   */
  function wireMail(section: HTMLElement) {
    const mail = section.querySelector<HTMLAnchorElement>('.cc__card--mail');
    const mailDialog = section.querySelector<HTMLDialogElement>('.cc__dialog--mail');

    if (mail && mailDialog) {
      const closeMail = () => {
        if (mailDialog.classList.contains('is-closing')) return;
        mailDialog.classList.add('is-closing');
        const done = (e: AnimationEvent) => {
          if (e.target !== mailDialog.querySelector('.cc__sheet')) return;
          mailDialog.removeEventListener('animationend', done);
          mailDialog.classList.remove('is-closing');
          mailDialog.close();
          mail.focus();
        };
        mailDialog.addEventListener('animationend', done);
      };

      /** Gmail compose on a fine pointer, the device's mail app on touch. */
      const compose = (to: string) => {
        const su = encodeURIComponent(mail.dataset.subject ?? '');
        if (window.matchMedia('(pointer: coarse)').matches) {
          window.location.href = `mailto:${to}?subject=${su}`;
        } else {
          window.open(`https://mail.google.com/mail/?view=cm&fs=1&to=${to}&su=${su}`, '_blank', 'noopener');
        }
      };

      mail.addEventListener('click', (e) => {
        e.preventDefault();
        mailDialog.showModal();
      });

      mailDialog.querySelectorAll<HTMLButtonElement>('[data-mail-to]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const to = btn.dataset.mailTo ?? '';
          closeMail();
          compose(to);
        });
      });

      mailDialog.querySelectorAll<HTMLButtonElement>('[data-mail-close]').forEach((btn) => {
        btn.addEventListener('click', closeMail);
      });

      mailDialog.addEventListener('click', (e) => {
        if (e.target === mailDialog) closeMail();
      });

      mailDialog.addEventListener('cancel', (e) => {
        e.preventDefault();
        closeMail();
      });
    }
  }

  function seed() {
    const sections = document.querySelectorAll<HTMLElement>('.cc');
    if (!sections.length) return;

    document.documentElement.classList.add('cc-ready');
    io?.disconnect();

    for (const s of sections) {
      s.classList.remove('is-in');
      wire(s);
    }

    io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-in');
          io?.unobserve(e.target);
        }
      },
      { threshold: 0.2 },
    );

    for (const s of sections) io.observe(s);
  }

  document.addEventListener('astro:page-load', seed);
</script>
