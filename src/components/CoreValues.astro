---
/**
 * CoreValues.astro — "Our Core Values" grid.
 *
 * Entrance: the cards arrive as a diagonal ripple across the grid rather than
 * a plain left-to-right stagger — delay is driven by (row + column), so the
 * motion travels from the top-left corner outward. Each icon chip then pops
 * with a slight overshoot and sends one soft ring outward.
 *
 * Re-seeds on astro:page-load, so it replays after a ClientRouter navigation.
 *
 * Site adaptation: reduced-motion opt-out removed per the site-wide
 * always-animate decision (see transitions.css note). Default values are the
 * official company copy, verbatim.
 */

type Icon = 'shield' | 'fish' | 'trust' | 'droplet' | 'anchor' | 'globe';

interface Value {
  title: string;
  body: string;
  icon: Icon;
}

interface Props {
  eyebrow?: string;
  title?: string;
  /** columns at the widest breakpoint — drives the diagonal ripple order */
  cols?: number;
  values?: Value[];
}

const {
  eyebrow = 'What Guides Us',
  title = 'Our Core Values',
  cols = 3,
  values = [
    { title: 'Quality', icon: 'shield', body: 'We maintain high standards throughout sourcing, processing, packaging, storage, and delivery.' },
    { title: 'Freshness', icon: 'fish', body: 'We protect the natural quality and freshness of seafood through careful handling and an efficient cold chain.' },
    { title: 'Trust', icon: 'trust', body: 'We believe long-term business relationships are built on transparency, consistency, and keeping our commitments.' },
    { title: 'Food Safety', icon: 'droplet', body: 'We prioritize hygiene, quality control, and safe handling throughout our operations.' },
    { title: 'Reliability', icon: 'anchor', body: 'Our customers can depend on consistent products, professional service, and dependable international supply.' },
    { title: 'Global Reach', icon: 'globe', body: 'We aim to connect quality seafood with customers and markets across the world.' },
  ],
} = Astro.props;

/** diagonal wave: everything on the same anti-diagonal lands together */
const ripple = (i: number) => Math.floor(i / cols) + (i % cols);
---

<section class="cv">
  <div class="cv__inner">
    <p class="cv__eyebrow">{eyebrow}</p>
    <h2 class="cv__title">{title}</h2>

    <div class="cv__grid" style={`--cols:${cols}`}>
      {
        values.map((v, i) => (
          <article class="cv__card" style={`--i:${ripple(i)}`}>
            <span class="cv__chip">
              <span class="cv__ring" aria-hidden="true" />
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {v.icon === 'shield' && (
                  <>
                    <path d="M12 2.5 4.5 6v6c0 4.7 3.2 8.3 7.5 9.5 4.3-1.2 7.5-4.8 7.5-9.5V6Z" fill="currentColor" stroke="none" />
                    <path d="m8.6 12 2.4 2.4 4.4-4.6" stroke="#fff" stroke-width="2.1" />
                  </>
                )}
                {v.icon === 'fish' && (
                  <>
                    <path d="M2.5 12c3-4.2 6.6-6.3 10.8-6.3 4 0 7 2.1 8.2 6.3-1.2 4.2-4.2 6.3-8.2 6.3-4.2 0-7.8-2.1-10.8-6.3Z" fill="currentColor" stroke="none" />
                    <circle cx="16.6" cy="10.4" r="1.15" fill="#fff" />
                  </>
                )}
                {v.icon === 'trust' && (
                  <>
                    <circle cx="9" cy="8.4" r="3" fill="currentColor" stroke="none" />
                    <path d="M2.9 19.4a6.1 6.1 0 0 1 12.2 0Z" fill="currentColor" stroke="none" />
                    <circle cx="17.4" cy="9.4" r="2.3" fill="currentColor" stroke="none" />
                    <path d="M15.6 19.4a5 5 0 0 1 6.5-4.8v4.8Z" fill="currentColor" stroke="none" />
                  </>
                )}
                {v.icon === 'droplet' && (
                  <path d="M12 2.6c3.4 4 5.6 7 5.6 9.7A5.6 5.6 0 0 1 12 18a5.6 5.6 0 0 1-5.6-5.7c0-2.7 2.2-5.7 5.6-9.7Z" fill="currentColor" stroke="none" />
                )}
                {v.icon === 'anchor' && (
                  <>
                    <circle cx="12" cy="5" r="2.4" />
                    <line x1="12" y1="7.4" x2="12" y2="21" />
                    <line x1="7" y1="11" x2="17" y2="11" />
                    <path d="M4 15a8 8 0 0 0 16 0" />
                  </>
                )}
                {v.icon === 'globe' && (
                  <>
                    <circle cx="12" cy="12" r="9" />
                    <line x1="3" y1="12" x2="21" y2="12" />
                    <path d="M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18Z" />
                  </>
                )}
              </svg>
            </span>

            <h3>{v.title}</h3>
            <p>{v.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cv {
    --cv-bg: #f6f8fd;
    --cv-ink: #0a2258;
    --cv-body: #46596b;
    --cv-brand: #1447c0;
    --cv-brand-soft: #e8f0fd;
    --cv-eyebrow: #1a5bd7;
    --cv-step: 95ms; /* delay per diagonal band */
    --cv-dur: 700ms;
    --cv-ease: cubic-bezier(0.22, 1, 0.36, 1);

    padding-block: 88px;
    background: var(--cv-bg);
  }

  .cv__inner {
    width: 100%;
    max-width: 1240px;
    margin-inline: auto;
    padding-inline: 28px;
    text-align: center;
  }

  .cv__eyebrow {
    margin: 0 0 14px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--cv-eyebrow);
  }

  .cv__title {
    margin: 0 0 52px;
    font-size: clamp(1.9rem, 3.4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.14;
    color: var(--cv-ink);
  }

  .cv__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 24px;
  }

  .cv__card {
    background: #fff;
    border-radius: 10px;
    padding: 38px 30px 34px;
    box-shadow: 0 1px 2px rgba(10, 34, 88, 0.04), 0 8px 24px rgba(10, 34, 88, 0.05);
    transition:
      transform 420ms var(--cv-ease),
      box-shadow 420ms var(--cv-ease);
  }

  .cv__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 4px 10px rgba(10, 34, 88, 0.06), 0 22px 48px rgba(10, 34, 88, 0.12);
  }

  .cv__chip {
    position: relative;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    margin: 0 auto 22px;
    border-radius: 50%;
    background: var(--cv-brand-soft);
    color: var(--cv-brand);
    transition:
      background-color 380ms var(--cv-ease),
      color 380ms var(--cv-ease),
      transform 600ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .cv__chip svg {
    width: 24px;
    height: 24px;
  }

  .cv__card:hover .cv__chip {
    background: var(--cv-brand);
    color: #fff;
    transform: scale(1.06);
  }

  /* the single ring that pings outward as the chip lands */
  .cv__ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--cv-brand);
    opacity: 0;
    pointer-events: none;
  }

  .cv__card h3 {
    margin: 0 0 12px;
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--cv-ink);
  }

  .cv__card p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.62;
    color: var(--cv-body);
  }

  /* ------------------------------------------------------- entrance state */

  :global(html.cv-ready) .cv__eyebrow,
  :global(html.cv-ready) .cv__title {
    opacity: 0;
    transform: translate3d(0, 16px, 0);
  }

  :global(html.cv-ready) .cv__card {
    opacity: 0;
    transform: translate3d(0, 26px, 0) scale(0.975);
  }

  :global(html.cv-ready) .cv__card .cv__chip {
    transform: scale(0.55);
    opacity: 0;
  }

  .cv.is-in .cv__eyebrow,
  .cv.is-in .cv__title {
    opacity: 1;
    transform: none;
    transition:
      opacity 620ms var(--cv-ease),
      transform 620ms var(--cv-ease);
  }

  .cv.is-in .cv__title {
    transition-delay: 90ms;
  }

  .cv.is-in .cv__card {
    opacity: 1;
    transform: none;
    transition:
      opacity var(--cv-dur) var(--cv-ease) calc(220ms + var(--i) * var(--cv-step)),
      transform var(--cv-dur) var(--cv-ease) calc(220ms + var(--i) * var(--cv-step)),
      box-shadow 420ms var(--cv-ease);
  }

  .cv.is-in .cv__card .cv__chip {
    opacity: 1;
    transform: none;
    transition:
      opacity 420ms var(--cv-ease) calc(340ms + var(--i) * var(--cv-step)),
      transform 700ms cubic-bezier(0.34, 1.56, 0.64, 1) calc(340ms + var(--i) * var(--cv-step)),
      background-color 380ms var(--cv-ease),
      color 380ms var(--cv-ease);
  }

  .cv.is-in .cv__ring {
    animation: cvRing 900ms var(--cv-ease) forwards;
    animation-delay: calc(430ms + var(--i) * var(--cv-step));
  }

  @keyframes cvRing {
    0% {
      opacity: 0.45;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1.85);
    }
  }

  /* ------------------------------------------------------------ responsive */

  @media (max-width: 1024px) {
    .cv__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .cv {
      padding-block: 64px;
    }
    .cv__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  let io: IntersectionObserver | null = null;

  function seed() {
    const sections = document.querySelectorAll('.cv');
    if (!sections.length) return;

    document.documentElement.classList.add('cv-ready');
    io?.disconnect();
    for (const s of sections) s.classList.remove('is-in');

    io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-in');
          io?.unobserve(e.target);
        }
      },
      { threshold: 0.15 },
    );

    for (const s of sections) io.observe(s);
  }

  document.addEventListener('astro:page-load', seed);
</script>
