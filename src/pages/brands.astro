---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import bannerBrands from '../assets/site/banner-brands.jpg';
import imgPremium from '../assets/products/fish-steaks.jpg';
import imgRetail from '../assets/site/division-retail.jpg';
import { brands } from '../data/site';

// Card imagery per brand: OceanCrest (premium export) / BlueHarvest (retail)
const brandImages = [imgPremium, imgRetail];

// schema.org Brand entities so search engines tie the labels to the company.
const site = Astro.site ?? new URL('https://www.globalseastrust.com');
const brandsUrl = new URL('/brands/', site).href;
const brandSchema = brands.map((b) => ({
  '@type': 'Brand',
  name: b.name,
  slogan: b.positioning,
  description: b.text,
  url: brandsUrl,
}));
---

<BaseLayout
  title="Our Brands"
  description="OceanCrest premium export range and BlueHarvest everyday frozen seafood — Global Seas Trust house brands plus private-label packing for retail and food service."
  schema={brandSchema}
>
  <PageHero heading="Our Brands" image={bannerBrands}>
    <p>
      Two house labels, one standard of quality — built for different
      markets, backed by the same cold chain.
    </p>
  </PageHero>

  <section class="section">
    <div class="container brand-stack" data-rv data-rv-stagger="120">
      {
        brands.map((b, i) => (
          <article class="brand-card" class:list={{ reverse: i % 2 === 1 }}>
            <div class="brand-visual" style={`--brand-color: ${b.color}`}>
              <Image src={brandImages[i]} alt="" class="brand-bg" width={900} loading="lazy" />
              <span class="brand-overlay" aria-hidden="true"></span>
              <span class="brand-ring">
                <Icon name="wave" size={54} />
              </span>
              <strong>{b.name}</strong>
            </div>
            <div class="brand-copy">
              <span class="brand-tag">{b.positioning}</span>
              <h2>{b.name}</h2>
              <p>{b.text}</p>
              <a href="/contact/" class="btn btn--primary">
                Enquire About {b.name}
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--tint">
    <div class="container private-label">
      <div class="section-head" data-rv>
        <span class="eyebrow">Private Label</span>
        <h2>Your Brand, Our Cold Chain</h2>
        <p>
          Beyond our house labels, we produce private-label lines for
          supermarket chains and distributors — your artwork, your
          specification, our certified production.
        </p>
      </div>
      <div class="center-cta">
        <a href="/contact/" class="btn btn--primary">Discuss Private Label</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .brand-stack {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .brand-card {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 2.5rem;
    align-items: center;
  }

  .brand-card.reverse {
    direction: rtl;
  }

  .brand-card.reverse > * {
    direction: ltr;
  }

  .brand-visual {
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    gap: 0.8rem;
    padding: 3.2rem 1rem;
    border-radius: var(--radius);
    background: var(--navy-900);
    color: var(--white);
    box-shadow: var(--shadow-md);
  }

  .brand-visual :global(.brand-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .brand-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, var(--brand-color), var(--navy-900));
    opacity: 0.78;
  }

  .brand-ring,
  .brand-visual strong {
    position: relative;
  }

  .brand-ring {
    display: grid;
    place-items: center;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.1);
  }

  .brand-visual strong {
    font-size: 1.5rem;
    letter-spacing: 0.06em;
  }

  .brand-tag {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue-500);
    margin-bottom: 0.5rem;
  }

  .brand-copy h2 {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    color: var(--navy-900);
    margin-bottom: 0.8rem;
  }

  .brand-copy p {
    color: var(--text-600);
    margin-bottom: 1.4rem;
  }

  .center-cta {
    text-align: center;
  }

  .private-label .section-head {
    margin-bottom: 1.8rem;
  }

  @media (max-width: 760px) {
    .brand-card,
    .brand-card.reverse {
      grid-template-columns: 1fr;
      direction: ltr;
    }
  }
</style>
