---
import CategoryPage from '../../../components/pages/CategoryPage.astro';
import { getCategories, type Category } from '../../../data/catalogue';

export function getStaticPaths() {
  return getCategories('en').map((c) => ({ params: { category: c.id }, props: { category: c } }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
---

<CategoryPage lang="en" category={category} />
