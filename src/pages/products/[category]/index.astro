---
/**
 * /products/<category>/ — one landing page per catalogue category, generated
 * from src/data/catalogue.ts. Gives each product family its own URL, title,
 * description and ItemList schema so it can rank on its own.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductCard from '../../../components/ProductCard.astro';
import bannerProducts from '../../../assets/site/banner-products.jpg';
import { categories, allProducts, categoryUrl, type Category } from '../../../data/catalogue';
import { company } from '../../../data/site';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.id }, props: { category: c } }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const items = allProducts.filter((p) => p.category.id === category.id);
const others = categories.filter((c) => c.id !== category.id);
const heroImage = category.items[0]?.image ?? bannerProducts;
const site = Astro.site ?? new URL('https://www.globalseastrust.com');

// Search-facing copy per category (the visible blurb stays the catalogue one).
const seo: Record<string, { title: string; h2: string; intro: string }> = {
  fish: {
    title: 'Frozen Fish Supplier & Exporter in Oman',
    h2: 'Whole, Gutted and Processed Fish for Export',
    intro:
      'Tuna, kingfish, mackerel, sardine, snapper, grouper and more — landed on the Arabian Sea coast, size-graded, and frozen whole, gutted or as fillets and steaks for wholesale, retail and food-service buyers.',
  },
  crustaceans: {
    title: 'Frozen Shrimp, Lobster & Crab Exporter in Oman',
    h2: 'Shrimp, Lobster and Crab in Export Grades',
    intro:
      'Farmed vannamei and wild-caught tiger and white shrimp in HOSO, HLSO and peeled forms, plus spiny lobster and blue swimming and mud crab — packed IQF or block frozen to your market’s count and grade.',
  },
  cephalopods: {
    title: 'Frozen Cuttlefish, Squid & Octopus Exporter in Oman',
    h2: 'Cleaned Cuttlefish, Squid and Octopus',
    intro:
      'Pharaoh cuttlefish, Indian and reef squid and octopus from the Arabian Sea and Indian Ocean, cleaned and prepared as whole, fillets, rings and tubes for retail and food-service lines.',
  },
  'value-added': {
    title: 'Value-Added & Retail-Ready Seafood from Oman',
    h2: 'Portioned and Private-Label Seafood Lines',
    intro:
      'Uniform fish steaks and ready-to-cook seafood medleys processed and packed in-house — IQF, vacuum or retail packs with private-label printing for supermarket chains and food service.',
  },
  dried: {
    title: 'Dried & Salted Seafood Exporter in Oman',
    h2: 'Sun-Dried and Salt-Cured Seafood',
    intro:
      'Traditional dried anchovy, sardine and shrimp and salted ribbon fish, prepared and graded for long shelf life and shipped in bulk to markets across Asia and Africa.',
  },
};
const copy = seo[category.id] ?? { title: `${category.label} Products`, h2: category.label, intro: category.blurb };

const crumbs = [
  { name: 'Our Products', href: '/products/' },
  { name: category.label, href: categoryUrl(category.id) },
];

const listSchema = {
  '@type': 'ItemList',
  name: `${category.label} — ${company.name}`,
  numberOfItems: items.length,
  itemListElement: items.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(p.url, site).href,
    name: p.name,
  })),
};
---

<BaseLayout
  title={copy.title}
  description={`${category.blurb} ${items.length} products from ${company.name}, Oman.`}
  pageType="CollectionPage"
  breadcrumbs={crumbs}
  schema={listSchema}
>
  <PageHero heading={category.label} image={heroImage} alt={`${category.label} — ${company.name}`}>
    <p>{category.blurb}</p>
  </PageHero>

  <Breadcrumbs items={crumbs} />

  <section class="section">
    <div class="container">
      <div class="section-head" data-rv>
        <span class="eyebrow">{items.length} {items.length === 1 ? 'product' : 'products'}</span>
        <h2>{copy.h2}</h2>
        <p>{copy.intro}</p>
      </div>
      <div class="cat-grid" data-rv data-rv-stagger="80">
        {items.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section-head" data-rv>
        <span class="eyebrow">More Categories</span>
        <h2>Explore the Rest of the Catalogue</h2>
      </div>
      <ul class="cat-links" data-rv>
        {
          others.map((c) => (
            <li>
              <a href={categoryUrl(c.id)} class="btn btn--outline">
                {c.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/products/" class="btn btn--outline">Full Catalogue</a>
        </li>
      </ul>
      <div class="center-cta">
        <a href="/contact/" class="btn btn--primary">Request a Quote</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .cat-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    list-style: none;
  }

  .btn--outline {
    background: transparent;
    color: var(--blue-600);
    border: 2px solid var(--blue-400);
  }

  .btn--outline:hover {
    background: var(--aqua-100);
  }

  .center-cta {
    text-align: center;
    margin-top: 2.5rem;
  }

  @media (max-width: 980px) {
    .cat-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .cat-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
