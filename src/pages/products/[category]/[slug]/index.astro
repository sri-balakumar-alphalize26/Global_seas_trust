---
/**
 * /products/<category>/<slug>/ — one page per catalogue product, generated
 * from src/data/catalogue.ts. Own title/description, a share image cropped
 * from the product photo, and a schema.org Product node.
 */
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import ProductCard from '../../../../components/ProductCard.astro';
import { allProducts, categoryUrl, type CatalogueEntry } from '../../../../data/catalogue';
import { company, certifications, packingOptions } from '../../../../data/site';

export function getStaticPaths() {
  return allProducts.map((p) => ({
    params: { category: p.category.id, slug: p.slug },
    props: { product: p },
  }));
}

interface Props {
  product: CatalogueEntry;
}

const { product } = Astro.props;
const { category } = product;
const related = allProducts.filter((p) => p.category.id === category.id && p.slug !== product.slug).slice(0, 4);
const site = Astro.site ?? new URL('https://www.globalseastrust.com');
const canonical = new URL(product.url, site).href;

// Share / structured-data image: the product photo as JPEG at its natural
// proportions (capped at 1200px wide — the sources are never upscaled).
const share = product.image
  ? await getImage({ src: product.image, width: Math.min(1200, product.image.width), format: 'jpg' })
  : undefined;
const shareW = share ? Number(share.attributes.width) : undefined;
const shareH = share ? Number(share.attributes.height) : undefined;

const forms = product.forms.split(/\s*\/\s*/);
const title = `${product.name} Exporter in Oman — ${product.forms}`;

const crumbs = [
  { name: 'Our Products', href: '/products/' },
  { name: category.label, href: categoryUrl(category.id) },
  { name: product.name, href: product.url },
];

const productSchema = {
  '@type': 'Product',
  '@id': `${canonical}#product`,
  name: product.name,
  ...(product.scientific ? { alternateName: product.scientific } : {}),
  description: product.description,
  ...(share ? { image: new URL(share.src, site).href } : {}),
  category: category.label,
  url: canonical,
  brand: { '@type': 'Brand', name: company.name },
  manufacturer: { '@id': `${site.href}#organization` },
  countryOfOrigin: { '@type': 'Country', name: 'Oman' },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Product forms', value: product.forms },
    { '@type': 'PropertyValue', name: 'Packing', value: packingOptions.map((k) => k.title).join(', ') },
    { '@type': 'PropertyValue', name: 'Certifications', value: certifications.map((c) => c.code).join(', ') },
  ],
};
---

<BaseLayout
  title={title}
  description={product.description}
  pageType="ItemPage"
  breadcrumbs={crumbs}
  image={share?.src}
  imageWidth={shareW}
  imageHeight={shareH}
  schema={productSchema}
>
  <Breadcrumbs items={crumbs} />

  <!-- ============ PRODUCT HERO ============ -->
  <section class="section prod-hero">
    <div class="container prod-hero__grid">
      <div class="prod-hero__media" data-rv data-rv-in="fade">
        {
          product.image && (
            <Image
              src={product.image}
              alt={`${product.name} — ${product.forms}`}
              width={960}
              loading="eager"
              fetchpriority="high"
              class="prod-hero__img"
            />
          )
        }
      </div>
      <div class="prod-hero__body" data-rv>
        <a class="prod-eyebrow" href={categoryUrl(category.id)}>{category.label}</a>
        <h1>{product.name}</h1>
        {product.scientific && <p class="prod-latin">{product.scientific}</p>}
        <p class="prod-desc">{product.description}</p>
        <ul class="prod-forms" aria-label="Product forms">
          {forms.map((f) => <li>{f}</li>)}
        </ul>
        <div class="prod-actions">
          <a href="/contact/" class="btn btn--primary">Request a Quote</a>
          <a href="/products/" class="btn btn--outline">Full Catalogue</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SPECIFICATIONS ============ -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-head" data-rv>
        <span class="eyebrow">Specifications</span>
        <h2>{product.name} at a Glance</h2>
      </div>
      <dl class="spec" data-rv>
        {
          product.scientific && (
            <div class="spec__row">
              <dt>Scientific name</dt>
              <dd><em>{product.scientific}</em></dd>
            </div>
          )
        }
        <div class="spec__row">
          <dt>Category</dt>
          <dd><a href={categoryUrl(category.id)}>{category.label}</a></dd>
        </div>
        <div class="spec__row">
          <dt>Product forms</dt>
          <dd>{product.forms}</dd>
        </div>
        <div class="spec__row">
          <dt>Packing options</dt>
          <dd>{packingOptions.map((k) => k.title).join(' · ')}</dd>
        </div>
        <div class="spec__row">
          <dt>Cold chain</dt>
          <dd>IQF / blast frozen at −40 °C, shipped in temperature-controlled reefer containers</dd>
        </div>
        <div class="spec__row">
          <dt>Certifications</dt>
          <dd>{certifications.map((c) => c.code).join(' · ')}</dd>
        </div>
        <div class="spec__row">
          <dt>Origin</dt>
          <dd>Sultanate of Oman — {company.name}</dd>
        </div>
      </dl>
      <div class="center-cta">
        <a href="/contact/" class="btn btn--primary">Request Product Specifications</a>
      </div>
    </div>
  </section>

  <!-- ============ RELATED ============ -->
  {
    related.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head" data-rv>
            <span class="eyebrow">Related</span>
            <h2>More {category.label}</h2>
          </div>
          <div class="rel-grid" data-rv data-rv-stagger="80">
            {related.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
          <div class="center-cta">
            <a href={categoryUrl(category.id)} class="btn btn--primary">
              All {category.label}
            </a>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .prod-hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .prod-hero__media {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: linear-gradient(150deg, var(--aqua-100), #d9e6fb);
    aspect-ratio: 4 / 3;
  }

  .prod-hero__media :global(.prod-hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .prod-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue-500);
    margin-bottom: 0.6rem;
  }

  .prod-eyebrow:hover {
    text-decoration: underline;
  }

  .prod-hero__body h1 {
    font-size: clamp(1.9rem, 3.6vw, 2.6rem);
    line-height: 1.2;
    color: var(--navy-900);
  }

  .prod-latin {
    font-style: italic;
    color: var(--text-400);
    margin: 0.3rem 0 1.1rem;
  }

  .prod-desc {
    color: var(--text-600);
    margin-bottom: 1.3rem;
  }

  .prod-forms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin-bottom: 1.6rem;
  }

  .prod-forms li {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--blue-600);
    background: var(--aqua-100);
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
  }

  .prod-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .btn--outline {
    background: transparent;
    color: var(--blue-600);
    border: 2px solid var(--blue-400);
  }

  .btn--outline:hover {
    background: var(--aqua-100);
  }

  .spec {
    max-width: 820px;
    margin: 0 auto;
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .spec__row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1rem;
    padding: 0.9rem 1.4rem;
    border-bottom: 1px solid var(--aqua-100);
  }

  .spec__row:last-child {
    border-bottom: 0;
  }

  .spec dt {
    font-weight: 700;
    color: var(--navy-900);
  }

  .spec dd {
    color: var(--text-600);
  }

  .spec dd a {
    color: var(--blue-600);
    font-weight: 600;
  }

  .rel-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .center-cta {
    text-align: center;
    margin-top: 2.5rem;
  }

  @media (max-width: 980px) {
    .prod-hero__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .rel-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .spec__row {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .rel-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
