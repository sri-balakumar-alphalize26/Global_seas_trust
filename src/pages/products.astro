---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ProductCatalogue from '../components/ProductCatalogue.astro';
import Icon from '../components/Icon.astro';
import bannerProducts from '../assets/site/banner-products.jpg';
import { company, certifications, packingOptions as packing } from '../data/site';
import { categories, productUrl } from '../data/catalogue';

// Map the photo-first catalogue into the animated-filter component's shape.
// Images are pre-optimized here so the plain <img> cards still ship WebP.
const pcCategories = categories.map((c) => ({ id: c.id, label: c.label, note: c.blurb }));

const pcItems = await Promise.all(
  categories.flatMap((c) =>
    c.items.map(async (it) => {
      const img = it.image ? await getImage({ src: it.image, width: 640, format: 'webp' }) : undefined;
      return {
        name: it.name,
        latin: it.scientific,
        format: it.forms,
        cat: c.id,
        catLabel: c.label,
        url: productUrl(c.id, it.slug),
        image: img?.src,
        // intrinsic size → the card reserves its box before the image loads (no CLS)
        width: img?.attributes.width as number | undefined,
        height: img?.attributes.height as number | undefined,
      };
    })
  )
);

// schema.org ItemList of the catalogue — lets Google read the range as products.
const site = Astro.site ?? new URL('https://www.globalseastrust.com');
const productsUrl = new URL('/products/', site).href;
const productSchema = {
  '@type': 'ItemList',
  name: `${company.name} seafood catalogue`,
  numberOfItems: pcItems.length,
  itemListElement: pcItems.map((it, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: it.name,
      ...(it.latin ? { alternateName: it.latin } : {}),
      description: `${it.name}${it.latin ? ` (${it.latin})` : ''} — ${it.format}. Export-grade seafood from ${company.name}, Oman.`,
      category: it.catLabel,
      url: new URL(it.url, site).href,
      ...(it.image ? { image: new URL(it.image, site).href } : {}),
      brand: { '@type': 'Brand', name: company.name },
    },
  })),
};
---

<BaseLayout
  title="Our Products"
  description="Wholesale fish, shrimp, lobster, crab, cuttlefish, squid and dried seafood for export — IQF, block-frozen and retail packs from Global Seas Trust, Oman."
  pageType="CollectionPage"
  schema={productSchema}
>
  <PageHero heading="Our Products" image={bannerProducts}>
    <p>
      Premium species from the Arabian Sea and Indian Ocean — graded,
      processed and packed to your specification.
    </p>
  </PageHero>

  <!-- ============ ANIMATED CATALOGUE FILTER ============ -->
  <ProductCatalogue categories={pcCategories} items={pcItems} />

  <!-- ============ PACKING OPTIONS ============ -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-head" data-rv>
        <span class="eyebrow">Packing Options</span>
        <h2>Packed the Way Your Market Needs</h2>
      </div>
      <div class="packing-grid" data-rv data-rv-stagger="90">
        {
          packing.map((k) => (
            <article class="card packing-card">
              <span class="packing-icon">
                <Icon name="box" size={26} />
              </span>
              <h3>{k.title}</h3>
              <p>{k.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ CERTIFICATIONS ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-rv>
        <span class="eyebrow">Assurance</span>
        <h2>Every Shipment, Fully Certified</h2>
      </div>
      <ul class="cert-list" data-rv data-rv-stagger="70">
        {
          certifications.map((c) => (
            <li>
              <Icon name="shield" size={20} />
              <div>
                <strong>{c.code}</strong>
                <span>{c.label}</span>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="center-cta">
        <a href="/contact/" class="btn btn--primary">Request Product Specifications</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Packing ---- */
  .packing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .packing-card {
    padding: 1.7rem 1.4rem;
  }

  .packing-icon {
    display: inline-grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background: linear-gradient(150deg, var(--blue-500), var(--navy-800));
    color: var(--white);
    margin-bottom: 0.9rem;
  }

  .packing-card h3 {
    font-size: 0.98rem;
    color: var(--navy-900);
    margin-bottom: 0.45rem;
  }

  .packing-card p {
    font-size: 0.87rem;
    color: var(--text-600);
  }

  /* ---- Certifications ---- */
  .cert-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .cert-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 1rem 1.2rem;
    border: 1.5px solid var(--aqua-100);
    border-radius: var(--radius);
  }

  .cert-list :global(svg) {
    color: var(--blue-500);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .cert-list strong {
    display: block;
    color: var(--navy-900);
    font-size: 0.95rem;
  }

  .cert-list span {
    font-size: 0.8rem;
    color: var(--text-400);
  }

  .center-cta {
    text-align: center;
    margin-top: 2.5rem;
  }

  /* ---- Responsive ---- */
  @media (max-width: 980px) {
    .packing-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cert-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .packing-grid,
    .cert-list {
      grid-template-columns: 1fr;
    }
  }
</style>
