---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import bannerProducts from '../assets/site/banner-products.jpg';
import { certifications } from '../data/site';
import { categories } from '../data/catalogue';

const packing = [
  { title: 'IQF (Individually Quick Frozen)', text: 'Individually frozen pieces for easy portioning — ideal for retail bags and food service.' },
  { title: 'Block Frozen', text: 'Compact frozen blocks for industrial buyers and reprocessors, packed to weight specification.' },
  { title: 'Vacuum / Retail Packs', text: 'Skin-pack and vacuum options with private-label printing for supermarket shelves.' },
  { title: 'Bulk / Bin Loading', text: 'High-volume loading for fish meal, bait and industrial-grade consignments.' },
];
---

<BaseLayout title="Our Products" description="Explore our full catalogue — fish, crustaceans, cephalopods, value-added and dried seafood for export.">
  <PageHero heading="Our Products" image={bannerProducts}>
    <p>
      Premium species from the Arabian Sea and Indian Ocean — graded,
      processed and packed to your specification.
    </p>
  </PageHero>

  <!-- ============ CATALOGUE (tabbed categories) ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-rv>
        <span class="eyebrow">Catalogue</span>
        <h2>Browse by Category</h2>
        <p>
          All species are available year-round subject to season and quota.
          Custom grading, glazing and packing available on request.
        </p>
      </div>

      <div class="tab-bar" role="tablist" aria-label="Product categories">
        {
          categories.map((cat, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${cat.id}`}
              class:list={['tab-btn', { 'is-active': i === 0 }]}
              data-tab={cat.id}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-${cat.id}`}
            >
              {cat.label}
            </button>
          ))
        }
      </div>

      {
        categories.map((cat, i) => (
          <div
            class:list={['tab-panel', { 'is-active': i === 0 }]}
            id={`panel-${cat.id}`}
            role="tabpanel"
            aria-labelledby={`tab-${cat.id}`}
            hidden={i !== 0}
          >
            <p class="cat-blurb">{cat.blurb}</p>
            <div class="product-grid" data-rv data-rv-stagger="70">
              {cat.items.map((p) => (
                <article class="card product-card">
                  <div class="product-visual">
                    {p.image ? (
                      <Image src={p.image} alt={p.name} class="product-img" width={640} loading="lazy" />
                    ) : (
                      <span class="product-icon">
                        <Icon name={p.icon} size={46} />
                      </span>
                    )}
                  </div>
                  <div class="product-body">
                    <h3>{p.name}</h3>
                    {p.scientific && <p class="scientific">{p.scientific}</p>}
                    <span class="forms-chip">{p.forms}</span>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ============ PACKING OPTIONS ============ -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-head" data-rv>
        <span class="eyebrow">Packing Options</span>
        <h2>Packed the Way Your Market Needs</h2>
      </div>
      <div class="packing-grid" data-rv data-rv-stagger="90">
        {
          packing.map((k) => (
            <article class="card packing-card">
              <span class="packing-icon">
                <Icon name="box" size={26} />
              </span>
              <h3>{k.title}</h3>
              <p>{k.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ CERTIFICATIONS ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-rv>
        <span class="eyebrow">Assurance</span>
        <h2>Every Shipment, Fully Certified</h2>
      </div>
      <ul class="cert-list" data-rv data-rv-stagger="70">
        {
          certifications.map((c) => (
            <li>
              <Icon name="shield" size={20} />
              <div>
                <strong>{c.code}</strong>
                <span>{c.label}</span>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="center-cta">
        <a href="/contact/" class="btn btn--primary">Request Product Specifications</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Re-wire on every astro:page-load — a hoisted module runs only once, and
  // after a ClientRouter navigation the swapped-in DOM has no listeners.
  function initTabs() {
    const tabButtons = [...document.querySelectorAll<HTMLButtonElement>('.tab-btn')];
    const panels = [...document.querySelectorAll<HTMLElement>('.tab-panel')];
    if (!tabButtons.length) return;

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.tab;
        tabButtons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-selected', String(active));
        });
        panels.forEach((p) => {
          const active = p.id === `panel-${id}`;
          p.classList.toggle('is-active', active);
          p.hidden = !active;
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initTabs);
</script>

<style>
  /* ---- Tabs ---- */
  .tab-bar {
    display: flex;
    gap: 0.5rem;
    justify-content: flex-start;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    margin-bottom: 1.6rem;
    -webkit-overflow-scrolling: touch;
  }

  .tab-btn {
    flex-shrink: 0;
    padding: 0.6rem 1.4rem;
    border-radius: 999px;
    border: 1.5px solid var(--aqua-100);
    background: var(--white);
    color: var(--text-600);
    font-family: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .tab-btn:hover {
    border-color: var(--blue-400);
    color: var(--blue-600);
  }

  .tab-btn.is-active {
    background: var(--blue-500);
    border-color: var(--blue-500);
    color: var(--white);
  }

  .tab-panel {
    display: none;
  }

  .tab-panel.is-active {
    display: block;
  }

  .cat-blurb {
    max-width: 640px;
    margin: 0 auto 1.8rem;
    text-align: center;
    color: var(--text-600);
    font-size: 0.95rem;
  }

  @media (min-width: 768px) {
    .tab-bar {
      justify-content: center;
      overflow: visible;
    }
  }

  /* ---- Product cards ---- */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .product-card {
    overflow: hidden;
  }

  .product-visual {
    position: relative;
    height: 170px;
    overflow: hidden;
    background: linear-gradient(150deg, var(--aqua-100), #d9e6fb);
  }

  .product-visual :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.65);
    color: var(--blue-600);
  }

  .product-body {
    padding: 1.1rem 1.2rem 1.3rem;
  }

  .product-body h3 {
    font-size: 1.05rem;
    color: var(--navy-900);
  }

  .scientific {
    font-style: italic;
    font-size: 0.82rem;
    color: var(--text-400);
    margin-bottom: 0.7rem;
  }

  .forms-chip {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--blue-600);
    background: var(--aqua-100);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
  }

  /* ---- Packing ---- */
  .packing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .packing-card {
    padding: 1.7rem 1.4rem;
  }

  .packing-icon {
    display: inline-grid;
    place-items: center;
    width: 50px;
    height: 50px;
    border-radius: 12px;
    background: linear-gradient(150deg, var(--blue-500), var(--navy-800));
    color: var(--white);
    margin-bottom: 0.9rem;
  }

  .packing-card h3 {
    font-size: 0.98rem;
    color: var(--navy-900);
    margin-bottom: 0.45rem;
  }

  .packing-card p {
    font-size: 0.87rem;
    color: var(--text-600);
  }

  /* ---- Certifications ---- */
  .cert-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .cert-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 1rem 1.2rem;
    border: 1.5px solid var(--aqua-100);
    border-radius: var(--radius);
  }

  .cert-list :global(svg) {
    color: var(--blue-500);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .cert-list strong {
    display: block;
    color: var(--navy-900);
    font-size: 0.95rem;
  }

  .cert-list span {
    font-size: 0.8rem;
    color: var(--text-400);
  }

  .center-cta {
    text-align: center;
    margin-top: 2.5rem;
  }

  /* ---- Responsive ---- */
  @media (max-width: 980px) {
    .product-grid,
    .packing-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cert-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .product-grid,
    .packing-grid,
    .cert-list {
      grid-template-columns: 1fr;
    }
  }
</style>
