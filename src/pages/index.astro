---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import StatsGlance from '../components/StatsGlance.astro';
import CertBadge from '../components/CertBadge.astro';
import WaveDivider from '../components/WaveDivider.astro';
import {
  company,
  stats,
  products,
  certifications,
  divisions,
  processSteps,
  siteImages,
} from '../data/site';
---

<BaseLayout title="Home">
  <!-- ============ HERO ============ -->
  <section class="hero">
    <Image src={siteImages.hero} alt="" class="hero-bg" loading="eager" width={1600} />
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="container hero-inner">
      <p class="hero-eyebrow">Premium Seafood Exporters</p>
      <h1>Excellence in Seafood,<br />Delivered Worldwide</h1>
      <p class="hero-sub">
        {company.name} sources, processes and ships premium ocean catch with
        uncompromising cold-chain integrity — trusted by importers in over 25
        markets across four continents.
      </p>
      <div class="hero-actions">
        <a href="/products/" class="btn btn--primary">Explore Our Products</a>
        <a href="/contact/" class="btn btn--ghost">Get in Touch</a>
      </div>
    </div>
    <div class="hero-wave" aria-hidden="true">
      <WaveDivider fill="#ffffff" height={90} speed={11} />
    </div>
  </section>

  <!-- ============ SOURCING FEATURE ============ -->
  <section class="section">
    <div class="container feature-grid">
      <div class="feature-art" data-rv="left">
        <Image
          src={siteImages.feature}
          alt="Fishing fleet docked at the harbor beside the seafood distribution facility"
          class="feature-photo"
          width={900}
        />
        <div class="feature-art-badge">
          <Icon name="shield" size={26} />
          <span>Quality First</span>
        </div>
      </div>
      <div class="feature-text" data-rv="right">
        <span class="eyebrow">Freshness You Can Trust</span>
        <h2>Harvested From Pristine Waters</h2>
        <p>
          Our catch comes from the nutrient-rich waters of the Arabian Sea and
          Indian Ocean, landed daily by an established network of trusted
          fishing fleets. Within hours of landing, every consignment enters our
          temperature-controlled chain — so the freshness of the ocean reaches
          your market intact.
        </p>
        <p>
          From sashimi-grade tuna to retail-ready frozen packs, we match every
          harvest to the exacting specifications of our partners worldwide.
        </p>
        <a href="/about/" class="btn btn--primary">About Our Company</a>
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <StatsGlance
    eyebrow={`${company.name} at a Glance`}
    stats={stats.map((s) => ({
      value: s.value,
      label: s.label,
      icon: (s.icon === 'people' ? 'team' : s.icon) as 'anchor' | 'team' | 'globe' | 'truck',
    }))}
  />

  <!-- ============ PRODUCTS ============ -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-head" data-rv>
        <span class="eyebrow">Our Products</span>
        <h2>Signature Catch From Our Waters</h2>
        <p>
          A consistent, traceable supply of the region's most sought-after
          species — available whole, processed or value-added to your
          specification.
        </p>
      </div>
      <div class="product-grid" data-rv data-rv-stagger="90">
        {
          products.map((p) => (
            <article class="card product-card">
              <div class="product-visual">
                <Image src={p.image} alt={p.name} class="product-img" width={640} loading="lazy" />
              </div>
              <div class="product-body">
                <h3>{p.name}</h3>
                <p class="scientific">{p.scientific}</p>
                <p class="forms">{p.forms}</p>
              </div>
            </article>
          ))
        }
      </div>
      <div class="center-cta">
        <a href="/products/" class="btn btn--primary">View Full Catalogue</a>
      </div>
    </div>
  </section>

  <!-- ============ CERTIFICATIONS ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-rv>
        <span class="eyebrow">Certified Quality</span>
        <h2>International Standards, Independently Verified</h2>
      </div>
      <div class="cert-grid" data-rv data-rv-stagger="90">
        {certifications.map((c) => <CertBadge code={c.code} label={c.label} />)}
      </div>
    </div>
  </section>

  <!-- ============ DIVISIONS ============ -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-head" data-rv>
        <span class="eyebrow">What We Do</span>
        <h2>Three Integrated Divisions</h2>
      </div>
      <div class="division-grid" data-rv data-rv-stagger="90">
        {
          divisions.map((d) => (
            <article class="card division-card">
              <div class="card-visual">
                <Image src={d.image} alt={d.title} class="card-img" width={720} loading="lazy" />
              </div>
              <div class="card-body">
                <h3>{d.title}</h3>
                <p>{d.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-rv>
        <span class="eyebrow">From Catch to Consumer</span>
        <h2>Our Journey of Quality</h2>
      </div>
      <ol class="process-grid" data-rv data-rv-stagger="90">
        {
          processSteps.map((s) => (
            <li class="card process-step">
              <div class="card-visual">
                <Image src={s.image} alt={s.title} class="card-img" width={720} loading="lazy" />
                <span class="process-num">{s.step}</span>
              </div>
              <div class="card-body">
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ CTA BAND ============ -->
  <section class="cta-band">
    <div class="container cta-inner" data-rv>
      <h2>Ready to Source Premium Seafood?</h2>
      <p>Tell us your specification — species, grade, packing and port — and our export team will respond within one business day.</p>
      <a href="/contact/" class="btn btn--primary">Request a Quote</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    background: var(--navy-900);
    color: var(--white);
    padding: 7rem 0 8rem;
    overflow: hidden;
  }

  .hero :global(.hero-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 20% 120%, rgba(26, 91, 215, 0.4), transparent 55%),
      linear-gradient(160deg, rgba(10, 34, 88, 0.8) 0%, rgba(15, 47, 122, 0.62) 55%, rgba(18, 58, 156, 0.45) 100%);
  }

  .hero-inner {
    position: relative;
    max-width: 780px;
    text-align: center;
  }

  .hero-eyebrow {
    display: inline-block;
    padding: 0.35rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--aqua-300);
    margin-bottom: 1.4rem;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 5.5vw, 3.6rem);
    line-height: 1.15;
    margin-bottom: 1.2rem;
  }

  .hero-sub {
    font-size: 1.08rem;
    color: var(--aqua-100);
    max-width: 620px;
    margin: 0 auto 2.2rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    height: 90px;
  }

  /* ---- Sourcing feature ---- */
  .feature-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3.5rem;
    align-items: center;
  }

  .feature-art {
    position: relative;
  }

  .feature-art :global(.feature-photo) {
    width: 100%;
    height: 380px;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }

  .feature-art-badge {
    position: absolute;
    bottom: 18px;
    right: 8%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--white);
    color: var(--navy-800);
    font-weight: 700;
    font-size: 0.9rem;
    padding: 0.65rem 1.1rem;
    border-radius: 999px;
    box-shadow: var(--shadow-md);
  }

  .feature-art-badge :global(svg) {
    color: var(--gold-500);
  }

  .feature-text .eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--blue-500);
    margin-bottom: 0.6rem;
  }

  .feature-text h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--navy-900);
    margin-bottom: 1rem;
  }

  .feature-text p {
    color: var(--text-600);
    margin-bottom: 1rem;
  }

  .feature-text .btn {
    margin-top: 0.6rem;
  }

  /* ---- Products ---- */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .product-card {
    overflow: hidden;
  }

  .product-visual {
    height: 150px;
    background: linear-gradient(150deg, var(--aqua-100), #d9e6fb);
  }

  .product-visual :global(.product-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-body {
    padding: 1.1rem 1.2rem 1.3rem;
  }

  .product-body h3 {
    font-size: 1.05rem;
    color: var(--navy-900);
  }

  .scientific {
    font-style: italic;
    font-size: 0.82rem;
    color: var(--text-400);
    margin-bottom: 0.5rem;
  }

  .forms {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--blue-600);
  }

  .center-cta {
    text-align: center;
    margin-top: 2.5rem;
  }

  /* ---- Certifications ---- */
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.25rem;
  }

  /* ---- Shared photo-card layout (divisions + process, per reference) ---- */
  .card-visual {
    position: relative;
    height: 175px;
    overflow: hidden;
  }

  .card-visual :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-body {
    padding: 1.15rem 1.35rem 1.4rem;
  }

  .card-body h3 {
    font-size: 1.02rem;
    color: var(--navy-900);
    margin-bottom: 0.45rem;
  }

  .card-body p {
    font-size: 0.9rem;
    color: var(--text-600);
  }

  /* ---- Divisions ---- */
  .division-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .division-card {
    overflow: hidden;
    background: var(--white);
  }

  /* ---- Process ---- */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    list-style: none;
  }

  .process-step {
    overflow: hidden;
    background: var(--white);
  }

  .process-num {
    position: absolute;
    bottom: 12px;
    left: 12px;
    display: inline-grid;
    place-items: center;
    min-width: 42px;
    height: 30px;
    padding: 0 0.5rem;
    border-radius: 999px;
    background: var(--blue-500);
    color: var(--white);
    font-weight: 700;
    font-size: 0.85rem;
    box-shadow: 0 2px 10px rgba(10, 34, 88, 0.35);
  }

  /* ---- CTA band ---- */
  .cta-band {
    background: linear-gradient(120deg, var(--blue-600), var(--navy-800));
    color: var(--white);
    padding: 3.5rem 0;
  }

  .cta-inner {
    text-align: center;
    max-width: 640px;
  }

  .cta-inner h2 {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    margin-bottom: 0.8rem;
  }

  .cta-inner p {
    color: var(--aqua-100);
    margin-bottom: 1.6rem;
  }

  /* ---- Responsive ---- */
  @media (max-width: 980px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cert-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .division-grid,
    .process-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 680px) {
    .feature-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .division-grid,
    .process-grid {
      grid-template-columns: 1fr;
    }

    .cert-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
