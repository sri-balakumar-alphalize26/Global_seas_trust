---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import bannerAbout from '../assets/site/banner-about.jpg';
import Icon from '../components/Icon.astro';
import { company, stats, divisions, siteImages } from '../data/site';

const values = [
  {
    icon: 'shield',
    title: 'Uncompromising Quality',
    text: 'Every consignment passes laboratory testing and multi-point inspection before it leaves our facility.',
  },
  {
    icon: 'wave',
    title: 'Responsible Sourcing',
    text: 'We work only with vetted fleets and landing centres that respect seasonal regulations and sustainable practice.',
  },
  {
    icon: 'people',
    title: 'Partnership Mindset',
    text: 'Long-term relationships over one-off deals — many of our first customers still ship with us today.',
  },
  {
    icon: 'globe',
    title: 'Global Reliability',
    text: 'Documented, on-time delivery to ports across Asia, Europe, Africa and the Americas.',
  },
];
---

<BaseLayout title="About Us" description={`Learn about ${company.name} — our history, mission and values.`}>
  <PageHero heading={`About ${company.name}`} image={bannerAbout}>
    <p>Over a decade of connecting the ocean's finest catch with markets around the world.</p>
  </PageHero>

  <section class="section">
    <div class="container story-grid">
      <div data-rv="left">
        <span class="eyebrow-inline">Our Story</span>
        <h2>Built on the Water's Edge, Grown Across Continents</h2>
        <p>
          Founded in {company.founded}, {company.name} began as a small
          fish-trading operation supplying regional markets. Today we operate
          integrated processing, freezing and export facilities, shipping
          premium seafood to more than 25 countries.
        </p>
        <p>
          Our growth has been anchored in one simple belief: quality is a chain,
          not a checkpoint. From the moment a catch is landed to the moment a
          container is sealed, every link — icing, grading, freezing, packing,
          documentation — is managed by our own trained teams.
        </p>
        <p>
          With {stats[1].value.replace('+', '')}-plus professionals across
          sourcing, production, quality assurance and logistics, we combine
          local fishing heritage with modern food-safety science.
        </p>
      </div>
      <aside class="mission-stack" data-rv="right">
        <Image
          src={siteImages.about}
          alt="Fresh catch displayed on a market stall"
          class="story-photo"
          width={900}
        />
        <div class="mission-card">
          <h3>Our Mission</h3>
          <p>
            To deliver the freshness of the ocean to every market we serve —
            safely, sustainably and consistently.
          </p>
        </div>
        <div class="mission-card mission-card--alt">
          <h3>Our Vision</h3>
          <p>
            To be the region's most trusted seafood partner, recognised for
            quality, traceability and integrity in every shipment.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section-head" data-rv>
        <span class="eyebrow">What Guides Us</span>
        <h2>Our Core Values</h2>
      </div>
      <div class="values-grid" data-rv data-rv-stagger="90">
        {
          values.map((v) => (
            <article class="card value-card">
              <span class="value-icon">
                <Icon name={v.icon} size={30} />
              </span>
              <h3>{v.title}</h3>
              <p>{v.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-rv>
        <span class="eyebrow">Our Operations</span>
        <h2>Integrated From Landing Site to Loading Port</h2>
      </div>
      <div class="ops-grid" data-rv data-rv-stagger="90">
        {
          divisions.map((d) => (
            <article class="card ops-card">
              <span class="ops-icon">
                <Icon name={d.icon} size={30} />
              </span>
              <div>
                <h3>{d.title}</h3>
                <p>{d.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow-inline {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--blue-500);
    margin-bottom: 0.6rem;
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .story-grid h2 {
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    color: var(--navy-900);
    margin-bottom: 1rem;
  }

  .story-grid p {
    color: var(--text-600);
    margin-bottom: 1rem;
  }

  .mission-stack {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .mission-stack :global(.story-photo) {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }

  .mission-card {
    background: linear-gradient(150deg, var(--navy-800), var(--navy-700));
    color: var(--white);
    padding: 1.8rem;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }

  .mission-card--alt {
    background: linear-gradient(150deg, var(--blue-500), var(--blue-600));
  }

  .mission-card h3 {
    margin-bottom: 0.5rem;
  }

  .mission-card p {
    color: var(--aqua-100);
    font-size: 0.95rem;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .value-card {
    padding: 1.8rem 1.4rem;
    text-align: center;
  }

  .value-icon {
    display: inline-grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: var(--aqua-100);
    color: var(--blue-600);
    margin-bottom: 1rem;
  }

  .value-card h3 {
    font-size: 1.02rem;
    color: var(--navy-900);
    margin-bottom: 0.5rem;
  }

  .value-card p {
    font-size: 0.88rem;
    color: var(--text-600);
  }

  .ops-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    max-width: 820px;
    margin: 0 auto;
  }

  .ops-card {
    display: flex;
    gap: 1.4rem;
    padding: 1.6rem 1.8rem;
    align-items: flex-start;
  }

  .ops-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: linear-gradient(150deg, var(--blue-500), var(--navy-800));
    color: var(--white);
  }

  .ops-card h3 {
    color: var(--navy-900);
    margin-bottom: 0.35rem;
  }

  .ops-card p {
    font-size: 0.92rem;
    color: var(--text-600);
  }

  @media (max-width: 900px) {
    .story-grid {
      grid-template-columns: 1fr;
    }

    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .values-grid {
      grid-template-columns: 1fr;
    }

    .ops-card {
      flex-direction: column;
    }
  }
</style>
