---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ObjectiveSection from '../components/ObjectiveSection.astro';
import CoreValues from '../components/CoreValues.astro';
import bannerAbout from '../assets/site/banner-about.jpg';
import Icon from '../components/Icon.astro';
import { company, divisions, siteImages } from '../data/site';

// Official company copy, verbatim — <mark> wraps the highlighted phrases.
const objectiveParagraphs = [
  'Our objective is to establish Global Seas Trust as a trusted and recognized global <mark>seafood processing and export company</mark>, supplying premium-quality seafood to international markets.',
  'We specialize in processing and supplying a wide range of seafood, including <mark>Sardine, Mackerel, Tuna, Aquaculture Shrimp</mark>, and other wild-caught fishes. By combining careful sourcing, professional processing, quality control, and reliable export operations, we strive to deliver products that consistently meet the expectations of our customers worldwide.',
  'We aim to continuously expand our international market presence, strengthen our processing and supply capabilities, develop new seafood products, and build lasting relationships with importers, distributors, wholesalers, retailers, and food-service businesses.',
];

const objectiveCards = [
  {
    title: 'Our Mission',
    body: [
      'At Global Seas Trust, our mission is to bring high-quality seafood from trusted sources to customers across the world. We are committed to delivering fresh and frozen seafood with uncompromising standards of quality, freshness, food safety, and reliability.',
      'Through responsible sourcing, modern processing, efficient cold-chain management, and dependable international logistics, we aim to create long-term partnerships with customers in global seafood markets.',
    ],
  },
  {
    title: 'Our Vision',
    body: ['To deliver quality Fresh and Frozen seafood to the entire world.'],
  },
];

// Core values live in CoreValues.astro (official copy, verbatim, as defaults).
---

<BaseLayout
  title="About Us"
  pageType="AboutPage"
  description={`${company.name} is an Oman-based seafood processor and exporter established in ${company.founded} — our mission, core values, facilities and the cold chain behind every shipment.`}
>
  <PageHero heading={`About ${company.name}`} image={bannerAbout}>
    <p>From the ocean to the world, we are committed to delivering seafood you can trust.</p>
  </PageHero>

  <ObjectiveSection
    eyebrow="About Us"
    title="Our Objective"
    paragraphs={objectiveParagraphs}
    image={siteImages.about.src}
    imageAlt="Fresh catch displayed on a market stall"
    cards={objectiveCards}
  />

  <CoreValues />

  <section class="section">
    <div class="container">
      <div class="section-head" data-rv>
        <span class="eyebrow">Our Operations</span>
        <h2>Integrated From Landing Site to Loading Port</h2>
      </div>
      <div class="ops-grid" data-rv data-rv-stagger="90">
        {
          divisions.map((d) => (
            <article class="card ops-card">
              <span class="ops-icon">
                <Icon name={d.icon} size={30} />
              </span>
              <div>
                <h3>{d.title}</h3>
                <p>{d.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ OUR GLOBAL AMBITION ============ -->
  <section class="section section--navy ambition">
    <div class="container ambition-inner" data-rv>
      <h2>Our Global Ambition</h2>
      <p>
        We are building Global Seas Trust with a clear ambition—to connect the
        world's seafood markets with quality products they can trust.
      </p>
      <p>
        From responsibly sourced seafood to carefully processed and frozen
        products, we work to ensure that quality is maintained at every stage
        of the journey.
      </p>
      <p class="ambition-signoff">Global Seas Trust — Quality Seafood. Trusted Worldwide.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .ops-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    max-width: 820px;
    margin: 0 auto;
  }

  .ops-card {
    display: flex;
    gap: 1.4rem;
    padding: 1.6rem 1.8rem;
    align-items: flex-start;
  }

  .ops-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: linear-gradient(150deg, var(--blue-500), var(--navy-800));
    color: var(--white);
  }

  .ops-card h3 {
    color: var(--navy-900);
    margin-bottom: 0.35rem;
  }

  .ops-card p {
    font-size: 0.92rem;
    color: var(--text-600);
  }

  @media (max-width: 560px) {
    .ops-card {
      flex-direction: column;
    }
  }

  /* ---- Global Ambition ---- */
  .ambition-inner {
    max-width: 720px;
    text-align: center;
  }

  .ambition h2 {
    color: var(--white);
    font-size: clamp(1.6rem, 3.2vw, 2.3rem);
    margin-bottom: 1.2rem;
  }

  .ambition p {
    color: var(--aqua-100);
    margin-bottom: 1rem;
  }

  .ambition-signoff {
    margin-top: 1.6rem;
    font-weight: 700;
    color: var(--white) !important;
    letter-spacing: 0.02em;
  }
</style>
