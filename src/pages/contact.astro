---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactCards from '../components/ContactCards.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import bannerContact from '../assets/site/banner-contact.jpg';
import { company } from '../data/site';

// Split for the two-line display in the tiles and the map panel.
const addressLines = ['P.O. Box 1234, Industrial Port Area,', 'Muscat, Sultanate of Oman'];
---

<BaseLayout
  title="Contact Us"
  pageType="ContactPage"
  description={`Contact ${company.name} in Muscat, Oman for seafood export quotes, product specifications, private-label packing and partnership enquiries.`}
>
  <PageHero heading="Contact Us" image={bannerContact}>
    <p>
      Tell us what you need — species, grade, packing and destination port —
      and our export team will get back to you within one business day.
    </p>
  </PageHero>

  <!-- Interactive contact tiles: maps, dialer, mail, live working hours -->
  <ContactCards
    addressLines={addressLines}
    phone={company.phone}
    email={company.email}
    emailSubject="Enquiry from Global Seas Trust website"
    hoursSummary={company.hours}
  />

  <!--
    Enquiry form + Find Us panel. No `action` yet, so the component's
    demo submit shows the confirmation line — point `action` at a real
    endpoint (Formspree/Basin/your API) to make it live, and pass
    `embedSrc` for a real Google Maps embed instead of the panel.
  -->
  <EnquiryForm addressLines={addressLines} />
</BaseLayout>
