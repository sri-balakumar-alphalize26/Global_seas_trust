---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactCards from '../components/ContactCards.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import bannerContact from '../assets/site/banner-contact.jpg';
import { company } from '../data/site';

// Contact details come from company in src/data/site.ts (single source).
const { addressLines, mapsUrl } = company;
---

<BaseLayout
  title="Contact Us"
  pageType="ContactPage"
  description={`Contact ${company.name} in ${company.locality}, Oman for seafood export quotes, product specifications, private-label packing and partnership enquiries.`}
>
  <PageHero heading="Contact Us" image={bannerContact}>
    <p>
      Tell us what you need — species, grade, packing and destination port —
      and our export team will get back to you within one business day.
    </p>
  </PageHero>

  <!-- Interactive contact tiles: maps, dialer, mail, live working hours -->
  <ContactCards
    addressLines={addressLines}
    mapsUrl={mapsUrl}
    crNumber={company.crNumber}
    phone={company.phone}
    email={company.email}
    emailSubject="Enquiry from Global Seas Trust website"
    hoursSummary={company.hours}
  />

  <!--
    Enquiry form + Find Us panel. No `action` yet, so the component's
    demo submit shows the confirmation line — point `action` at a real
    endpoint (Formspree/Basin/your API) to make it live, and pass
    `embedSrc` for a real Google Maps embed instead of the panel.
  -->
  <EnquiryForm
    addressLines={addressLines}
    mapsUrl={mapsUrl}
    crNumber={company.crNumber}
    embedSrc={company.mapEmbedSrc}
  />
</BaseLayout>
