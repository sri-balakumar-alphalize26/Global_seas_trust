---
// Static hosts (Netlify, Vercel, Cloudflare, Nginx with error_page) serve
// dist/404.html for unknown URLs. Kept out of the sitemap and marked noindex.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import bannerAbout from '../assets/site/banner-about.jpg';
import { navLinks } from '../data/site';
---

<BaseLayout title="Page Not Found" description="The page you were looking for does not exist or has moved." noindex>
  <PageHero heading="Page Not Found" image={bannerAbout}>
    <p>The page you're looking for has moved or never existed.</p>
  </PageHero>

  <section class="section">
    <div class="container nf-wrap" data-rv>
      <p class="nf-code" aria-hidden="true">404</p>
      <p class="nf-lede">Let's get you back on course.</p>
      <div class="nf-actions">
        <a href="/" class="btn btn--primary">Back to Home</a>
        <a href="/products/" class="btn btn--outline">Browse Products</a>
      </div>
      <nav class="nf-links" aria-label="Site pages">
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .nf-wrap {
    text-align: center;
    max-width: 640px;
  }

  .nf-code {
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--aqua-100);
    margin-bottom: 0.5rem;
  }

  .nf-lede {
    font-size: 1.15rem;
    color: var(--text-600);
    margin-bottom: 1.6rem;
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-bottom: 2rem;
  }

  /* outline variant for light backgrounds (global .btn--ghost is for navy) */
  .btn--outline {
    background: transparent;
    color: var(--blue-600);
    border: 2px solid var(--blue-400);
  }

  .btn--outline:hover {
    background: var(--aqua-100);
  }

  .nf-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.4rem;
    font-size: 0.9rem;
  }

  .nf-links a {
    color: var(--text-400);
  }

  .nf-links a:hover {
    color: var(--blue-600);
  }
</style>
