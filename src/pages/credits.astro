---
import BaseLayout from '../layouts/BaseLayout.astro';
import credits from '../data/image-credits.json';
---

<BaseLayout
  title="Image Credits"
  description="Attribution for the Creative Commons photographs used on this website."
>
  <section class="page-hero">
    <div class="container">
      <h1>Image Credits</h1>
      <p>
        The photographs on this website are used under Creative Commons and
        public-domain licenses. We thank the photographers below.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container credits-wrap">
      <ul class="credit-list">
        {
          credits.map((c) => (
            <li>
              <strong>{c.usedFor}</strong>
              <span>
                “{c.title}” by {c.creator || 'unknown'} — {c.license} —{' '}
                <a href={c.source} target="_blank" rel="noopener noreferrer">
                  original source
                </a>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .credits-wrap {
    max-width: 760px;
  }

  .credit-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .credit-list li {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem 1.2rem;
    border: 1.5px solid var(--aqua-100);
    border-radius: var(--radius);
  }

  .credit-list strong {
    color: var(--navy-900);
    font-size: 0.95rem;
  }

  .credit-list span {
    font-size: 0.88rem;
    color: var(--text-600);
  }

  .credit-list a {
    color: var(--blue-600);
    text-decoration: underline;
  }
</style>
